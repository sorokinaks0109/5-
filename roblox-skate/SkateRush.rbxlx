					ctx.onTrick(b.trick)
				end
			end)
		end
	end

	-- справа: стартовый набор и быстрый буст
	local side = new("Frame", { Size = UDim2.fromOffset(200, 190), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 12), BackgroundTransparency = 1, Parent = gui }, {
		new("UIListLayout", { Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	refs.starter = new("TextButton", { Size = UDim2.fromOffset(190, 120), BackgroundColor3 = C.pink, Text = "", AutoButtonColor = true, Visible = false, LayoutOrder = 1, Parent = side }, { corner(16), stroke(Color3.new(0, 0, 0), 3), gradient(Color3.fromRGB(255, 150, 220), Color3.fromRGB(200, 60, 255)) })
	if Config.Icons and Config.Icons.Starter ~= "" then
		new("ImageLabel", { Image = Config.Icons.Starter, BackgroundTransparency = 1, Size = UDim2.fromOffset(70, 70), Position = UDim2.fromOffset(0, 0), ScaleType = Enum.ScaleType.Fit, Parent = refs.starter })
	else
		label({ Text = "🎁", Size = UDim2.fromOffset(60, 60), Position = UDim2.fromOffset(6, 6), MaxText = 46, Parent = refs.starter })
	end
	textStroke(label({ Text = "СТАРТОВЫЙ\nНАБОР", Size = UDim2.new(1, -72, 0, 50), Position = UDim2.fromOffset(66, 8), MaxText = 20, Parent = refs.starter }), 1.5)
	refs.starterTimer = textStroke(label({ Text = "", Size = UDim2.new(0.5, -8, 0, 26), Position = UDim2.new(0, 8, 1, -34), TextColor3 = C.gold, MaxText = 20, Parent = refs.starter }), 1.5)
	textStroke(label({ Text = "Только " .. Config.Products.StarterPack.price .. " R$", Size = UDim2.new(0.5, -8, 0, 26), Position = UDim2.new(0.5, 0, 1, -34), TextColor3 = C.text, MaxText = 20, Parent = refs.starter }), 1.5)
	local starterScale = new("UIScale", { Parent = refs.starter })
	TweenService:Create(starterScale, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.05 }):Play()
	refs.starter.MouseButton1Click:Connect(function()
		ctx.buy("product", "StarterPack")
	end)
	local boostBtn = button({ Text = "⚡ x2 МОНЕТЫ  " .. Config.Products.Boost2x.price .. " R$", Size = UDim2.fromOffset(190, 52), Color = C.blue, LayoutOrder = 2, MaxText = 18, Parent = side }, function()
		ctx.buy("product", "Boost2x")
	end)
	boostBtn.Name = "BoostQuick"

	-- трюк-битва
	refs.event = new("Frame", { Size = UDim2.fromOffset(260, 170), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -228, 0, 12), BackgroundColor3 = C.panel, BackgroundTransparency = 0.15, Visible = false, Parent = gui }, { corner(14), stroke(C.purple, 3) })
	refs.eventTitle = textStroke(label({ Text = "🏆 ТРЮК-БИТВА", Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 6), TextColor3 = C.gold, MaxText = 22, Parent = refs.event }), 1)
	refs.eventList = label({ Text = "", Size = UDim2.new(1, -16, 1, -44), Position = UDim2.fromOffset(8, 38), Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, MaxText = 17, Parent = refs.event })

	-- окно меню
	refs.window = new("Frame", { Size = UDim2.fromOffset(600, 470), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), BackgroundColor3 = C.panel, Visible = false, ZIndex = 30, Parent = gui }, { corner(18), stroke(Color3.new(0, 0, 0), 3) })
	refs.windowHeader = new("Frame", { Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = C.orange, Parent = refs.window }, { corner(18), gradient(Color3.new(1, 1, 1), Color3.fromRGB(180, 180, 180)) })
	refs.windowTitle = textStroke(label({ Text = "", Size = UDim2.new(1, -90, 1, -12), Position = UDim2.fromOffset(16, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 32, Parent = refs.windowHeader }), 2)
	button({ Text = "X", Size = UDim2.fromOffset(46, 46), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Color = C.red, Parent = refs.windowHeader }, closeWindow)
	refs.windowList = new("ScrollingFrame", {
		Size = UDim2.new(1, -24, 1, -74),
		Position = UDim2.fromOffset(12, 66),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = refs.window,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingRight = UDim.new(0, 8) }),
	})
end

local function updateEvent()
	local active = ReplicatedStorage:GetAttribute("EventActive") == true
	refs.event.Visible = active
	if not active then
		return
	end
	local left = (ReplicatedStorage:GetAttribute("EventEnds") or 0) - workspace:GetServerTimeNow()
	refs.eventTitle.Text = "🏆 ТРЮК-БИТВА " .. timeText(left)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		table.insert(list, { name = p.DisplayName, score = p:GetAttribute("EventScore") or 0, me = p == player })
	end
	table.sort(list, function(a, b)
		return a.score > b.score
	end)
	local lines = {}
	local medals = { "🥇", "🥈", "🥉" }
	local myPlace
	for i, e in ipairs(list) do
		if e.me then
			myPlace = i
		end
		if i <= 3 then
			table.insert(lines, (medals[i] or "") .. " " .. e.name .. " — " .. fmt(e.score))
		end
	end
	if myPlace and myPlace > 3 then
		table.insert(lines, "…\n" .. myPlace .. ". Ты — " .. fmt(list[myPlace].score))
	end
	refs.eventList.Text = table.concat(lines, "\n")
end

function UI.init(context)
	ctx = context
	buildHud()
	if data then
		UI.setData(data)
	end

	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		-- монеты плавно «набегают»
		if data then
			local target = data.coins
			displayedCoins += (target - displayedCoins) * math.min(1, dt * 8)
			if math.abs(target - displayedCoins) < 1 then
				displayedCoins = target
			end
			refs.coins.Text = "💰 " .. fmt(displayedCoins)
		end
		acc += dt
		if acc >= 0.25 then
			acc = 0
			local left = boostEnds - os.clock()
			refs.boost.Text = left > 0 and ("⚡x2 " .. timeText(left)) or ""
			updateEvent()
			if refs.riderStatus then
				local st = player:GetAttribute("RiderStatus")
				refs.riderStatus.Text = st and ("анимация: " .. st) or "анимация: ждём доску…"
			end
			if data then
				local sl = (data.starterLeft or 0) - (os.clock() - (refs.dataTime or os.clock()))
				refs.starter.Visible = sl > 0
				refs.starterTimer.Text = "⏰ " .. timeText(sl)
				refs.giftDot.Visible = giftReadyCount() > 0
			end
		end
	end)
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Rider</string><ProtectedString name="Source"><![CDATA[-- ============================================================
--  Анимация скейтера кодом (без загрузки файлов анимаций).
--  Каждый кадр ставим суставы персонажа в нужную позу:
--  стойка боком, полуприсед, толчок ногой, наклон в поворотах,
--  отдельные позы для трюков и падения.
--  Работает для всех игроков на сервере, у кого есть доска.
--  Только для персонажей R15 (стандарт Roblox).
-- ============================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Rider = {}

local rad = math.rad
local A = CFrame.Angles

local JOINTS = {
	Root = "LowerTorso",
	Waist = "UpperTorso",
	Neck = "Head",
	LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg",
	LeftAnkle = "LeftFoot",
	RightHip = "RightUpperLeg",
	RightKnee = "RightLowerLeg",
	RightAnkle = "RightFoot",
	LeftShoulder = "LeftUpperArm",
	LeftElbow = "LeftLowerArm",
	LeftWrist = "LeftHand",
	RightShoulder = "RightUpperArm",
	RightElbow = "RightLowerArm",
	RightWrist = "RightHand",
}

-- Поза собирается из «присед», «разворот корпуса», рук и ног.
-- crouch — насколько присели (0..1), spread — ширина стойки,
-- armsUp/armsOut — руки, tuck — колени к груди.
local function buildPose(p)
	local crouch = p.crouch or 0.3
	local th = rad(10 + 45 * crouch) -- угол бедра
	local drop = 1.9 * (1 - math.cos(th)) -- опускаем таз ровно настолько, чтобы ступни остались на доске
	local spread = rad(p.spread or 14)
	local tuck = rad(p.tuck or 0)
	local yaw = rad(p.yaw or 80) -- стойка боком
	local lean = p.lean or 0
	local armsOut = rad(p.armsOut or 35)
	local armsFwd = rad(p.armsFwd or 0)
	local pose = {
		Root = CFrame.new(0, -drop, 0) * A(0, yaw, 0) * A(rad(p.bend or 8), 0, lean),
		Waist = A(rad(p.chest or 10), rad(p.twist or -35), 0),
		Neck = A(rad(p.look or -5), rad(p.head or -40), 0),
		LeftHip = A(th + tuck, 0, -spread),
		LeftKnee = A(-2 * th - tuck * 1.4, 0, 0),
		LeftAnkle = A(th * 0.9, 0, spread),
		RightHip = A(th + tuck, 0, spread),
		RightKnee = A(-2 * th - tuck * 1.4, 0, 0),
		RightAnkle = A(th * 0.9, 0, -spread),
		LeftShoulder = A(armsFwd, 0, -armsOut),
		LeftElbow = A(rad(p.elbow or 15), 0, 0),
		LeftWrist = CFrame.new(),
		RightShoulder = A(armsFwd, 0, armsOut),
		RightElbow = A(rad(p.elbow or 15), 0, 0),
		RightWrist = CFrame.new(),
	}
	if p.override then
		for k, v in pairs(p.override) do
			pose[k] = v
		end
	end
	return pose
end

local POSES = {
	ride = { crouch = 0.3 },
	air = { crouch = 0.55, armsOut = 60, tuck = 15 },
	grind = { crouch = 0.45, armsOut = 75, spread = 16 },
	Kickflip = { crouch = 0.6, tuck = 45, armsOut = 80, armsFwd = 20 },
	Spin = { crouch = 0.4, armsOut = 95, tuck = 10 },
	Grab = {
		crouch = 0.75,
		tuck = 50,
		armsOut = 30,
		override = { RightShoulder = A(rad(-30), 0, rad(15)), RightElbow = A(rad(5), 0, 0) },
	},
	Backflip = { crouch = 0.8, tuck = 70, armsFwd = 70, armsOut = 10, elbow = 70, chest = 25 },
	bail = { crouch = 0.1, armsOut = 140, spread = 30, chest = -25, look = -30, bend = -10 },
}

local built = {}
for name, p in pairs(POSES) do
	built[name] = buildPose(p)
end

-- ---------- позы для коротких анимаций ----------
-- стоит прямо, лицом вперёд (до того как встать на доску)
local STAND = buildPose({ crouch = 0, yaw = 0, spread = 5, armsOut = 8, twist = 0, head = 0, bend = 0, chest = 0, look = 0, elbow = 8 })
-- заносит ногу на доску
local STEP = buildPose({ crouch = 0.1, yaw = 30, spread = 6, armsOut = 30, twist = -10, head = -20, bend = 4 })
STEP.RightHip = A(rad(55), 0, rad(8))
STEP.RightKnee = A(rad(-70), 0, 0)
STEP.RightAnkle = A(rad(15), 0, 0)
-- олли: глубокий присед и толчок вверх
local OLLIE_DOWN = buildPose({ crouch = 0.85, armsOut = 25, armsFwd = 25, chest = 22 })
local OLLIE_UP = buildPose({ crouch = 0.25, tuck = 40, armsOut = 70, armsFwd = -10, chest = 0, look = -15 })
-- приземление: пружиним
local LAND = buildPose({ crouch = 0.9, armsOut = 45, chest = 25 })

local function lerpPose(a, b, t)
	local out = {}
	for joint, cf in pairs(a) do
		out[joint] = cf:Lerp(b[joint] or cf, t)
	end
	return out
end

local function smooth(t)
	return t * t * (3 - 2 * t)
end

local ONE_SHOT = { mount = 0.9, ollie = 0.38, land = 0.25 }

local function oneShotPose(name, p)
	if name == "mount" then
		if p < 0.3 then
			return STAND
		elseif p < 0.65 then
			return lerpPose(STAND, STEP, smooth((p - 0.3) / 0.35))
		end
		return lerpPose(STEP, built.ride, smooth((p - 0.65) / 0.35))
	elseif name == "ollie" then
		if p < 0.35 then
			return lerpPose(built.ride, OLLIE_DOWN, smooth(p / 0.35))
		elseif p < 0.7 then
			return lerpPose(OLLIE_DOWN, OLLIE_UP, smooth((p - 0.35) / 0.35))
		end
		return lerpPose(OLLIE_UP, built.air, smooth((p - 0.7) / 0.3))
	elseif name == "land" then
		if p < 0.4 then
			return lerpPose(built.ride, LAND, smooth(p / 0.4))
		end
		return lerpPose(LAND, built.ride, smooth((p - 0.4) / 0.6))
	end
	return built.ride
end

-- бег на беговой дорожке (без доски)
local function runPose(phase)
	local s = math.sin(phase)
	local pose = buildPose({ crouch = 0.05, yaw = 0, spread = 3, twist = 0, head = 0, bend = 6, chest = 6, look = 0 })
	pose.Root = CFrame.new(0, -0.05 + math.abs(math.cos(phase)) * 0.15, 0) * A(rad(6), 0, 0)
	pose.LeftHip = A(rad(40 * s), 0, 0)
	pose.RightHip = A(rad(-40 * s), 0, 0)
	pose.LeftKnee = A(rad(-10 - 45 * math.max(0, -s)), 0, 0)
	pose.RightKnee = A(rad(-10 - 45 * math.max(0, s)), 0, 0)
	pose.LeftAnkle = CFrame.new()
	pose.RightAnkle = CFrame.new()
	pose.LeftShoulder = A(rad(-45 * s), 0, rad(-8))
	pose.RightShoulder = A(rad(45 * s), 0, rad(8))
	pose.LeftElbow = A(rad(60), 0, 0)
	pose.RightElbow = A(rad(60), 0, 0)
	return pose
end

local localShot = nil -- { name, start, dur } для своего персонажа
function Rider.play(name)
	local dur = ONE_SHOT[name]
	if dur then
		localShot = { name = name, start = os.clock(), dur = dur }
	end
end

function Rider.busy()
	return localShot ~= nil and os.clock() - localShot.start < localShot.dur
end

-- Толчок ногой: задняя нога опускается к земле и уходит назад
local function pushPose(phase)
	local base = buildPose({ crouch = 0.4 })
	local s = math.sin(phase)
	local down = math.max(0, s)
	base.RightHip = A(rad(10 - 45 * s), 0, rad(14))
	base.RightKnee = A(rad(-20 - 25 * (1 - down)), 0, 0)
	base.RightAnkle = A(rad(20), 0, 0)
	base.LeftHip = A(rad(45), 0, rad(-12))
	base.LeftKnee = A(rad(-80), 0, 0)
	base.LeftAnkle = A(rad(35), 0, 0)
	base.LeftShoulder = A(rad(25 * s), 0, rad(-25))
	base.RightShoulder = A(rad(-25 * s), 0, rad(25))
	base.Waist = A(rad(18), rad(-60), 0)
	base.Root = CFrame.new(0, -0.55, 0) * A(0, rad(70), 0) * A(rad(12), 0, 0)
	return base
end

-- Суставы старых аватаров R6 (у них нет коленей и локтей)
local JOINTS_R6 = {
	Root = { "HumanoidRootPart", "RootJoint" },
	Neck = { "Torso", "Neck" },
	LeftHip = { "Torso", "Left Hip" },
	RightHip = { "Torso", "Right Hip" },
	LeftShoulder = { "Torso", "Left Shoulder" },
	RightShoulder = { "Torso", "Right Shoulder" },
}

-- ---------- состояние по персонажам ----------
local rigs = {} -- [character] = { motors = {}, current = {}, phase = 0 }

-- Имена суставов R6 → наши имена
local R6_NAMES = {
	RootJoint = "Root",
	Neck = "Neck",
	["Left Hip"] = "LeftHip",
	["Right Hip"] = "RightHip",
	["Left Shoulder"] = "LeftShoulder",
	["Right Shoulder"] = "RightShoulder",
}

local function setStatus(char, text)
	if Players:GetPlayerFromCharacter(char) == Players.LocalPlayer then
		Players.LocalPlayer:SetAttribute("RiderStatus", text)
	end
end

-- Ищет суставы любого типа: старые Motor6D и новые AnimationConstraint
-- (в новых версиях Roblox суставы аватара сделаны на AnimationConstraint)
local function findJoints(char, isR6)
	local joints = {}
	local count = 0
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Motor6D") or d:IsA("AnimationConstraint") then
			local key = isR6 and R6_NAMES[d.Name] or (JOINTS[d.Name] and d.Name)
			if key and not joints[key] then
				joints[key] = d
				count += 1
			end
		end
	end
	return joints, count
end

local function getRig(char)
	local r = rigs[char]
	if r then
		return r
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		setStatus(char, "нет Humanoid")
		return nil
	end
	local isR6 = hum.RigType == Enum.HumanoidRigType.R6
	local motors, count = findJoints(char, isR6)
	if count < 3 then
		setStatus(char, "суставы не найдены (" .. count .. ")")
		return nil
	end
	local orig, rot, rotInv, kind = {}, {}, {}, {}
	local kindName = "Motor6D"
	for joint, m in pairs(motors) do
		if m:IsA("Motor6D") then
			kind[joint] = "motor"
			orig[joint] = m.C0
			rot[joint] = m.C0.Rotation
			rotInv[joint] = m.C0.Rotation:Inverse()
		else
			kind[joint] = "constraint"
			kindName = "новые суставы"
		end
	end
	print("[SkateRush] Поза скейтера включена:", isR6 and "R6" or "R15", kindName, "суставов:", count)
	setStatus(char, "работает (" .. (isR6 and "R6" or "R15") .. ", " .. kindName .. ")")
	r = { motors = motors, kind = kind, current = {}, phase = 0, hum = hum, isR6 = isR6, orig = orig, rot = rot, rotInv = rotInv }
	rigs[char] = r
	char.AncestryChanged:Connect(function(_, parent)
		if not parent then
			rigs[char] = nil
		end
	end)
	return r
end

-- Для своего персонажа состояние даёт главный скрипт (без задержки сети)
local localState = "ride"
local localLean = 0
function Rider.setLocal(state, lean)
	localState = state
	localLean = lean or 0
end

local TRICKS = { Kickflip = true, Spin = true, Grab = true, Backflip = true, bail = true }

local function targetFor(char, r, isLocal, dt)
	local state = isLocal and localState or (char:GetAttribute("SkateAnim") or "ride")
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = r.hum
	if char:GetAttribute("OnTreadmill") then
		r.phase += dt * 11
		return runPose(r.phase)
	end
	-- короткие анимации: встать на доску, олли, приземление
	if not TRICKS[state] then
		local shot
		if isLocal then
			shot = localShot
		else
			if state ~= r.lastAttr then
				r.lastAttr = state
				r.attrStart = os.clock()
			end
			if ONE_SHOT[state] then
				shot = { name = state, start = r.attrStart, dur = ONE_SHOT[state] }
			end
		end
		if shot then
			local p = (os.clock() - shot.start) / shot.dur
			if p < 1 then
				return oneShotPose(shot.name, p)
			end
			if isLocal then
				localShot = nil
			end
		end
		if not isLocal and ONE_SHOT[state] then
			state = state == "ollie" and "air" or "ride"
		end
	end
	if state == "ride" and root then
		local v = root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		local moving = hum.MoveDirection.Magnitude > 0.1 or (not isLocal and speed > 4)
		local maxSpeed = hum.WalkSpeed > 0 and hum.WalkSpeed or 16
		-- толкаемся, пока не разогнались
		if moving and speed < maxSpeed * 0.92 and hum.FloorMaterial ~= Enum.Material.Air then
			r.phase += dt * 7
			r.pushing = true
			return pushPose(r.phase)
		end
		r.pushing = false
	end
	local pose = built[state] or built.ride
	local lean = isLocal and localLean or 0
	local t = os.clock()
	local copy = table.clone(pose)
	if state == "ride" or state == "grind" then
		-- лёгкое покачивание: колени пружинят, руки балансируют
		local bob = math.sin(t * 5) * 0.06
		copy.Root = pose.Root * CFrame.new(0, bob, 0)
		copy.LeftShoulder = pose.LeftShoulder * A(rad(math.sin(t * 2.2) * 8), 0, rad(math.sin(t * 1.7) * 6))
		copy.RightShoulder = pose.RightShoulder * A(rad(math.sin(t * 2.2 + 1) * 8), 0, rad(math.sin(t * 1.7 + 1) * 6))
		copy.Neck = pose.Neck * A(0, rad(math.sin(t * 0.8) * 6), 0)
	end
	if lean ~= 0 then
		copy.Root = copy.Root * A(0, 0, lean)
		copy.Waist = pose.Waist * A(0, 0, -lean * 0.5)
	end
	return copy
end

local noRigTime = 0
local fallbackOn = false

function Rider.step(dt)
	local me = Players.LocalPlayer
	local alpha = dt > 0 and (1 - math.exp(-dt * 14)) or 0
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char and not char:FindFirstChild("Skateboard") and player == me then
			setStatus(char, "нет доски")
		end
		if char and char:FindFirstChild("Skateboard") then
			local r = getRig(char)
			if not r and player == me then
				noRigTime += dt
				if noRigTime > 3 and not fallbackOn then
					fallbackOn = true
					local animate = char:FindFirstChild("Animate")
					if animate and animate:IsA("LocalScript") then
						animate.Enabled = true -- запасной вариант: обычная анимация Roblox
					end
					warn("[SkateRush] Не удалось включить позу скейтера, включена обычная анимация")
				end
			end
			-- на беговой дорожке доску прячем
			local hide = char:GetAttribute("OnTreadmill") == true
			if r and r.hidden ~= hide then
				r.hidden = hide
				for _, d in ipairs(char.Skateboard:GetDescendants()) do
					if d:IsA("BasePart") then
						d.LocalTransparencyModifier = hide and 1 or 0
					end
				end
			end
			if r and r.hum.Health > 0 then
				local target = targetFor(char, r, player == me, dt)
				for joint, m in pairs(r.motors) do
					local goal = target[joint] or CFrame.new()
					if r.isR6 then
						-- у R6 нет коленей: не опускаем таз, только наклоны
						goal = goal.Rotation
					end
					local cur = r.current[joint] or CFrame.new()
					cur = cur:Lerp(goal, alpha)
					r.current[joint] = cur
					if r.kind[joint] == "motor" then
						-- поворот задан в осях тела, переводим в оси сустава
						m.C0 = r.orig[joint] * (r.rotInv[joint] * cur * r.rot[joint])
						m.Transform = CFrame.new()
					else
						-- новые суставы: поза через Transform
						m.Transform = cur
					end
				end
			end
		end
	end
end

-- Стандартный бег Roblox выключаем совсем, пока игрок на доске:
-- останавливаем все его анимации каждый кадр.
local function stopDefaultAnimations()
	if fallbackOn then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char and char:FindFirstChild("Skateboard") then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			if animator then
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					track:Stop(0)
				end
			end
		end
	end
end

-- Позу ставим и до физики, и прямо перед отрисовкой кадра,
-- чтобы стандартные анимации точно не перебили её.
-- если что-то сломается, игра не упадёт, а в Output будет понятная строка
local warned = false
local function safeStep(dt)
	local ok, err = pcall(Rider.step, dt)
	if not ok and not warned then
		warned = true
		warn("[SkateRush] Ошибка анимации скейтера:", err)
		Players.LocalPlayer:SetAttribute("RiderStatus", "ошибка: " .. tostring(err))
	end
end
RunService.Stepped:Connect(function(_, dt)
	pcall(stopDefaultAnimations)
	safeStep(dt)
end)
RunService:BindToRenderStep("SkateRiderPose", Enum.RenderPriority.Character.Value + 5, function()
	safeStep(0)
end)

return Rider
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[-- Звуки и музыка. Номера звуков — в Config.Sounds.
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("SkateShared"):WaitForChild("Config"))

local Sounds = {}

local enabled = true
local musicEnabled = true
local cache = {}
local roll
local music
local currentMusic = ""

local function make(id, volume, looped)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.Looped = looped == true
	s.Parent = SoundService
	return s
end

function Sounds.play(name, pitch, volume)
	if not enabled then
		return
	end
	local id = Config.Sounds[name]
	if type(id) ~= "string" or id == "" then
		return
	end
	local s = cache[name]
	if not s then
		s = make(id, 0.6)
		cache[name] = s
	end
	s.PlaybackSpeed = pitch or 1
	s.Volume = volume or 0.6
	s:Play()
end

-- Звук колёс: громкость и высота зависят от скорости
function Sounds.setRoll(speed, onGround)
	local id = Config.Sounds.Roll
	if not enabled or id == "" then
		if roll then
			roll.Volume = 0
		end
		return
	end
	if not roll then
		roll = make(id, 0, true)
		roll:Play()
	end
	local target = onGround and math.clamp(speed / 80, 0, 0.6) or 0
	roll.Volume += (target - roll.Volume) * 0.2
	roll.PlaybackSpeed = 0.8 + math.clamp(speed / 150, 0, 0.6)
end

function Sounds.setZoneMusic(zoneIndex)
	local id = Config.Sounds.Music[zoneIndex] or ""
	if id == currentMusic then
		return
	end
	currentMusic = id
	if music then
		music:Stop()
		music:Destroy()
		music = nil
	end
	if id ~= "" then
		music = make(id, musicEnabled and 0.35 or 0, true)
		music:Play()
	end
end

function Sounds.setEnabled(sfx, mus)
	enabled = sfx
	musicEnabled = mus
	if music then
		music.Volume = mus and 0.35 or 0
	end
	if roll and not sfx then
		roll.Volume = 0
	end
end

return Sounds
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="Lighting" referent="RBX0000000F"><Properties><string name="Name">Lighting</string><float name="ClockTime">14</float><float name="FogEnd">1100</float></Properties></Item></roblox>
