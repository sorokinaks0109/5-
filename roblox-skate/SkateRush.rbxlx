	local barBg = new("Frame", { Size = UDim2.new(0.6, 0, 0, 8), Position = UDim2.new(0.2, 0, 0, 118), BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.4, Parent = refs.combo }, { corner(4) })
