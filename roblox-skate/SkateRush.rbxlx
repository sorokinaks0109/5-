--  ЕЖЕДНЕВНАЯ НАГРАДА (дни подряд). Умножается на множитель зоны.
-- ------------------------------------------------------------
Config.Daily = { 200, 400, 700, 1000, 1500, 2200, 5000 }

-- ------------------------------------------------------------
--  КОДЫ (вводятся в меню «Коды»). Каждый код — один раз.
--  Публикуй их в соцсетях, чтобы приводить игроков!
-- ------------------------------------------------------------
Config.Codes = {
	SKATE = 500,
	KICKFLIP = 1000,
	RUSH2026 = 2500,
}

-- ------------------------------------------------------------
--  ТРЮК-БИТВА: каждые несколько минут — соревнование на сервере
-- ------------------------------------------------------------
Config.Event = {
	Interval = 240, -- секунд между битвами
	Duration = 75, -- сколько длится битва
	Rewards = { 1.0, 0.5, 0.25 }, -- 1-е место получает ещё 100% своих очков монетами, 2-е 50%, 3-е 25%
}

-- ------------------------------------------------------------
--  Звёзды на карте
-- ------------------------------------------------------------
Config.Star = { Value = 25, Respawn = 45 }

-- ------------------------------------------------------------
--  Подсчёт комбо (одинаковый на сервере и у игрока)
-- ------------------------------------------------------------
function Config.comboScore(entries)
	local base = 0
	local count = 0
	local seen = {}
	for _, name in ipairs(entries) do
		local t = Config.Tricks[name]
		if t then
			local pts = t.points
			if t.multiplier then
				local n = seen[name] or 0
				pts = pts * Config.Combo.RepeatPenalty ^ n
				seen[name] = n + 1
				count += 1
			end
			base += pts
		end
	end
	local mult = math.min(Config.Combo.MaxMult, 1 + Config.Combo.MultStep * math.max(0, count - 1))
	return base, mult
end

-- Красивые числа: 1 250 / 12.5K / 3.4M
function Config.formatNumber(n)
	n = math.floor(n or 0)
	local abs = math.abs(n)
	if abs >= 1e12 then
		return string.format("%.1fT", n / 1e12)
	elseif abs >= 1e9 then
		return string.format("%.1fB", n / 1e9)
	elseif abs >= 1e6 then
		return string.format("%.1fM", n / 1e6)
	elseif abs >= 1e4 then
		return string.format("%.1fK", n / 1e3)
	end
	local s = tostring(n)
	local formatted = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (formatted:gsub("^%s+", ""))
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">BoardBuilder</string><ProtectedString name="Source"><![CDATA[-- ============================================================
--  Детальный скейтборд из деталей: дека с загнутыми носом и
--  хвостом, шкурка сверху, рисунок снизу, подвески, колёса с
--  подшипниками. Используется для доски игрока, витрины в лобби
--  и гигантских досок в обби.
--  Дека лежит длинной стороной вдоль оси Z, нос смотрит в -Z.
-- ============================================================

local BoardBuilder = {}

local THICK = 0.16 -- толщина деки
local WIDTH = 1.75

local function newPart(model, name, size, cf, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- cfg: deck, stripe, trail, wheel (необязательно), neon
-- opts.anchored = true — для витрины и обби (детали закреплены и с коллизией у деки)
function BoardBuilder.build(cfg, opts)
	opts = opts or {}
	local model = Instance.new("Model")
	model.Name = "Skateboard"

	local deckColor = cfg.deck
	local accent = cfg.stripe
	local wheelColor = cfg.wheel or cfg.stripe:Lerp(Color3.new(1, 1, 1), 0.5)
	local deckMat = cfg.neon and Enum.Material.Glass or Enum.Material.SmoothPlastic
	local grip = Color3.fromRGB(32, 32, 38)

	-- центральная часть деки
	local deck = newPart(model, "Deck", Vector3.new(WIDTH, THICK, 3.0), CFrame.new(), deckColor, deckMat)
	model.PrimaryPart = deck
	newPart(model, "Grip", Vector3.new(WIDTH - 0.08, 0.03, 3.0), CFrame.new(0, THICK / 2 + 0.015, 0), grip, Enum.Material.Sand)
	-- рисунок снизу: полоса и ромб
	newPart(model, "Graphic", Vector3.new(0.55, 0.03, 2.8), CFrame.new(0, -THICK / 2 - 0.015, 0), accent, cfg.neon and Enum.Material.Neon or Enum.Material.SmoothPlastic)
	newPart(model, "GraphicDiamond", Vector3.new(0.9, 0.03, 0.9), CFrame.new(0, -THICK / 2 - 0.02, 0) * CFrame.Angles(0, math.rad(45), 0), accent:Lerp(Color3.new(1, 1, 1), 0.4))
	-- лёгкий прогиб: приподнятые края
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, "Concave", Vector3.new(0.12, 0.06, 2.9), CFrame.new(sx * (WIDTH / 2 - 0.08), THICK / 2 + 0.045, 0), grip, Enum.Material.Sand)
	end

	-- нос (-Z) и хвост (+Z): два сегмента с нарастающим изгибом и круглый край
	for _, s in ipairs({ -1, 1 }) do
		local start = Vector3.new(0, 0, s * 1.5)
		local segs = { { len = 0.45, ang = 10 }, { len = 0.45, ang = 22 } }
		local lastCF
		for i, seg in ipairs(segs) do
			local a = math.rad(seg.ang)
			local dir = Vector3.new(0, math.sin(a), s * math.cos(a))
			local center = start + dir * (seg.len / 2)
			local cf = CFrame.new(center) * CFrame.Angles(-s * a, 0, 0)
			newPart(model, "Kick" .. i, Vector3.new(WIDTH, THICK, seg.len + 0.02), cf, deckColor, deckMat)
			newPart(model, "KickGrip" .. i, Vector3.new(WIDTH - 0.08, 0.03, seg.len + 0.02), cf * CFrame.new(0, THICK / 2 + 0.015, 0), grip, Enum.Material.Sand)
			start = start + dir * seg.len
			lastCF = CFrame.new(start) * CFrame.Angles(-s * a, 0, 0)
		end
		-- круглый край: диск чуть тоньше деки, чтобы грани не мигали
		newPart(model, "Round", Vector3.new(THICK - 0.03, WIDTH, WIDTH), lastCF * CFrame.Angles(0, 0, math.rad(90)), deckColor, deckMat, Enum.PartType.Cylinder)
		newPart(model, "RoundGrip", Vector3.new(0.03, WIDTH - 0.08, WIDTH - 0.08), lastCF * CFrame.new(0, THICK / 2 + 0.015, 0) * CFrame.Angles(0, 0, math.rad(90)), grip, Enum.Material.Sand, Enum.PartType.Cylinder)
	end

	-- подвески и колёса
	local metal = Color3.fromRGB(196, 200, 210)
	for _, z in ipairs({ -1.15, 1.15 }) do
		newPart(model, "Riser", Vector3.new(0.62, 0.06, 0.95), CFrame.new(0, -THICK / 2 - 0.03, z), Color3.fromRGB(30, 30, 30))
		newPart(model, "Baseplate", Vector3.new(0.55, 0.06, 0.85), CFrame.new(0, -THICK / 2 - 0.09, z), metal, Enum.Material.Metal)
		newPart(model, "Kingpin", Vector3.new(0.22, 0.18, 0.22), CFrame.new(0, -THICK / 2 - 0.2, z), metal, Enum.Material.Metal)
		newPart(model, "Bushing", Vector3.new(0.26, 0.08, 0.26), CFrame.new(0, -THICK / 2 - 0.17, z), accent)
		newPart(model, "Hanger", Vector3.new(1.45, 0.16, 0.24), CFrame.new(0, -THICK / 2 - 0.32, z), metal, Enum.Material.Metal)
		newPart(model, "Axle", Vector3.new(2.05, 0.07, 0.07), CFrame.new(0, -THICK / 2 - 0.34, z), metal, Enum.Material.Metal, Enum.PartType.Cylinder)
		for _, sx in ipairs({ -1, 1 }) do
			local wcf = CFrame.new(sx * 0.9, -THICK / 2 - 0.34, z)
			newPart(model, "Wheel", Vector3.new(0.3, 0.52, 0.52), wcf, wheelColor, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
			newPart(model, "Bearing", Vector3.new(0.32, 0.2, 0.2), wcf, metal, Enum.Material.Metal, Enum.PartType.Cylinder)
		end
	end

	-- все детали держатся за деку
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") then
			if opts.anchored then
				p.Anchored = true
				p.CanCollide = p == deck or p.Name:sub(1, 4) == "Kick" or p.Name == "Round"
			else
				p.Anchored = false
				p.CanCollide = false
				p.CanQuery = false
				p.CanTouch = false
				p.Massless = true
				if p ~= deck then
					local w = Instance.new("Weld")
					w.Part0 = deck
					w.Part1 = p
					w.C0 = deck.CFrame:Inverse() * p.CFrame
					w.Parent = p
				end
			end
		end
	end
	return model
end

-- Высота от центра деки до низа колёс (чтобы ставить доску на землю)
BoardBuilder.WheelDrop = THICK / 2 + 0.34 + 0.26
BoardBuilder.TopOffset = THICK / 2 + 0.03

return BoardBuilder
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000000C"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000005"><Properties><string name="Name">SkateServer</string><ProtectedString name="Source"><![CDATA[-- ============================================================
--  SKATE RUSH — сервер
--  Хранит монеты и уровни, проверяет трюки, продаёт товары,
--  проводит трюк-битвы. Игрок не может сам себе начислить монеты:
--  сервер сам пересчитывает каждое комбо.
-- ============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("SkateShared")
local Config = require(Shared:WaitForChild("Config"))
local Data = require(script:WaitForChild("Data"))
local World = require(script:WaitForChild("World"))
local BoardBuilder = require(Shared:WaitForChild("BoardBuilder"))

print("[SkateRush] Сервер запущен, версия", Config.Version)
local okWorld, worldErr = pcall(World.build)
if not okWorld then
	warn("[SkateRush] Ошибка при постройке карты:", worldErr)
end

-- ---------- remotes ----------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function newEvent(name)
	local e = Instance.new("RemoteEvent")
	e.Name = name
	e.Parent = remotes
	return e
end
local function newFunction(name)
	local f = Instance.new("RemoteFunction")
	f.Name = name
	f.Parent = remotes
	return f
end

local ComboBanked = newEvent("ComboBanked") -- клиент → сервер: комбо засчитано
local ComboBailed = newEvent("ComboBailed") -- клиент → сервер: упал
local ComboResult = newEvent("ComboResult") -- сервер → клиент: сколько начислено
local DataChanged = newEvent("DataChanged") -- сервер → клиент: новые данные
local Notify = newEvent("Notify") -- сервер → клиент: сообщение
local PickupTaken = newEvent("PickupTaken") -- сервер → клиент: звезда собрана
local AnimState = newEvent("AnimState") -- клиент → сервер: поза на доске (чтобы её видели другие)
local Request = newFunction("Request") -- все покупки и кнопки меню
remotes.Parent = ReplicatedStorage

-- ---------- состояние ----------
local profiles = {} -- [player] = data
local canSave = {} -- [player] = bool
local passes = {} -- [player] = { Coins2x = true, ... }
local budget = {} -- [player] = { allowance, last } — защита от накрутки
local pendingLost = {} -- [player] = { coins, xp, expires }
local starCooldown = {} -- [player] = { [part] = time }
local eventScores = {} -- [player] = score
local joinTime = {} -- [player] = os.time() захода
local giftsClaimed = {} -- [player] = { [index] = true } (на один заход)

local productByKey = {}
local productKeyById = {}
for key, p in pairs(Config.Products) do
	productByKey[key] = p
	if p.id ~= 0 then
		productKeyById[p.id] = key
	end
end
local passKeyById = {}
for key, p in pairs(Config.GamePasses) do
	if p.id ~= 0 then
		passKeyById[p.id] = key
	end
end

-- ---------- расчёты ----------
local function zoneMult(i)
	return Config.Zones[math.clamp(i, 1, #Config.Zones)].mult
end

local function currentZone(player)
	local data = profiles[player]
	local char = player.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	if not data or not rootPart then
		return 1
	end
	return math.min(World.zoneAt(rootPart.Position), data.maxZone)
end

local function coinMultiplier(player, zoneIndex)
	local data = profiles[player]
	local p = passes[player] or {}
	local m = zoneMult(zoneIndex)
	if p.Coins3x then
		m *= 3
	elseif p.Coins2x then
		m *= 2
	end
	if data.boostUntil > os.time() then
		m *= 2
	end
	m *= 1 + Config.Rebirth.Bonus * data.rebirths
	local board = Config.getBoard(data.equipped)
	if board.coinBonus then
		m *= 1 + board.coinBonus
	end
	return m
end

local function snapshot(player)
	local data = profiles[player]
	local today = math.floor(os.time() / 86400)
	return {
		coins = data.coins,
		xp = data.xp,
		level = data.level,
		speedLevel = data.speedLevel,
		boards = data.boards,
		equipped = data.equipped,
		maxZone = data.maxZone,
		rebirths = data.rebirths,
		dailyStreak = data.dailyStreak,
		dailyReady = data.lastDailyDay ~= today,
		dailyNext = (data.lastDailyDay == today - 1) and (data.dailyStreak % #Config.Daily + 1) or 1,
		boostLeft = math.max(0, data.boostUntil - os.time()),
		bestCombo = data.bestCombo,
		passes = passes[player] or {},
		coinMult = coinMultiplier(player, currentZone(player)),
		saving = canSave[player] == true,
		trails = data.trails,
		trail = data.trail,
		settings = data.settings,
		played = os.time() - (joinTime[player] or os.time()),
		gifts = (function()
			-- сплошной список true/false: так он без потерь проходит через сеть
			local list = {}
			local claimed = giftsClaimed[player] or {}
			for i = 1, #Config.Gifts do
				list[i] = claimed[i] == true
			end
			return list
		end)(),
		quest = data.quest,
		starterLeft = data.starterBought and 0 or math.max(0, data.firstJoin + Config.StarterOfferMinutes * 60 - os.time()),
	}
end

local function applyStats(player)
	local data = profiles[player]
	if not data then
		return
	end
	local speed = Config.maxSpeed(data.speedLevel, data.equipped)
	local jump = Config.jumpPower(data.equipped)
	player:SetAttribute("MaxSpeed", speed)
	player:SetAttribute("JumpPower", jump)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.UseJumpPower = true
		hum.JumpPower = jump
	end
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls["Монеты"].Value = math.floor(data.coins)
		ls["Уровень"].Value = data.level
		ls["Перерожд."].Value = data.rebirths
	end
end

local dirty = {} -- кому нужно сохраниться
local function push(player)
	if profiles[player] then
		dirty[player] = true
		applyStats(player)
		DataChanged:FireClient(player, snapshot(player))
	end
end

local function notify(player, text, kind)
	Notify:FireClient(player, text, kind or "info")
end

local function addCoins(player, amount)
	local data = profiles[player]
	data.coins += math.floor(amount)
end

local function addXp(player, amount)
	local data = profiles[player]
	data.xp += math.floor(amount)
	local leveled = false
	while data.xp >= Config.xpForLevel(data.level) do
		data.xp -= Config.xpForLevel(data.level)
		data.level += 1
		leveled = true
	end
	if leveled then
		notify(player, "НОВЫЙ УРОВЕНЬ " .. data.level .. "!", "level")
		local nextZone = Config.Zones[data.maxZone + 1]
		if nextZone and data.level == nextZone.level then
			notify(player, "Теперь можно открыть зону «" .. nextZone.name .. "»!", "good")
		end
	end
end

-- ---------- данные: вход и выход ----------
local function setupLeaderstats(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, name in ipairs({ "Уровень", "Монеты", "Перерожд." }) do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = ls
	end
	ls.Parent = player
end

local function checkPasses(player)
	local owned = {}
	for key, p in pairs(Config.GamePasses) do
		if p.id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, p.id)
			end)
			if ok and has then
				owned[key] = true
			end
		end
	end
	passes[player] = owned
end

-- ---------- доска на персонаже ----------
local function attachBoard(player)
	local data = profiles[player]
	local char = player.Character
	if not data or not char then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not hum or not rootPart then
		return
	end
	local old = char:FindFirstChild("Skateboard")
	if old then
		old:Destroy()
	end
	local oldWeld = rootPart:FindFirstChild("BoardWeld")
	if oldWeld then
		oldWeld:Destroy()
	end

	-- поднимаем персонажа, чтобы он стоял НА доске
	if char:GetAttribute("BaseHip") == nil then
		char:SetAttribute("BaseHip", hum.HipHeight)
		hum.HipHeight += BoardBuilder.WheelDrop + BoardBuilder.TopOffset
	end
	local baseHip = char:GetAttribute("BaseHip")
	local legs = hum.RigType == Enum.HumanoidRigType.R15 and baseHip or 2
	-- центр деки чуть ниже ступней: ноги стоят на шкурке
	local offset = legs + rootPart.Size.Y / 2 + BoardBuilder.TopOffset

	local cfg = Config.getBoard(data.equipped)
	local model = Instance.new("Model")
	model.Name = "Skateboard"

	local function bpart(name, size, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		if shape then
			p.Shape = shape
		end
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	local deck
	-- Красивая модель доски из Toolbox: ReplicatedStorage → SkateAssets → Board_<id> или Board
	local assets = ReplicatedStorage:FindFirstChild("SkateAssets")
	local custom = assets and (assets:FindFirstChild("Board_" .. cfg.id) or assets:FindFirstChild("Board"))
	if custom and custom:IsA("Model") then
		local clone = custom:Clone()
		deck = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
		if deck then
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = false
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					d.Massless = true
					if d ~= deck then
						local w = Instance.new("Weld")
						w.Part0 = deck
						w.Part1 = d
						w.C0 = deck.CFrame:Inverse() * d.CFrame
						w.Parent = d
					end
				end
			end
			deck.Name = "Deck"
			for _, ch in ipairs(clone:GetChildren()) do
				ch.Parent = model
			end
			clone:Destroy()
			model.PrimaryPart = deck
		end
	end
	if not deck then
		-- детальная доска: дека с носом и хвостом, подвески, колёса
		local built = BoardBuilder.build(cfg)
		deck = built.PrimaryPart
		for _, ch in ipairs(built:GetChildren()) do
			ch.Parent = model
		end
		built:Destroy()
		model.PrimaryPart = deck
	end

	-- след за доской
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailA"
	a0.Position = Vector3.new(-0.7, 0, 2.3)
	a0.Parent = deck
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailB"
	a1.Position = Vector3.new(0.7, 0, 2.3)
	a1.Parent = deck
	local trail = Instance.new("Trail")
	trail.Name = "BoardTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	local trailCfg = Config.getTrail(data.trail)
	if trailCfg.colors then
		local keys = {}
		for k, c in ipairs(trailCfg.colors) do
			table.insert(keys, ColorSequenceKeypoint.new((k - 1) / math.max(1, #trailCfg.colors - 1), c))
		end
		trail.Color = ColorSequence.new(keys)
	else
		trail.Color = ColorSequence.new(cfg.trail)
	end
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.5
	trail.LightEmission = cfg.neon and 1 or 0
	trail.FaceCamera = true
	trail.Enabled = false
	trail.Parent = deck

	-- искры для грайнда (включает клиент)
	local sparkA = Instance.new("Attachment")
	sparkA.Name = "SparkA"
	sparkA.Position = Vector3.new(0, -0.4, 0)
	sparkA.Parent = deck
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "Sparks"
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 230, 120), Color3.fromRGB(255, 120, 0))
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(0.35, 0)
	sparks.Lifetime = NumberRange.new(0.2, 0.4)
	sparks.Speed = NumberRange.new(10, 18)
	sparks.SpreadAngle = Vector2.new(60, 60)
	sparks.Rate = 80
	sparks.Enabled = false
	sparks.Parent = sparkA

	-- красивый эффект доски
	local effectA = Instance.new("Attachment")
	effectA.Name = "EffectA"
	effectA.Position = Vector3.new(0, -0.2, 1.6)
	effectA.Parent = deck
	local fx = cfg.effect
	if fx == "fire" then
		local fire = Instance.new("Fire")
		fire.Size = 3
		fire.Heat = 4
		fire.Color = Color3.fromRGB(255, 120, 0)
		fire.SecondaryColor = Color3.fromRGB(255, 220, 0)
		fire.Parent = deck
	elseif fx then
		local e = Instance.new("ParticleEmitter")
		e.Name = "BoardEffect"
		e.LightEmission = 0.7
		e.Lifetime = NumberRange.new(0.6, 1.2)
		e.Speed = NumberRange.new(1, 3)
		e.SpreadAngle = Vector2.new(60, 60)
		e.Rate = 10
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-60, 60)
		if fx == "hearts" then
			e.Color = ColorSequence.new(Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 200, 220))
			e.Size = NumberSequence.new(0.4, 0)
			e.Acceleration = Vector3.new(0, 3, 0)
		elseif fx == "snow" then
			e.Color = ColorSequence.new(Color3.new(1, 1, 1))
			e.Size = NumberSequence.new(0.3, 0)
			e.Acceleration = Vector3.new(0, -2, 0)
		elseif fx == "stars" then
			e.Color = ColorSequence.new(Color3.fromRGB(255, 120, 255), Color3.fromRGB(120, 220, 255))
			e.Size = NumberSequence.new(0.5, 0)
			e.Rate = 16
		else -- sparkle
			e.Color = ColorSequence.new(cfg.trail)
			e.Size = NumberSequence.new(0.35, 0)
		end
		e.Parent = effectA
	end

	deck.CFrame = rootPart.CFrame * CFrame.new(0, -offset, 0)
	model.Parent = char

	local weld = Instance.new("Weld")
	weld.Name = "BoardWeld"
	weld.Part0 = rootPart
	weld.Part1 = deck
	weld.C0 = CFrame.new(0, -offset, 0)
	weld:SetAttribute("BaseOffset", offset)
	weld.Parent = rootPart
end

local function onCharacter(player, char)
	local hum = char:WaitForChild("Humanoid", 10)
	local rootPart = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not rootPart then
		return
	end
	-- ждём, пока загрузятся данные
	local t = 0
	while not profiles[player] and t < 15 do
		t += task.wait(0.2)
	end
	local data = profiles[player]
	if not data then
		return
	end
	attachBoard(player)
	applyStats(player)
	-- появляемся в последней зоне
	local zoneIndex = math.clamp(data.lastZone, 1, data.maxZone)
	if zoneIndex > 1 then
		task.wait(0.1)
		char:PivotTo(World.zoneSpawn(zoneIndex))
	end
end

local function onPlayerAdded(player)
	setupLeaderstats(player)
	checkPasses(player)
	local data, ok = Data.load(player)
	if not player.Parent then
		return
	end
	if data.firstJoin == 0 then
		data.firstJoin = os.time()
	end
	joinTime[player] = os.time()
	giftsClaimed[player] = {}
	profiles[player] = data
	canSave[player] = ok
	budget[player] = { allowance = 5, last = os.clock() }
	starCooldown[player] = {}
	push(player)
	if not ok then
		if RunService:IsStudio() then
			notify(player, "Studio: сохранение выключено (включи API Services в Game Settings → Security)", "warn")
		else
			notify(player, "Не удалось загрузить прогресс. Перезайди, чтобы он сохранялся.", "warn")
		end
	end
	if data.lastDailyDay ~= math.floor(os.time() / 86400) then
		task.delay(3, function()
			if player.Parent then
				notify(player, "🎁 Ежедневная награда ждёт тебя!", "good")
			end
		end)
	end

	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

local function saveAndForget(player)
	local data = profiles[player]
	if data then
		data.lastZone = currentZone(player)
		if canSave[player] then
			Data.save(player, data)
		end
	end
	profiles[player] = nil
	canSave[player] = nil
	passes[player] = nil
	budget[player] = nil
	pendingLost[player] = nil
	starCooldown[player] = nil
	eventScores[player] = nil
	joinTime[player] = nil
	giftsClaimed[player] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end
Players.PlayerRemoving:Connect(saveAndForget)

game:BindToClose(function()
	local threads = {}
	for _, player in ipairs(Players:GetPlayers()) do
		table.insert(threads, task.spawn(function()
			local data = profiles[player]
			if data and canSave[player] then
				data.lastZone = currentZone(player)
				Data.save(player, data)
			end
		end))
	end
	task.wait(RunService:IsStudio() and 1 or 5)
end)

-- автосохранение
task.spawn(function()
	while true do
		task.wait(30)
		for player, data in pairs(profiles) do
			if canSave[player] and dirty[player] then
				dirty[player] = nil
				data.lastZone = currentZone(player)
				task.spawn(Data.save, player, data)
			end
		end
	end
end)

-- ---------- проверка комбо ----------
-- Каждый трюк «стоит» времени. Время копится в реальном темпе.
-- Если игрок присылает трюков больше, чем физически успел бы сделать, — комбо не засчитывается.
local function validateEntries(player, entries)
	if type(entries) ~= "table" then
		return nil
	end
	local count = #entries
	if count == 0 or count > Config.Combo.MaxEntries then
		return nil
	end
	local clean = {}
	local cost = 0
	for i = 1, count do
		local name = entries[i]
		if type(name) ~= "string" then
			return nil
		end
		local t = Config.Tricks[name]
		if not t then
			return nil
		end
		cost += t.duration * 0.7
		clean[i] = name
	end
	local b = budget[player]
	local now = os.clock()
	b.allowance = math.min(b.allowance + (now - b.last), 40)
	b.last = now
	if cost > b.allowance then
		return nil
	end
	b.allowance -= cost
	return clean
end

local function comboReward(player, entries)
	local data = profiles[player]
	local zone = currentZone(player)
	local base, mult = Config.comboScore(entries)
	local score = base * mult
	local coins = math.floor(score * coinMultiplier(player, zone))
	local xp = math.floor(score * (1 + (zoneMult(zone) - 1) * 0.5))
	return coins, xp, score
end

local eventActive = false

ComboBanked.OnServerEvent:Connect(function(player, entries)
	local data = profiles[player]
	if not data then
		return
	end
	local clean = validateEntries(player, entries)
	if not clean then
		return
	end
	local coins, xp, score = comboReward(player, clean)
	addCoins(player, coins)
	addXp(player, xp)
	data.totalTricks += #clean
	local record = false
	if coins > data.bestCombo then
		data.bestCombo = coins
		record = #clean >= 3
	end
	if eventActive then
		eventScores[player] = (eventScores[player] or 0) + math.floor(score)
		player:SetAttribute("EventScore", eventScores[player])
	end
	local _, mult = Config.comboScore(clean)
	ComboResult:FireClient(player, coins, xp, record, mult)
	push(player)
end)

ComboBailed.OnServerEvent:Connect(function(player, entries)
	if not profiles[player] then
		return
	end
	local clean = validateEntries(player, entries)
	if not clean then
		return
	end
	local coins, xp = comboReward(player, clean)
	pendingLost[player] = { coins = coins, xp = xp, expires = os.clock() + 25 }
end)

-- ---------- звёзды ----------
local function awardStar(player, starPart)
	local cd = starCooldown[player]
	local now = os.clock()
	if not cd or (cd[starPart] and cd[starPart] > now) then
		return
	end
	cd[starPart] = now + Config.Star.Respawn
	local value = starPart:GetAttribute("Value") or Config.Star.Value
	local zone = World.zoneAt(starPart.Position)
	local coins = math.floor(value * coinMultiplier(player, math.min(zone, profiles[player].maxZone)))
	addCoins(player, coins)
	addXp(player, value)
	PickupTaken:FireClient(player, starPart, Config.Star.Respawn, coins)
	push(player)
end

local function hookStar(starPart)
	starPart.Touched:Connect(function(hit)
		local char = hit.Parent
		local player = char and Players:GetPlayerFromCharacter(char)
		if player and profiles[player] then
			awardStar(player, starPart)
		end
	end)
end
local allStars = CollectionService:GetTagged("Pickup")
for _, s in ipairs(allStars) do
	hookStar(s)
end

-- Магнит: доски с magnet сами собирают звёзды вокруг
task.spawn(function()
	while true do
		task.wait(0.3)
		for player, data in pairs(profiles) do
			local board = Config.getBoard(data.equipped)
			local radius = board.magnet
			local char = player.Character
			local rootPart = char and char:FindFirstChild("HumanoidRootPart")
			if radius and rootPart then
				for _, starPart in ipairs(allStars) do
					if (starPart.Position - rootPart.Position).Magnitude <= radius then
						awardStar(player, starPart)
					end
				end
			end
		end
	end
end)

-- ---------- беговые дорожки: стоишь — копишь монеты ----------
local AfkCoins = Instance.new("RemoteEvent")
AfkCoins.Name = "AfkCoins"
AfkCoins.Parent = remotes
local treadmillZones = CollectionService:GetTagged("Treadmill")
local afkTimer = {}
local afkWarned = {}
local function treadmillAt(position)
	for _, zonePart in ipairs(treadmillZones) do
		local rel = zonePart.CFrame:PointToObjectSpace(position)
		local half = zonePart.Size / 2
		if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z then
			return zonePart:GetAttribute("Index")
		end
	end
	return nil
end
task.spawn(function()
	while true do
		local dt = task.wait(0.25)
		for player, data in pairs(profiles) do
			local char = player.Character
			local rootPart = char and char:FindFirstChild("HumanoidRootPart")
			local idx = rootPart and treadmillAt(rootPart.Position)
			local t = idx and Config.Treadmills[idx]
			if t and data.level < t.level then
				if not afkWarned[player] then
					afkWarned[player] = true
					notify(player, "Эта дорожка открывается с " .. t.level .. " уровня", "warn")
				end
				t = nil
			elseif not t then
				afkWarned[player] = nil
			end
			if char then
				char:SetAttribute("OnTreadmill", t ~= nil)
			end
			if t then
				afkTimer[player] = (afkTimer[player] or 0) + dt
				if afkTimer[player] >= 2 then
					afkTimer[player] -= 2
					local c = math.floor(t.coins * coinMultiplier(player, data.maxZone))
					addCoins(player, c)
					AfkCoins:FireClient(player, c)
					push(player)
				end
			else
				afkTimer[player] = 0
			end
		end
	end
end)
Players.PlayerRemoving:Connect(function(player)
	afkTimer[player] = nil
	afkWarned[player] = nil
end)

-- ---------- обби: финиш ----------
local obbyLast = {}
for _, finish in ipairs(CollectionService:GetTagged("ObbyFinish")) do
	finish.Touched:Connect(function(hit)
		local char = hit.Parent
		local player = char and Players:GetPlayerFromCharacter(char)
		local data = player and profiles[player]
		if not data then
			return
		end
		local now = os.time()
		if obbyLast[player] and now - obbyLast[player] < 3 then
			return
		end
		obbyLast[player] = now
		local wait = (data.obbyTime or 0) + Config.Obby.Cooldown - now
		if wait > 0 then
			notify(player, "Обби пройдено! Награду можно снова получить через " .. math.ceil(wait / 60) .. " мин.", "info")
		else
			data.obbyTime = now
			local c = math.floor(Config.Obby.Reward * zoneMult(data.maxZone))
			addCoins(player, c)
			notify(player, "🏆 Обби пройдено! +" .. Config.formatNumber(c) .. " 💰", "good")
			push(player)
		end
		task.delay(1.5, function()
			if char.Parent then
				char:PivotTo(World.lobbySpawn())
			end
		end)
	end)
end

-- ---------- покупки за робуксы ----------
local function grantProduct(player, key)
	local data = profiles[player]
	if not data then
		return false
	end
	if key == "SaveCombo" then
		local lost = pendingLost[player]
		if lost and lost.expires > os.clock() then
			addCoins(player, lost.coins)
			addXp(player, lost.xp)
			notify(player, "Комбо спасено! +" .. Config.formatNumber(lost.coins) .. " 💰", "good")
		else
			local c = 100 * data.level
			addCoins(player, c)
			notify(player, "+" .. Config.formatNumber(c) .. " 💰", "good")
		end
		pendingLost[player] = nil
	elseif key == "SkipZone" then
		if data.maxZone < #Config.Zones then
			data.maxZone += 1
			notify(player, "Открыта зона «" .. Config.Zones[data.maxZone].name .. "»!", "good")
		else
			local c = Config.CoinPackBase.CoinsBig * zoneMult(data.maxZone)
			addCoins(player, c)
			notify(player, "Все зоны уже открыты, держи монеты: +" .. Config.formatNumber(c) .. " 💰", "good")
		end
	elseif key == "Boost2x" then
		local minutes = Config.Products.Boost2x.minutes
		data.boostUntil = math.max(data.boostUntil, os.time()) + minutes * 60
		notify(player, "⚡ Буст x2 включён на " .. minutes .. " минут!", "good")
	elseif key == "LevelUp" then
		addXp(player, Config.xpForLevel(data.level) - data.xp)
	elseif key == "StarterPack" then
		local c = Config.StarterCoins * zoneMult(data.maxZone)
		addCoins(player, c)
		data.boostUntil = math.max(data.boostUntil, os.time()) + 15 * 60
		data.trails.rainbow = true
		data.trail = "rainbow"
		data.starterBought = true
		attachBoard(player)
		notify(player, "🎁 Стартовый набор: +" .. Config.formatNumber(c) .. " 💰, буст x2 и радужный след!", "good")
	elseif key == "CoinsSmall" or key == "CoinsBig" then
		local c = Config.CoinPackBase[key] * zoneMult(data.maxZone)
		addCoins(player, c)
		notify(player, "+" .. Config.formatNumber(c) .. " 💰", "good")
	else
		return false
	end
	push(player)
	return true
end

MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local data = player and profiles[player]
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.receipts, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productKeyById[info.ProductId]
	if not key or not grantProduct(player, key) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.receipts, info.PurchaseId)
	while #data.receipts > 50 do
		table.remove(data.receipts, 1)
	end
	if canSave[player] then
		Data.save(player, data)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function grantPass(player, key)
	passes[player] = passes[player] or {}
	passes[player][key] = true
	local cfg = Config.GamePasses[key]
	notify(player, "Спасибо! " .. cfg.name .. " — твой!", "good")
	if key == "GoldBoard" and profiles[player] then
		profiles[player].equipped = "gold"
		attachBoard(player)
	end
	push(player)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	local key = passKeyById[passId]
	if purchased and key then
		grantPass(player, key)
	end
end)

-- ---------- кнопки меню ----------
local handlers = {}

function handlers.BuySpeed(player, data)
	if data.speedLevel >= Config.Speed.MaxLevel then
		return false, "Скорость уже максимальная!"
	end
	local cost = Config.speedCost(data.speedLevel)
	if data.coins < cost then
		return false, "Не хватает монет"
	end
	data.coins -= cost
	data.speedLevel += 1
	return true
end

function handlers.BuySpeedMax(player, data)
	local bought = 0
	while data.speedLevel < Config.Speed.MaxLevel and data.coins >= Config.speedCost(data.speedLevel) do
		data.coins -= Config.speedCost(data.speedLevel)
		data.speedLevel += 1
		bought += 1
	end
	if bought == 0 then
		return false, "Не хватает монет"
	end
	return true, "+" .. bought .. " к скорости!"
end

function handlers.BuyBoard(player, data, id)
	local b = Config.getBoard(id)
	if b.id ~= id then
		return false, "Нет такой доски"
	end
	if b.pass then
		local owned = passes[player] and passes[player][b.pass]
		if not owned then
			return false, "Эта доска продаётся за робуксы"
		end
		data.equipped = id
		attachBoard(player)
		return true
	end
	if data.boards[id] then
		data.equipped = id
		attachBoard(player)
		return true
	end
	if data.coins < b.price then
		return false, "Не хватает монет"
	end
	data.coins -= b.price
	data.boards[id] = true
	data.equipped = id
	attachBoard(player)
	return true, "Новая доска: " .. b.name .. "!"
end

function handlers.UnlockZone(player, data, index)
	if type(index) ~= "number" or index ~= data.maxZone + 1 then
		return false, "Сначала открой предыдущие зоны"
	end
	local z = Config.Zones[index]
	if not z then
		return false, "Это последняя зона"
	end
	if data.level < z.level then
		return false, "Нужен уровень " .. z.level
	end
	if data.coins < z.cost then
		return false, "Не хватает монет"
	end
	data.coins -= z.cost
	data.maxZone = index
	if canSave[player] then
		task.spawn(Data.save, player, data) -- важная покупка: сохраняем сразу
	end
	return true, "Открыта зона «" .. z.name .. "»!"
end

function handlers.Teleport(player, data, index)
	if type(index) ~= "number" or index < 0 or index > data.maxZone then
		return false, "Зона закрыта"
	end
	local char = player.Character
	if char then
		char:PivotTo(World.zoneSpawn(index))
	end
	return true
end

function handlers.Rebirth(player, data)
	local cost = Config.rebirthCost(data.rebirths)
	if data.coins < cost then
		return false, "Нужно " .. Config.formatNumber(cost) .. " 💰"
	end
	data.coins = 0
	data.speedLevel = 0
	data.rebirths += 1
	return true, "ПЕРЕРОЖДЕНИЕ! Теперь монет +" .. math.floor(Config.Rebirth.Bonus * data.rebirths * 100) .. "% навсегда"
end

function handlers.ClaimDaily(player, data)
	local today = math.floor(os.time() / 86400)
	if data.lastDailyDay == today then
		return false, "Уже забрано. Приходи завтра!"
	end
	if data.lastDailyDay == today - 1 then
		data.dailyStreak = data.dailyStreak % #Config.Daily + 1
	else
		data.dailyStreak = 1
	end
	data.lastDailyDay = today
	local c = Config.Daily[data.dailyStreak] * zoneMult(data.maxZone)
	addCoins(player, c)
	return true, "День " .. data.dailyStreak .. ": +" .. Config.formatNumber(c) .. " 💰"
end

function handlers.RedeemCode(player, data, code)
	if type(code) ~= "string" then
		return false, "Введи код"
	end
	code = code:upper():gsub("%s", "")
	local reward = Config.Codes[code]
	if not reward then
		return false, "Неверный код"
	end
	if data.codes[code] then
		return false, "Этот код уже использован"
	end
	data.codes[code] = true
	addCoins(player, reward)
	return true, "Код принят: +" .. Config.formatNumber(reward) .. " 💰"
end

function handlers.BuyTrail(player, data, id)
	local t = Config.getTrail(id)
	if t.id ~= id then
		return false, "Нет такого следа"
	end
	if not data.trails[id] then
		if t.starter then
			return false, "Этот след есть только в стартовом наборе"
		end
		if data.coins < t.price then
			return false, "Не хватает монет"
		end
		data.coins -= t.price
		data.trails[id] = true
	end
	data.trail = id
	attachBoard(player)
	return true, "След «" .. t.name .. "» надет!"
end

function handlers.ClaimGift(player, data, index)
	local g = type(index) == "number" and Config.Gifts[index]
	if not g then
		return false, "Нет такого подарка"
	end
	local claimed = giftsClaimed[player]
	if claimed[index] then
		return false, "Уже забрано"
	end
	if os.time() - joinTime[player] < g.minutes * 60 then
		return false, "Ещё рано!"
	end
	claimed[index] = true
	local c = g.coins * zoneMult(data.maxZone)
	addCoins(player, c)
	return true, "🎁 +" .. Config.formatNumber(c) .. " 💰"
end

-- Задания: те, что можно проверить по данным, сервер проверяет сам
local QUEST_CHECK = {
	speed = function(data)
		return data.speedLevel >= 1
	end,
	level4 = function(data)
		return data.level >= 4
	end,
	zone2 = function(data)
		return data.maxZone >= 2
	end,
	zone3 = function(data)
		return data.maxZone >= 3
	end,
	board = function(data)
		local n = 0
		for _ in pairs(data.boards) do
			n += 1
		end
		return n >= 2 or data.equipped == "gold"
	end,
}

function handlers.QuestDone(player, data, index)
	local q = Config.Quests[data.quest]
	if type(index) ~= "number" or index ~= data.quest or not q then
		return false
	end
	local check = QUEST_CHECK[q.kind]
	if check and not check(data) then
		return false
	end
	data.quest += 1
	addCoins(player, q.reward)
	return true, "✅ Задание выполнено! +" .. Config.formatNumber(q.reward) .. " 💰"
end

function handlers.SaveSettings(player, data, settings)
	if type(settings) ~= "table" then
		return false
	end
	data.settings.music = settings.music == true
	data.settings.sfx = settings.sfx == true
	local lim = tonumber(settings.speedLimit) or 100
	data.settings.speedLimit = math.clamp(math.floor(lim), 30, 100)
	return true
end

-- В Studio товары с ID = 0 выдаются бесплатно, чтобы всё можно было проверить
function handlers.StudioPurchase(player, data, kind, key)
	if not RunService:IsStudio() then
		return false, "Товар ещё не настроен"
	end
	if kind == "product" and productByKey[key] then
		grantProduct(player, key)
		return true, "(Studio) бесплатная проверка покупки"
	elseif kind == "pass" and Config.GamePasses[key] then
		grantPass(player, key)
		return true, "(Studio) бесплатная проверка геймпасса"
	end
	return false, "Нет такого товара"
end

Request.OnServerInvoke = function(player, action, ...)
	local data = profiles[player]
	if not data or type(action) ~= "string" then
		return false, "Подожди, данные загружаются"
	end
	local h = handlers[action]
	if not h then
		return false, "?"
	end
	local ok, msg = h(player, data, ...)
	push(player)
	return ok, msg
end

-- ---------- поза на доске для других игроков ----------
local ANIM_STATES = { ride = true, air = true, grind = true, bail = true, Kickflip = true, Spin = true, Grab = true, Backflip = true, mount = true, ollie = true, land = true }
local animStamp = {}
AnimState.OnServerEvent:Connect(function(player, state)
	if type(state) ~= "string" or not ANIM_STATES[state] then
		return
	end
	local now = os.clock()
	if animStamp[player] and now - animStamp[player] < 0.05 then
		return
	end
	animStamp[player] = now
	local char = player.Character
	if char then
		char:SetAttribute("SkateAnim", state)
	end
end)
Players.PlayerRemoving:Connect(function(player)
	animStamp[player] = nil
end)

-- ---------- витрина досок в лобби ----------
local function hookStand(stand)
	local prompt = stand:FindFirstChildOfClass("ProximityPrompt")
	local id = stand:GetAttribute("BoardId")
	if not prompt or not id then
		return
	end
	prompt.Triggered:Connect(function(player)
		local data = profiles[player]
		if not data then
			return
		end
		local b = Config.getBoard(id)
		if b.pass and not (passes[player] and passes[player][b.pass]) then
			notify(player, "Золотая доска продаётся в магазине за робуксы 💎", "warn")
			return
		end
		local ok, msg = handlers.BuyBoard(player, data, id)
		if msg then
			notify(player, msg, ok and "good" or "warn")
		elseif ok then
			notify(player, "Доска «" .. b.name .. "» надета!", "good")
		end
		push(player)
	end)
end
for _, stand in ipairs(CollectionService:GetTagged("BoardStand")) do
	hookStand(stand)
end

-- ---------- трюк-битва ----------
task.spawn(function()
	while true do
		task.wait(Config.Event.Interval)
		eventScores = {}
		for _, p in ipairs(Players:GetPlayers()) do
			p:SetAttribute("EventScore", 0)
		end
		eventActive = true
		ReplicatedStorage:SetAttribute("EventEnds", workspace:GetServerTimeNow() + Config.Event.Duration)
		ReplicatedStorage:SetAttribute("EventActive", true)
		for _, p in ipairs(Players:GetPlayers()) do
			notify(p, "🏆 ТРЮК-БИТВА началась! Набери больше всех очков!", "event")
		end
		task.wait(Config.Event.Duration)
		eventActive = false
		ReplicatedStorage:SetAttribute("EventActive", false)

		local ranking = {}
		for p, score in pairs(eventScores) do
			if p.Parent and score > 0 then
				table.insert(ranking, { player = p, score = score })
			end
		end
		table.sort(ranking, function(a, b)
			return a.score > b.score
		end)
		local summary = {}
		for place, entry in ipairs(ranking) do
			local factor = Config.Event.Rewards[place]
			if not factor then
				break
			end
			local data = profiles[entry.player]
			if data then
				local coins = math.floor(entry.score * factor * coinMultiplier(entry.player, data.maxZone))
				addCoins(entry.player, coins)
				notify(entry.player, place .. " место в битве! +" .. Config.formatNumber(coins) .. " 💰", "good")
				push(entry.player)
			end
			table.insert(summary, place .. ". " .. entry.player.DisplayName)
		end
		if #summary > 0 then
			for _, p in ipairs(Players:GetPlayers()) do
				notify(p, "🏆 Итоги битвы: " .. table.concat(summary, "   "), "event")
			end
		end
	end
end)

-- раз в 10 секунд обновляем таймер буста и множитель зоны
task.spawn(function()
	while true do
		task.wait(10)
		for player in pairs(profiles) do
			push(player)
		end
	end
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- Сохранение прогресса игроков (DataStore).
-- В Roblox Studio сохранение работает, только если включено:
-- Game Settings → Security → Enable Studio Access to API Services.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Data = {}

local STORE_NAME = "SkateRush_v1"

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[SkateRush] DataStore недоступен, прогресс не будет сохраняться:", result)
	end
end

function Data.default()
	return {
		coins = 0,
		xp = 0,
		level = 1,
		speedLevel = 0,
		boards = { basic = true },
		equipped = "basic",
		maxZone = 1,
		lastZone = 1,
		rebirths = 0,
		dailyStreak = 0,
		lastDailyDay = 0,
		codes = {},
		receipts = {},
		boostUntil = 0,
		bestCombo = 0,
		totalTricks = 0,
		trails = { board = true },
		trail = "board",
		firstJoin = 0,
		starterBought = false,
		quest = 1,
		obbyTime = 0,
		settings = { music = true, sfx = true, speedLimit = 100 },
	}
end

local function reconcile(saved)
	local fresh = Data.default()
	if type(saved) ~= "table" then
		return fresh
	end
	for k, v in pairs(fresh) do
		if saved[k] == nil or type(saved[k]) ~= type(v) then
			saved[k] = v
		end
	end
	return saved
end

local function key(player)
	return "player_" .. player.UserId
end

-- Возвращает data, loadedOk. Если загрузка сломалась на живом сервере,
-- loadedOk = false, и мы такой профиль НЕ сохраняем, чтобы не стереть прогресс.
function Data.load(player)
	if not store then
		return Data.default(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok then
			return reconcile(result), true
		end
		warn("[SkateRush] Ошибка загрузки (попытка " .. attempt .. "):", result)
		if RunService:IsStudio() and tostring(result):find("API") then
			break
		end
		task.wait(1.5 * attempt)
	end
	return Data.default(), false
end

function Data.save(player, data)
	if not store or not data then
		return false
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function()
				return data
			end)
		end)
		if ok then
			return true
		end
		warn("[SkateRush] Ошибка сохранения (попытка " .. attempt .. "):", err)
		task.wait(1 * attempt)
	end
	return false
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- ============================================================
--  Строит всю карту кодом: лобби с витриной досок и 7 зон.
--  Если папка Workspace → SkateWorld уже есть (ты построила карту
--  в Studio и сохранила), скрипт её НЕ трогает — можно править руками.
--  Построить карту в Studio без запуска игры (Command Bar):
--    require(game.ServerScriptService.SkateServer.World).build()
-- ============================================================

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("SkateShared")
local Config = require(Shared:WaitForChild("Config"))
local BoardBuilder = require(Shared:WaitForChild("BoardBuilder"))

local World = {}

local L = Config.ZoneLength
local W = Config.ZoneWidth
local LOBBY = 150 -- длина лобби (от z = 0 до z = +LOBBY)

local root

-- ---------- helpers ----------

local function part(props, parent)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	if props.Shape then
		p.Shape = props.Shape
	end
	for k, v in pairs(props) do
		if k ~= "ClassName" and k ~= "Shape" then
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function deco(props, parent)
	props.CanCollide = props.CanCollide == true
	props.CanQuery = false
	props.CanTouch = false
	props.CastShadow = props.CastShadow ~= false
	return part(props, parent)
end

local function billboard(parent, text, size, offsetY, color)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(size.X, size.Y)
	bb.StudsOffset = Vector3.new(0, offsetY or 0, 0)
	bb.LightInfluence = 0
	bb.MaxDistance = 250
	bb.Parent = parent
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.Parent = bb
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Parent = t
	return bb, t
end

local function zoneStartZ(i)
	return -(i - 1) * L
end

function World.zoneSpawn(i)
	if i <= 0 then
		return CFrame.new(0, 4, LOBBY - 30)
	end
	return CFrame.new(0, 4, zoneStartZ(i) - 18)
end

function World.zoneAt(position)
	local i = math.floor(-position.Z / L) + 1
	return math.clamp(i, 1, #Config.Zones)
end

-- Наклонная плита: поднимается в сторону -Z (по ходу игры)
local function ramp(parent, x, z, width, height, angleDeg, color, material)
	local a = math.rad(angleDeg)
	local len = height / math.sin(a)
	local depth = len * math.cos(a)
	local p = part({
		Name = "Ramp",
		Size = Vector3.new(width, 1, len),
		CFrame = CFrame.new(x, height / 2 - 0.5 * math.cos(a), z - depth / 2) * CFrame.Angles(a, 0, 0),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	}, parent)
	part({
		Name = "Support",
		Size = Vector3.new(width, height, 2),
		CFrame = CFrame.new(x, height / 2 - 0.5, z - depth + 1),
		Color = color:Lerp(Color3.new(0, 0, 0), 0.25),
	}, parent)
	return p, depth
end

-- Изогнутый трамплин как в скейт-парке: несколько секций с нарастающим
-- наклоном, боковые стенки, металлическая кромка (coping) и неоновая полоса.
local WOOD = Color3.fromRGB(214, 176, 128)
local WOOD_DARK = Color3.fromRGB(150, 110, 75)
local function curvedRamp(parent, x, z, width, height, angles, surfaceColor, tag, power)
	local sumSin = 0
	for _, a in ipairs(angles) do
		sumSin += math.sin(math.rad(a))
	end
	local l = height / sumSin
	local p = Vector3.new(x, 0, z)
	local segs = {}
	for i, aDeg in ipairs(angles) do
		local a = math.rad(aDeg)
		local d = Vector3.new(0, math.sin(a), -math.cos(a))
		local up = Vector3.new(0, math.cos(a), math.sin(a))
		local center = p + d * (l / 2) - up * 0.5
		local seg = part({ Name = "RampSurface", Size = Vector3.new(width, 1, l + 0.05), CFrame = CFrame.new(center) * CFrame.Angles(a, 0, 0), Color = surfaceColor }, parent)
		-- полоски-доски на поверхности
		deco({ Name = "RampPlank", Size = Vector3.new(width - 0.6, 0.06, 0.25), CFrame = seg.CFrame * CFrame.new(0, 0.53, 0), Color = surfaceColor:Lerp(Color3.new(0, 0, 0), 0.18), CastShadow = false }, parent)
		local pEnd = p + d * l
		-- заполнение и боковые стенки
		local hMid = (p.Y + pEnd.Y) / 2
		local depth = l * math.cos(a)
		if hMid > 0.3 then
			deco({ Name = "RampFill", Size = Vector3.new(width - 0.4, hMid - 0.2, depth), CFrame = CFrame.new(x, (hMid - 0.2) / 2, (p.Z + pEnd.Z) / 2), Color = WOOD_DARK }, parent)
		end
		for _, sx in ipairs({ -1, 1 }) do
			deco({ Name = "RampSide", Size = Vector3.new(0.35, math.max(0.3, pEnd.Y), depth + 0.02), CFrame = CFrame.new(x + sx * (width / 2 + 0.05), math.max(0.3, pEnd.Y) / 2 - 0.05, (p.Z + pEnd.Z) / 2), Color = WOOD, CanCollide = true }, parent)
		end
		if tag and i >= #angles - 1 then
			seg.Name = "Kicker"
			seg:SetAttribute("Power", power)
			CollectionService:AddTag(seg, tag)
		end
		table.insert(segs, seg)
		p = pEnd
	end
	-- задняя стенка, металлическая кромка и неоновая полоса
	deco({ Name = "RampBack", Size = Vector3.new(width + 0.7, p.Y, 0.4), CFrame = CFrame.new(x, p.Y / 2, p.Z - 0.2), Color = WOOD, CanCollide = true }, parent)
	deco({ Name = "Coping", Shape = Enum.PartType.Cylinder, Size = Vector3.new(width + 0.6, 0.55, 0.55), CFrame = CFrame.new(x, p.Y, p.Z), Color = Color3.fromRGB(215, 220, 230), Material = Enum.Material.Metal }, parent)
	return segs, p
end

local function kicker(parent, x, z, width, power, color)
	local segs, top = curvedRamp(parent, x, z, width, 3.6, { 6, 14, 24, 34 }, color:Lerp(Color3.new(1, 1, 1), 0.35), "Kicker", power)
	deco({ Name = "KickerStripe", Size = Vector3.new(width + 0.1, 0.12, 0.6), CFrame = CFrame.new(x, top.Y - 0.25, top.Z + 0.6) * CFrame.Angles(math.rad(34), 0, 0), Color = color, Material = Enum.Material.Neon }, parent)
	for k = 0, 1 do
		deco({ Name = "Arrow", Size = Vector3.new(width * 0.5, 0.1, 2), CFrame = CFrame.new(x, 0.25, z + 4 + k * 4), Color = color, Material = Enum.Material.Neon, Transparency = 0.2 }, parent)
	end
	return segs[#segs]
end

local function rail(parent, x, z, length, accent)
	local height = 2.4
	-- невидимая «ступенька» для грайнда и красивая круглая труба поверх
	local r = part({ Name = "Rail", Size = Vector3.new(1.6, 0.5, length), CFrame = CFrame.new(x, height, z - length / 2), Transparency = 1 }, parent)
	r:SetAttribute("Rail", true)
	CollectionService:AddTag(r, "Rail")
	deco({ Name = "RailPipe", Shape = Enum.PartType.Cylinder, Size = Vector3.new(length, 0.7, 0.7), CFrame = CFrame.new(x, height + 0.05, z - length / 2) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(225, 230, 240), Material = Enum.Material.Metal }, parent)
	deco({ Name = "RailGlow", Size = Vector3.new(0.25, 0.15, length), CFrame = CFrame.new(x, height - 0.38, z - length / 2), Color = accent, Material = Enum.Material.Neon }, parent)
	local posts = math.max(2, math.floor(length / 10))
	for k = 0, posts do
		local pz = z - length * k / posts
		deco({ Name = "RailPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, 0.4, 0.4), CFrame = CFrame.new(x, height / 2 - 0.2, pz) * CFrame.Angles(0, 0, math.rad(90)), Color = accent:Lerp(Color3.new(1, 1, 1), 0.3), CanCollide = true }, parent)
		deco({ Name = "RailBase", Size = Vector3.new(1.4, 0.15, 1.4), CFrame = CFrame.new(x, 0.3, pz), Color = Color3.fromRGB(120, 120, 130), Material = Enum.Material.DiamondPlate }, parent)
	end
	curvedRamp(parent, x, z + 7, 4, height - 0.3, { 8, 16, 22 }, Color3.fromRGB(205, 205, 220))
	return r
end

-- Гирлянда флажков над трассой
local function garland(parent, z, colors)
	local edge = W / 2 - 4
	for _, sx in ipairs({ -1, 1 }) do
		deco({ Name = "GarlandPole", Shape = Enum.PartType.Cylinder, Size = Vector3.new(20, 0.6, 0.6), CFrame = CFrame.new(sx * edge, 10, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(240, 240, 245), CanCollide = true }, parent)
		deco({ Name = "GarlandTop", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = CFrame.new(sx * edge, 20.4, z), Color = colors[1] }, parent)
	end
	local n = 30
	for k = 0, n do
		local t = k / n
		local px = -edge + t * edge * 2
		local sag = 4 * (1 - (2 * t - 1) ^ 2)
		local py = 19.5 - sag
		if k < n then
			local t2 = (k + 1) / n
			local px2 = -edge + t2 * edge * 2
			local py2 = 19.5 - 4 * (1 - (2 * t2 - 1) ^ 2)
			local mid = Vector3.new((px + px2) / 2, (py + py2) / 2, z)
			local len = (Vector3.new(px2, py2, z) - Vector3.new(px, py, z)).Magnitude
			deco({ Name = "GarlandString", Size = Vector3.new(len, 0.12, 0.12), CFrame = CFrame.new(mid) * CFrame.Angles(0, 0, math.atan2(py2 - py, px2 - px)), Color = Color3.fromRGB(250, 250, 250), CastShadow = false }, parent)
			do
				deco({ Name = "Flag", Size = Vector3.new(1.3, 1.3, 0.08), CFrame = CFrame.new(mid.X, mid.Y - 0.9, z) * CFrame.Angles(0, 0, math.rad(45)), Color = colors[k % #colors + 1], CastShadow = false }, parent)
			end
		end
	end
end

local function funbox(parent, x, z, color, accent)
	local h, len, w = 3, 18, 22
	local _, d = ramp(parent, x, z, w, h, 20, color)
	local boxZ = z - d - len / 2
	part({ Name = "Funbox", Size = Vector3.new(w, h, len), CFrame = CFrame.new(x, h / 2, boxZ), Color = color }, parent)
	deco({ Name = "FunboxEdge", Size = Vector3.new(w + 0.2, 0.4, len + 0.2), CFrame = CFrame.new(x, h - 0.1, boxZ), Color = accent, Material = Enum.Material.Neon }, parent)
	local a = math.rad(20)
	local rl = h / math.sin(a)
	local rd = rl * math.cos(a)
	part({ Name = "RampDown", Size = Vector3.new(w, 1, rl), CFrame = CFrame.new(x, h / 2 - 0.5 * math.cos(a), boxZ - len / 2 - rd / 2) * CFrame.Angles(-a, 0, 0), Color = color }, parent)
	local r = part({ Name = "Rail", Size = Vector3.new(1.6, 0.5, len - 2), CFrame = CFrame.new(x, h + 1.4, boxZ), Color = Color3.fromRGB(235, 235, 245), Material = Enum.Material.Metal }, parent)
	r:SetAttribute("Rail", true)
	CollectionService:AddTag(r, "Rail")
end

local function boostPad(parent, x, z, color)
	local pad = part({ Name = "BoostPad", Size = Vector3.new(12, 0.3, 10), CFrame = CFrame.new(x, 0.2, z), Color = color, Material = Enum.Material.Neon, CanCollide = false }, parent)
	CollectionService:AddTag(pad, "Boost")
	for k = 0, 2 do
		deco({ Name = "Chevron", Size = Vector3.new(8 - k * 2, 0.3, 1), CFrame = CFrame.new(x, 0.42, z + 3 - k * 3), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon }, parent)
	end
	return pad
end

local function megaRamp(parent, x, z, zone)
	local height = 16
	local _, d = ramp(parent, x, z, 30, height, 17, zone.floor2:Lerp(zone.accent, 0.35))
	local topZ = z - d
	part({ Name = "MegaTop", Size = Vector3.new(30, height, 14), CFrame = CFrame.new(x, height / 2 - 0.5, topZ - 7), Color = zone.cliff }, parent)
	local k = part({ Name = "Kicker", Size = Vector3.new(30, 1, 8), CFrame = CFrame.new(x, height + 1.2, topZ - 13) * CFrame.Angles(math.rad(28), 0, 0), Color = zone.accent, Material = Enum.Material.Neon }, parent)
	k:SetAttribute("Power", 125)
	k:SetAttribute("Mega", true)
	CollectionService:AddTag(k, "Kicker")
	local sign = deco({ Name = "MegaSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(x, height + 9, topZ - 14), Transparency = 1 }, parent)
	billboard(sign, "МЕГА-ТРАМПЛИН", Vector2.new(20, 4), 0)
	return topZ - 17
end

local function star(parent, pos, value)
	local s = part({ Name = "Star", Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2.6, 2.6), CFrame = CFrame.new(pos), Color = Color3.fromRGB(255, 215, 0), Material = Enum.Material.Neon, CanCollide = false, CanQuery = false }, parent)
	s:SetAttribute("Value", value)
	CollectionService:AddTag(s, "Pickup")
	return s
end

-- ---------- красивые модели из Toolbox ----------
-- Положи модель в ReplicatedStorage → SkateAssets с нужным именем
-- (например Tree_sakura, Palm, Lollipop, Cloud), и игра поставит её
-- вместо простой фигуры. Имена — в инструкции.
local function asset(name, cf, parent, ground)
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("SkateAssets")
	local src = folder and folder:FindFirstChild(name)
	if not src or not (src:IsA("Model") or src:IsA("BasePart")) then
		return false
	end
	local c = src:Clone()
	if c:IsA("BasePart") then
		c.Anchored = true
		c.CFrame = cf
		if ground then
			c.CFrame = cf + Vector3.new(0, c.Size.Y / 2, 0)
		end
	else
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		c:PivotTo(cf)
		if ground then
			local bcf, size = c:GetBoundingBox()
			c:PivotTo(c:GetPivot() + Vector3.new(0, cf.Position.Y - (bcf.Position.Y - size.Y / 2), 0))
		end
	end
	c.Parent = parent
	return true
end

-- ---------- декор ----------

local function cloud(parent, pos, rng)
	if asset("Cloud", CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), parent, false) then
		return
	end
	for k = 1, 6 do
		local r = rng:NextNumber(10, 22)
		deco({ Name = "Cloud", Shape = Enum.PartType.Ball, Size = Vector3.new(r, r, r), CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-16, 16), rng:NextNumber(-3, 4), rng:NextNumber(-8, 8))), Color = Color3.new(1, 1, 1), CastShadow = false }, parent)
	end
end

local function blockTree(parent, x, z, rng, leafColors, trunkColor, petals, assetName)
	if asset(assetName or "Tree_sakura", CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), parent, true) then
		return
	end
	local h = rng:NextNumber(10, 16)
	-- круглый изогнутый ствол
	local lean = rng:NextNumber(-0.15, 0.15)
	for k = 1, 3 do
		local seg = h / 3
		deco({ Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(seg + 0.6, 2.2 - k * 0.35, 2.2 - k * 0.35), CFrame = CFrame.new(x + lean * k * 2, (k - 0.5) * seg, z) * CFrame.Angles(0, 0, math.rad(90) + lean * k), Color = trunkColor, CanCollide = k == 1 }, parent)
	end
	-- ветки
	for _, side in ipairs({ -1, 1 }) do
		deco({ Name = "Branch", Shape = Enum.PartType.Cylinder, Size = Vector3.new(5, 0.8, 0.8), CFrame = CFrame.new(x + side * 2.2 + lean * 6, h - 1, z) * CFrame.Angles(0, 0, side * math.rad(35)), Color = trunkColor }, parent)
	end
	-- пышная круглая крона
	local canopy
	local cx = x + lean * 6
	for k = 1, 9 do
		local s = rng:NextNumber(5, 9)
		local ang = k / 9 * math.pi * 2
		local c = deco({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(s, s, s),
			CFrame = CFrame.new(cx + math.cos(ang) * rng:NextNumber(2, 5), h + 1.5 + rng:NextNumber(-1, 3.5), z + math.sin(ang) * rng:NextNumber(2, 5)),
			Color = leafColors[rng:NextInteger(1, #leafColors)],
			CastShadow = true,
		}, parent)
		canopy = canopy or c
	end
	deco({ Name = "LeavesTop", Shape = Enum.PartType.Ball, Size = Vector3.new(8, 8, 8), CFrame = CFrame.new(cx, h + 5, z), Color = leafColors[1]:Lerp(Color3.new(1, 1, 1), 0.2) }, parent)
	if petals and canopy then
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(leafColors[1])
		e.Size = NumberSequence.new(0.35)
		e.Lifetime = NumberRange.new(4, 6)
		e.Rate = 3
		e.Speed = NumberRange.new(1, 2)
		e.Acceleration = Vector3.new(1, -1.5, 0)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-90, 90)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Parent = canopy
	end
end

local function waterfall(parent, x, z, top, side)
	local w = 10
	deco({ Name = "Waterfall", Size = Vector3.new(1, top, w), CFrame = CFrame.new(x, top / 2, z), Color = Color3.fromRGB(120, 210, 255), Material = Enum.Material.Glass, Transparency = 0.25, CastShadow = false }, parent)
	deco({ Name = "WaterfallShine", Size = Vector3.new(1.1, top, 2), CFrame = CFrame.new(x, top / 2, z + 2), Color = Color3.fromRGB(235, 250, 255), Material = Enum.Material.Neon, Transparency = 0.4, CastShadow = false }, parent)
	local pool = deco({ Name = "Pool", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 18, 18), CFrame = CFrame.new(x - side * 6, 0.15, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(90, 200, 255), Material = Enum.Material.Glass, Transparency = 0.2 }, parent)
	for k = 1, 4 do
		deco({ Name = "Foam", Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4), CFrame = CFrame.new(x - side * 2, 0.6, z + (k - 2.5) * 3), Color = Color3.new(1, 1, 1), CastShadow = false }, parent)
	end
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Color3.new(1, 1, 1))
	e.Size = NumberSequence.new(1.2, 0)
	e.Transparency = NumberSequence.new(0.2, 1)
	e.Lifetime = NumberRange.new(0.6, 1)
	e.Rate = 15
	e.Speed = NumberRange.new(6, 10)
	e.SpreadAngle = Vector2.new(60, 60)
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = pool
end

local function donutArch(parent, z, rng)
	local radius = 72
	local icing = ({ Color3.fromRGB(255, 130, 190), Color3.fromRGB(150, 90, 60), Color3.fromRGB(255, 255, 255), Color3.fromRGB(180, 120, 255) })[rng:NextInteger(1, 4)]
	local dough = Color3.fromRGB(240, 190, 120)
	local n = 20
	for k = 0, n do
		local a = math.pi * k / n
		local px, py = math.cos(a) * radius, math.sin(a) * radius
		local cf = CFrame.new(px, py, z) * CFrame.Angles(0, 0, a)
		deco({ Name = "Donut", Size = Vector3.new(9, 15, 15), CFrame = cf, Color = dough, CanCollide = true }, parent)
		deco({ Name = "Icing", Size = Vector3.new(4, 15.4, 15.4), CFrame = cf * CFrame.new(3.5, 0, 0), Color = icing }, parent)
		if k % 2 == 0 then
			local sprinkle = ({ Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 220, 0), Color3.fromRGB(0, 200, 255), Color3.fromRGB(255, 60, 120) })[rng:NextInteger(1, 4)]
			deco({ Name = "Sprinkle", Size = Vector3.new(0.6, 0.6, 2.4), CFrame = cf * CFrame.new(5.8, rng:NextNumber(-5, 5), rng:NextNumber(-5, 5)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = sprinkle, Material = Enum.Material.Neon }, parent)
		end
	end
end

local function lollipop(parent, x, z, rng)
	if asset("Lollipop", CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), parent, true) then
		return
	end
	local h = rng:NextNumber(14, 22)
	deco({ Name = "Stick", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 1, 1), CFrame = CFrame.new(x, h / 2, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.new(1, 1, 1), CanCollide = true }, parent)
	local c1 = ({ Color3.fromRGB(255, 80, 150), Color3.fromRGB(255, 200, 0), Color3.fromRGB(80, 220, 255), Color3.fromRGB(170, 100, 255) })[rng:NextInteger(1, 4)]
	deco({ Name = "Candy", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 11, 11), CFrame = CFrame.new(x, h + 4, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = c1 }, parent)
	deco({ Name = "CandySwirl", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.2, 6, 6), CFrame = CFrame.new(x, h + 4, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = Color3.new(1, 1, 1) }, parent)
end

local function candyCane(parent, x, z)
	if asset("CandyCane", CFrame.new(x, 0, z), parent, true) then
		return
	end
	for k = 0, 7 do
		deco({ Name = "Cane", Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(x, 1 + k * 2, z), Color = (k % 2 == 0) and Color3.fromRGB(255, 50, 70) or Color3.new(1, 1, 1), CanCollide = true }, parent)
	end
	for k = 1, 3 do
		deco({ Name = "Cane", Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(x + k * 1.6, 16 + math.sin(k / 3 * math.pi) * 2, z), Color = (k % 2 == 0) and Color3.fromRGB(255, 50, 70) or Color3.new(1, 1, 1) }, parent)
	end
end

local function gumdrop(parent, x, z, rng)
	local s = rng:NextNumber(5, 9)
	local c = ({ Color3.fromRGB(255, 90, 160), Color3.fromRGB(120, 230, 120), Color3.fromRGB(255, 210, 60), Color3.fromRGB(110, 170, 255) })[rng:NextInteger(1, 4)]
	deco({ Name = "Gumdrop", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s, s), CFrame = CFrame.new(x, s * 0.25, z), Color = c, Material = Enum.Material.Glass, Transparency = 0.1, CanCollide = true }, parent)
end

local function palm(parent, x, z, rng)
	if asset("Palm", CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), parent, true) then
		return
	end
	local h = rng:NextNumber(14, 20)
	local lean = rng:NextNumber(-0.15, 0.15)
	for k = 0, 5 do
		deco({ Name = "PalmTrunk", Size = Vector3.new(1.6, h / 6 + 0.2, 1.6), CFrame = CFrame.new(x + lean * k * 3, k * h / 6 + h / 12, z) * CFrame.Angles(0, k * 0.3, 0), Color = (k % 2 == 0) and Color3.fromRGB(170, 120, 70) or Color3.fromRGB(150, 100, 60), CanCollide = k == 0 }, parent)
	end
	local top = Vector3.new(x + lean * 15, h, z)
	for k = 1, 7 do
		local ang = k * math.pi * 2 / 7
		deco({ Name = "PalmLeaf", Size = Vector3.new(2, 0.4, 9), CFrame = CFrame.new(top) * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -4) * CFrame.Angles(math.rad(-25), 0, 0), Color = Color3.fromRGB(40, 190, 80) }, parent)
	end
	deco({ Name = "Coconut", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), CFrame = CFrame.new(top - Vector3.new(0, 1, 0)), Color = Color3.fromRGB(110, 70, 40) }, parent)
end

local function umbrella(parent, x, z, rng)
	if asset("Umbrella", CFrame.new(x, 0, z), parent, true) then
		return
	end
	deco({ Name = "Pole", Size = Vector3.new(0.5, 9, 0.5), CFrame = CFrame.new(x, 4.5, z), Color = Color3.new(1, 1, 1) }, parent)
	local c = ({ Color3.fromRGB(255, 80, 80), Color3.fromRGB(0, 180, 255), Color3.fromRGB(255, 200, 0) })[rng:NextInteger(1, 3)]
	deco({ Name = "Umbrella", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 12, 12), CFrame = CFrame.new(x, 9, z) * CFrame.Angles(0, 0, math.rad(90)), Color = c }, parent)
	deco({ Name = "UmbrellaTop", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 5, 5), CFrame = CFrame.new(x, 9.3, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.new(1, 1, 1) }, parent)
end

local function building(parent, x, z, rng, accent)
	local w = rng:NextNumber(20, 30)
	local d = rng:NextNumber(20, 30)
	local h = rng:NextNumber(50, 130)
	deco({ Name = "Building", Size = Vector3.new(w, h, d), CFrame = CFrame.new(x, h / 2, z), Color = Color3.fromRGB(35, 30, 60), CanCollide = true }, parent)
	local colors = { accent, Color3.fromRGB(0, 230, 255), Color3.fromRGB(255, 230, 120) }
	local side = x > 0 and -1 or 1
	for row = 1, math.floor(h / 9) do
		if rng:NextNumber() < 0.75 then
			deco({ Name = "Window", Size = Vector3.new(0.3, 3, d * 0.8), CFrame = CFrame.new(x + side * (w / 2 + 0.1), row * 9 - 3, z), Color = colors[rng:NextInteger(1, #colors)], Material = Enum.Material.Neon }, parent)
		end
	end
	deco({ Name = "Roof", Size = Vector3.new(w + 1, 1, d + 1), CFrame = CFrame.new(x, h + 0.5, z), Color = accent, Material = Enum.Material.Neon }, parent)
end

local function neonArch(parent, z, color)
	for _, side in ipairs({ -1, 1 }) do
		deco({ Name = "ArchPost", Size = Vector3.new(3, 40, 3), CFrame = CFrame.new(side * 70, 20, z), Color = color, Material = Enum.Material.Neon, CanCollide = true }, parent)
	end
	deco({ Name = "ArchTop", Size = Vector3.new(143, 3, 3), CFrame = CFrame.new(0, 40, z), Color = color, Material = Enum.Material.Neon }, parent)
end

local function crystal(parent, x, z, rng)
	if asset("Crystal", CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), parent, true) then
		return
	end
	local h = rng:NextNumber(10, 26)
	deco({ Name = "Crystal", Size = Vector3.new(h * 0.3, h, h * 0.3), CFrame = CFrame.new(x, h / 2 - 1, z) * CFrame.Angles(math.rad(rng:NextNumber(-20, 20)), rng:NextNumber(0, 6), math.rad(rng:NextNumber(-20, 20))), Color = Color3.fromRGB(140, 220, 255), Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = true }, parent)
end

local function snowman(parent, x, z)
	if asset("Snowman", CFrame.new(x, 0, z), parent, true) then
		return
	end
	local y = 0
	for k, s in ipairs({ 8, 6, 4 }) do
		y += s / 2
		deco({ Name = "Snow", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s, s), CFrame = CFrame.new(x, y, z), Color = Color3.new(1, 1, 1), CanCollide = k == 1 }, parent)
		y += s / 2 - 0.8
	end
	deco({ Name = "Nose", Size = Vector3.new(0.6, 0.6, 2), CFrame = CFrame.new(x, y - 1.5, z + 2), Color = Color3.fromRGB(255, 140, 0) }, parent)
end

local function rock(parent, x, z, rng, color)
	if asset("Rock", CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), parent, true) then
		return
	end
	local s = rng:NextNumber(6, 15)
	deco({ Name = "Rock", Size = Vector3.new(s, s * 0.8, s), CFrame = CFrame.new(x, s * 0.3, z) * CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), rng:NextNumber(0, 1)), Color = color, Material = Enum.Material.Slate, CanCollide = true }, parent)
end

local function lavaPool(parent, x, z, rng)
	local w, d = rng:NextNumber(10, 18), rng:NextNumber(10, 18)
	local lava = part({ Name = "Lava", Size = Vector3.new(w, 0.3, d), CFrame = CFrame.new(x, 0.3, z), Color = Color3.fromRGB(255, 100, 0), Material = Enum.Material.Neon, CanCollide = false, CanQuery = false }, parent)
	CollectionService:AddTag(lava, "Lava")
	local fire = Instance.new("ParticleEmitter")
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 170, 0), Color3.fromRGB(255, 40, 0))
	fire.LightEmission = 1
	fire.Size = NumberSequence.new(1.5, 0)
	fire.Lifetime = NumberRange.new(0.6, 1.2)
	fire.Rate = 10
	fire.Speed = NumberRange.new(4, 8)
	fire.EmissionDirection = Enum.NormalId.Top
	fire.Parent = lava
end

local function planet(parent, pos, size, color, ring)
	deco({ Name = "Planet", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), CFrame = CFrame.new(pos), Color = color, CastShadow = false }, parent)
	if ring then
		deco({ Name = "Ring", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, size * 1.8, size * 1.8), CFrame = CFrame.new(pos) * CFrame.Angles(0.4, 0, math.rad(90) + 0.3), Color = ring, Material = Enum.Material.Neon, Transparency = 0.4, CastShadow = false }, parent)
	end
end

-- ---------- слои пола (разная высота = ничего не мигает) ----------
local Y_STRIPE = 0.03 -- центр полос (верх 0.06)
local Y_TILE = 0.09 -- центр плиток кромки (верх 0.12)
local Y_ROAD = 0.15 -- центр дороги (верх 0.18)
local Y_MARK = 0.21 -- центр разметки и цветочков (верх 0.24)
local LAYER = 0.06

-- Ставит любой декор на высоту y (например, на верх скалы)
local function at(parent, y, fn, ...)
	local tmp = Instance.new("Folder")
	fn(tmp, ...)
	for _, d in ipairs(tmp:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = d.CFrame + Vector3.new(0, y, 0)
		end
	end
	for _, ch in ipairs(tmp:GetChildren()) do
		if ch:IsA("Model") then
			ch:PivotTo(ch:GetPivot())
		end
		ch.Parent = parent
	end
	tmp:Destroy()
end

local function pick(rng, list)
	return list[rng:NextInteger(1, #list)]
end

-- ---------- новые предметы декора ----------

local function bush(parent, x, z, rng, color)
	for k = 1, 3 do
		local s = rng:NextNumber(3, 5)
		deco({ Name = "Bush", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s, s), CFrame = CFrame.new(x + (k - 2) * 1.8, s * 0.35, z + rng:NextNumber(-1, 1)), Color = color }, parent)
	end
end

local function flowerPatch(parent, x, z, rng, colors)
	for _ = 1, 5 do
		local c = pick(rng, colors)
		local px, pz = x + rng:NextNumber(-3, 3), z + rng:NextNumber(-3, 3)
		deco({ Name = "Stem", Size = Vector3.new(0.2, 1, 0.2), CFrame = CFrame.new(px, 0.5, pz), Color = Color3.fromRGB(90, 170, 80), CastShadow = false }, parent)
		deco({ Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = CFrame.new(px, 1.1, pz), Color = c, CastShadow = false }, parent)
	end
end

local function torii(parent, z)
	local red = Color3.fromRGB(220, 70, 60)
	for _, sx in ipairs({ -1, 1 }) do
		deco({ Name = "ToriiPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(30, 3, 3), CFrame = CFrame.new(sx * 24, 15, z) * CFrame.Angles(0, 0, math.rad(90)), Color = red, CanCollide = true }, parent)
		deco({ Name = "ToriiFoot", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 4, 4), CFrame = CFrame.new(sx * 24, 1, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(40, 35, 35) }, parent)
	end
	deco({ Name = "ToriiTop", Size = Vector3.new(62, 2.2, 3.6), CFrame = CFrame.new(0, 31, z), Color = Color3.fromRGB(40, 35, 35) }, parent)
	deco({ Name = "ToriiBeam", Size = Vector3.new(58, 2, 2.8), CFrame = CFrame.new(0, 29, z), Color = red }, parent)
	deco({ Name = "ToriiBeam2", Size = Vector3.new(52, 1.4, 2), CFrame = CFrame.new(0, 24, z), Color = red }, parent)
	deco({ Name = "ToriiPlate", Size = Vector3.new(3, 5, 2.4), CFrame = CFrame.new(0, 26.5, z), Color = Color3.fromRGB(40, 35, 35) }, parent)
end

local function lantern(parent, x, z)
	local stone = Color3.fromRGB(190, 185, 180)
	deco({ Name = "LanternBase", Size = Vector3.new(2.4, 0.6, 2.4), CFrame = CFrame.new(x, 0.3, z), Color = stone, CanCollide = true }, parent)
	deco({ Name = "LanternPole", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 0.9, 0.9), CFrame = CFrame.new(x, 2.1, z) * CFrame.Angles(0, 0, math.rad(90)), Color = stone }, parent)
	local light = deco({ Name = "LanternLight", Size = Vector3.new(1.8, 1.6, 1.8), CFrame = CFrame.new(x, 4.4, z), Color = Color3.fromRGB(255, 220, 150), Material = Enum.Material.Neon }, parent)
	deco({ Name = "LanternRoof", Size = Vector3.new(3, 0.6, 3), CFrame = CFrame.new(x, 5.5, z) * CFrame.Angles(0, math.rad(45), 0), Color = stone }, parent)
	local pl = Instance.new("PointLight")
	pl.Color = light.Color
	pl.Range = 10
	pl.Brightness = 0.8
	pl.Parent = light
end

local function cupcake(parent, x, z, rng)
	local s = rng:NextNumber(1, 1.6)
	deco({ Name = "CupBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4 * s, 6 * s, 6 * s), CFrame = CFrame.new(x, 2 * s, z) * CFrame.Angles(0, 0, math.rad(90)), Color = pick(rng, { Color3.fromRGB(150, 200, 255), Color3.fromRGB(255, 200, 120), Color3.fromRGB(200, 160, 255) }), CanCollide = true }, parent)
	deco({ Name = "Frosting", Shape = Enum.PartType.Ball, Size = Vector3.new(7 * s, 5 * s, 7 * s), CFrame = CFrame.new(x, 5 * s, z), Color = pick(rng, { Color3.fromRGB(255, 190, 220), Color3.fromRGB(255, 255, 255), Color3.fromRGB(180, 120, 90) }) }, parent)
	deco({ Name = "Cherry", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6 * s, 1.6 * s, 1.6 * s), CFrame = CFrame.new(x, 7.6 * s, z), Color = Color3.fromRGB(230, 30, 60) }, parent)
end

local function iceCream(parent, x, z, rng)
	deco({ Name = "Cone", Shape = Enum.PartType.Cylinder, Size = Vector3.new(8, 2.4, 2.4), CFrame = CFrame.new(x, 4, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(220, 170, 100), CanCollide = true }, parent)
	deco({ Name = "ConeTop", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 4, 4), CFrame = CFrame.new(x, 8.4, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(220, 170, 100) }, parent)
	for k = 1, 3 do
		deco({ Name = "Scoop", Shape = Enum.PartType.Ball, Size = Vector3.new(4.4, 4.4, 4.4), CFrame = CFrame.new(x, 9.5 + (k - 1) * 3, z), Color = pick(rng, { Color3.fromRGB(255, 180, 210), Color3.fromRGB(180, 255, 210), Color3.fromRGB(255, 245, 200), Color3.fromRGB(190, 150, 110) }) }, parent)
	end
end

local function surfboard(parent, x, z, rng)
	local c = pick(rng, { Color3.fromRGB(255, 120, 120), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 220, 80) })
	local cf = CFrame.new(x, 4, z) * CFrame.Angles(0, rng:NextNumber(0, 3), math.rad(rng:NextNumber(-12, 12)))
	deco({ Name = "Surfboard", Size = Vector3.new(2.2, 7, 0.35), CFrame = cf, Color = c, CanCollide = true }, parent)
	deco({ Name = "SurfTip", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.34, 2.2, 2.2), CFrame = cf * CFrame.new(0, 3.5, 0) * CFrame.Angles(0, math.rad(90), 0), Color = c }, parent)
	deco({ Name = "SurfStripe", Size = Vector3.new(0.4, 6.6, 0.4), CFrame = cf, Color = Color3.new(1, 1, 1) }, parent)
end

local function sandcastle(parent, x, z)
	local sand = Color3.fromRGB(235, 205, 140)
	deco({ Name = "Castle", Size = Vector3.new(7, 3, 7), CFrame = CFrame.new(x, 1.5, z), Color = sand, CanCollide = true }, parent)
	for _, o in ipairs({ Vector3.new(-3, 0, -3), Vector3.new(3, 0, -3), Vector3.new(-3, 0, 3), Vector3.new(3, 0, 3) }) do
		deco({ Name = "Tower", Shape = Enum.PartType.Cylinder, Size = Vector3.new(5, 2.4, 2.4), CFrame = CFrame.new(x + o.X, 2.5, z + o.Z) * CFrame.Angles(0, 0, math.rad(90)), Color = sand }, parent)
	end
	deco({ Name = "Flag", Size = Vector3.new(0.2, 3, 0.2), CFrame = CFrame.new(x, 4.5, z), Color = Color3.new(1, 1, 1) }, parent)
	deco({ Name = "FlagCloth", Size = Vector3.new(1.4, 0.9, 0.1), CFrame = CFrame.new(x + 0.7, 5.5, z), Color = Color3.fromRGB(255, 80, 80) }, parent)
end

local function lifeguard(parent, x, z)
	local wood = Color3.fromRGB(230, 230, 235)
	for _, o in ipairs({ Vector3.new(-2, 0, -2), Vector3.new(2, 0, -2), Vector3.new(-2, 0, 2), Vector3.new(2, 0, 2) }) do
		deco({ Name = "Leg", Size = Vector3.new(0.5, 8, 0.5), CFrame = CFrame.new(x + o.X, 4, z + o.Z), Color = wood, CanCollide = true }, parent)
	end
	deco({ Name = "Hut", Size = Vector3.new(6, 4, 6), CFrame = CFrame.new(x, 10, z), Color = Color3.fromRGB(255, 90, 90) }, parent)
	deco({ Name = "HutRoof", Size = Vector3.new(7, 0.6, 7), CFrame = CFrame.new(x, 12.3, z), Color = Color3.new(1, 1, 1) }, parent)
end

local function beachBall(parent, x, z, rng)
	local b = deco({ Name = "BeachBall", Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3), CFrame = CFrame.new(x, 1.5, z), Color = Color3.new(1, 1, 1) }, parent)
	for k = 0, 2 do
		deco({ Name = "BallStripe", Shape = Enum.PartType.Ball, Size = Vector3.new(3.06, 3.06, 1), CFrame = b.CFrame * CFrame.Angles(0, k * math.pi / 3, 0), Color = pick(rng, { Color3.fromRGB(255, 70, 70), Color3.fromRGB(60, 160, 255), Color3.fromRGB(255, 220, 0) }) }, parent)
	end
end

local function streetLamp(parent, x, z, color)
	deco({ Name = "LampPole", Size = Vector3.new(0.7, 14, 0.7), CFrame = CFrame.new(x, 7, z), Color = Color3.fromRGB(40, 40, 50), CanCollide = true }, parent)
	local arm = x > 0 and -1 or 1
	deco({ Name = "LampArm", Size = Vector3.new(4, 0.5, 0.5), CFrame = CFrame.new(x + arm * 2, 14, z), Color = Color3.fromRGB(40, 40, 50) }, parent)
	local bulb = deco({ Name = "Lamp", Size = Vector3.new(2, 0.6, 1.2), CFrame = CFrame.new(x + arm * 3.6, 13.6, z), Color = color, Material = Enum.Material.Neon }, parent)
	local pl = Instance.new("PointLight")
	pl.Color = color
	pl.Range = 18
	pl.Brightness = 1.2
	pl.Parent = bulb
end

local function neonSign(parent, x, z, text, color)
	local board = deco({ Name = "NeonSign", Size = Vector3.new(24, 9, 1), CFrame = CFrame.new(x, 30, z) * CFrame.Angles(0, x > 0 and -math.rad(90) or math.rad(90), 0), Color = Color3.fromRGB(20, 15, 35) }, parent)
	deco({ Name = "NeonFrame", Size = Vector3.new(24.6, 9.6, 0.6), CFrame = board.CFrame * CFrame.new(0, 0, 0.4), Color = color, Material = Enum.Material.Neon }, parent)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.CanvasSize = Vector2.new(480, 180)
	sg.LightInfluence = 0
	sg.Parent = board
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = color
	t.Parent = sg
end

local function pineTree(parent, x, z, rng)
	if asset("PineTree", CFrame.new(x, 0, z), parent, true) then
		return
	end
	local h = rng:NextNumber(14, 22)
	deco({ Name = "PineTrunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 1.4, 1.4), CFrame = CFrame.new(x, 2, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(110, 75, 50), CanCollide = true }, parent)
	for k = 0, 3 do
		local r = (4 - k) * 3
		local y = 4 + k * (h - 4) / 4
		deco({ Name = "PineLayer", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h / 5, r, r), CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(50, 120, 90) }, parent)
		deco({ Name = "Snow", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, r * 0.85, r * 0.85), CFrame = CFrame.new(x, y + h / 10 + 0.1, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.new(1, 1, 1) }, parent)
	end
end

local function igloo(parent, x, z)
	deco({ Name = "Igloo", Shape = Enum.PartType.Ball, Size = Vector3.new(14, 14, 14), CFrame = CFrame.new(x, 0, z), Color = Color3.fromRGB(240, 250, 255), CanCollide = true }, parent)
	deco({ Name = "IglooDoor", Shape = Enum.PartType.Ball, Size = Vector3.new(5, 5, 5), CFrame = CFrame.new(x + (x > 0 and -6 or 6), 0.5, z), Color = Color3.fromRGB(60, 80, 110) }, parent)
end

local function deadTree(parent, x, z, rng)
	local c = Color3.fromRGB(45, 35, 35)
	deco({ Name = "DeadTrunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(12, 1.4, 1.4), CFrame = CFrame.new(x, 6, z) * CFrame.Angles(0, 0, math.rad(90)), Color = c, CanCollide = true }, parent)
	for k = 1, 4 do
		local ang = rng:NextNumber(0, math.pi * 2)
		deco({ Name = "DeadBranch", Shape = Enum.PartType.Cylinder, Size = Vector3.new(5, 0.6, 0.6), CFrame = CFrame.new(x, 6 + k * 1.4, z) * CFrame.Angles(0, ang, math.rad(35)) * CFrame.new(2.2, 0, 0), Color = c }, parent)
	end
end

local function beacon(parent, x, z, color)
	deco({ Name = "BeaconBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 5, 5), CFrame = CFrame.new(x, 0.5, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(200, 200, 220), CanCollide = true }, parent)
	deco({ Name = "BeaconPole", Size = Vector3.new(0.6, 10, 0.6), CFrame = CFrame.new(x, 6, z), Color = Color3.fromRGB(200, 200, 220) }, parent)
	deco({ Name = "BeaconLight", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(x, 11.5, z), Color = color, Material = Enum.Material.Neon }, parent)
end

local function ringPortal(parent, z, color)
	local n = 24
	local radius = 40
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		deco({ Name = "Ring", Size = Vector3.new(3, 11, 3), CFrame = CFrame.new(math.cos(a) * radius, 30 + math.sin(a) * radius, z) * CFrame.Angles(0, 0, a), Color = color, Material = Enum.Material.Neon }, parent)
	end
end

local function rockArch(parent, z, color)
	for _, sx in ipairs({ -1, 1 }) do
		deco({ Name = "ArchRock", Size = Vector3.new(10, 34, 10), CFrame = CFrame.new(sx * 30, 17, z) * CFrame.Angles(0, 0, sx * 0.1), Color = color, Material = Enum.Material.Slate, CanCollide = true }, parent)
	end
	deco({ Name = "ArchTopRock", Size = Vector3.new(72, 8, 11), CFrame = CFrame.new(0, 35, z), Color = color, Material = Enum.Material.Slate }, parent)
end

local function lavaFall(parent, x, z, top)
	deco({ Name = "LavaFall", Size = Vector3.new(1.2, top, 8), CFrame = CFrame.new(x, top / 2, z), Color = Color3.fromRGB(255, 110, 0), Material = Enum.Material.Neon, CastShadow = false }, parent)
end

-- ---------- скалы-террасы (возвращают места на верхушках для декора) ----------
local function terraces(parent, i, zone, rng)
	local z0 = zoneStartZ(i)
	local edge = W / 2
	local step = 35
	local spots = {}
	local z = z0
	while z > z0 - L + 1 do
		for _, side in ipairs({ -1, 1 }) do
			local h1 = rng:NextNumber(6, 12)
			local h2 = h1 + rng:NextNumber(10, 22)
			local cz = z - step / 2
			deco({ Name = "Cliff", Size = Vector3.new(28, h1, step), CFrame = CFrame.new(side * (edge + 14), h1 / 2, cz), Color = zone.cliff, CanCollide = true }, parent)
			deco({ Name = "CliffTop", Size = Vector3.new(28.6, 1.5, step - 0.3), CFrame = CFrame.new(side * (edge + 14), h1 + 0.3, cz), Color = zone.cliff2 }, parent)
			deco({ Name = "Cliff", Size = Vector3.new(34, h2, step), CFrame = CFrame.new(side * (edge + 45), h2 / 2, cz), Color = zone.cliff:Lerp(Color3.new(0, 0, 0), 0.08), CanCollide = true }, parent)
			deco({ Name = "CliffTop", Size = Vector3.new(34.6, 1.5, step - 0.3), CFrame = CFrame.new(side * (edge + 45), h2 + 0.3, cz), Color = zone.cliff2 }, parent)
			table.insert(spots, { x = side * (edge + 14), y = h1 + 1.05, z = cz, side = side, low = true })
			table.insert(spots, { x = side * (edge + 45), y = h2 + 1.05, z = cz, side = side, low = false })
		end
		z -= step
	end
	return spots
end

local function floorLayers(parent, i, zone)
	local z0 = zoneStartZ(i)
	local edge = W / 2
	local tile = 10
	for k = 0, math.floor(L / tile) - 1 do
		for _, side in ipairs({ -1, 1 }) do
			for col = 0, 1 do
				local dark = (k + col) % 2 == 0
				deco({ Name = "Tile", Size = Vector3.new(tile, LAYER, tile), CFrame = CFrame.new(side * (edge - tile / 2 - col * tile), Y_TILE, z0 - k * tile - tile / 2), Color = dark and zone.accent or zone.floor2, CastShadow = false }, parent)
			end
		end
	end
	for k = 1, 13 do
		deco({ Name = "Stripe", Size = Vector3.new(W - 42, LAYER, 6), CFrame = CFrame.new(0, Y_STRIPE, z0 - k * (L / 14)), Color = zone.floor2, CastShadow = false }, parent)
	end
	-- дорога со стрелками
	deco({ Name = "Road", Size = Vector3.new(30, LAYER, L - 0.2), CFrame = CFrame.new(0, Y_ROAD, z0 - L / 2), Color = zone.floor:Lerp(Color3.new(0, 0, 0), 0.45), CastShadow = false }, parent)
	for _, side in ipairs({ -1, 1 }) do
		deco({ Name = "RoadLine", Size = Vector3.new(1, LAYER, L - 0.2), CFrame = CFrame.new(side * 15.5, Y_ROAD, z0 - L / 2), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, CastShadow = false }, parent)
	end
	for k = 1, math.floor(L / 30) - 1 do
		for _, side in ipairs({ -1, 1 }) do
			deco({ Name = "RoadArrow", Size = Vector3.new(1.4, LAYER, 7), CFrame = CFrame.new(side * 2.5, Y_MARK, z0 - k * 30) * CFrame.Angles(0, side * math.rad(35), 0), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, CastShadow = false }, parent)
		end
	end
end

-- мелочи на земле между препятствиями
local function scatter(parent, i, zone, rng)
	local z0 = zoneStartZ(i)
	local theme = zone.theme
	for _ = 1, 26 do
		local x = rng:NextNumber(-70, 70)
		if math.abs(x) > 18 then
			local z = z0 - rng:NextNumber(20, L - 20)
			if theme == "sakura" then
				deco({ Name = "Petals", Shape = Enum.PartType.Cylinder, Size = Vector3.new(LAYER, rng:NextNumber(2, 4), rng:NextNumber(2, 4)), CFrame = CFrame.new(x, Y_MARK, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 190, 215), CastShadow = false }, parent)
			elseif theme == "candy" then
				deco({ Name = "Sprinkle", Size = Vector3.new(0.6, LAYER, 2.2), CFrame = CFrame.new(x, Y_MARK, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = pick(rng, { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 220, 0), Color3.fromRGB(0, 200, 255), Color3.fromRGB(255, 60, 120) }), Material = Enum.Material.Neon, CastShadow = false }, parent)
			elseif theme == "beach" then
				deco({ Name = "Shell", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 0.6, 1.2), CFrame = CFrame.new(x, 0.3, z), Color = pick(rng, { Color3.fromRGB(255, 200, 200), Color3.fromRGB(255, 240, 220) }) }, parent)
			elseif theme == "city" then
				deco({ Name = "Cone", Size = Vector3.new(1, 2, 1), CFrame = CFrame.new(x, 1, z), Color = Color3.fromRGB(255, 120, 0), CanCollide = false }, parent)
			elseif theme == "ice" then
				deco({ Name = "SnowPile", Shape = Enum.PartType.Ball, Size = Vector3.new(4, 1.6, 4), CFrame = CFrame.new(x, 0.3, z), Color = Color3.new(1, 1, 1), CastShadow = false }, parent)
			elseif theme == "volcano" then
				deco({ Name = "Ember", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 0.5, 1), CFrame = CFrame.new(x, 0.25, z), Color = Color3.fromRGB(255, 120, 0), Material = Enum.Material.Neon, CastShadow = false }, parent)
			elseif theme == "space" then
				deco({ Name = "Glow", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), CFrame = CFrame.new(x, 0.8, z), Color = pick(rng, { Color3.fromRGB(150, 255, 255), Color3.fromRGB(255, 150, 255) }), Material = Enum.Material.Neon, CastShadow = false }, parent)
			end
		end
	end
end

local SAKURA_LEAVES = { Color3.fromRGB(255, 170, 205), Color3.fromRGB(255, 200, 225), Color3.fromRGB(250, 140, 190) }
local SAKURA_TRUNK = Color3.fromRGB(150, 80, 60)

local function decorate(folder, i, zone, rng)
	local z0 = zoneStartZ(i)
	local edge = W / 2
	local theme = zone.theme

	local spots = terraces(folder, i, zone, rng)
	floorLayers(folder, i, zone)
	scatter(folder, i, zone, rng)

	if theme ~= "space" and theme ~= "city" and theme ~= "volcano" then
		for _ = 1, 8 do
			cloud(folder, Vector3.new(rng:NextNumber(-200, 200), rng:NextNumber(70, 110), z0 - rng:NextNumber(0, L)), rng)
		end
	end

	-- верхушки скал
	for _, sp in ipairs(spots) do
		local x, z, y = sp.x + rng:NextNumber(-6, 6), sp.z + rng:NextNumber(-8, 8), sp.y
		if theme == "sakura" then
			at(folder, y, blockTree, x, z, rng, SAKURA_LEAVES, SAKURA_TRUNK, rng:NextNumber() < 0.25)
			if sp.low then
				at(folder, y, bush, sp.x + 8 * -sp.side, sp.z + 10, rng, Color3.fromRGB(110, 190, 100))
			end
		elseif theme == "candy" then
			if sp.low then
				at(folder, y, cupcake, x, z, rng)
			else
				at(folder, y, rng:NextNumber() < 0.5 and lollipop or iceCream, x, z, rng)
			end
		elseif theme == "beach" then
			at(folder, y, palm, x, z, rng)
		elseif theme == "city" then
			if not sp.low then
				at(folder, y, building, sp.x, sp.z, rng, zone.accent)
			end
		elseif theme == "ice" then
			at(folder, y, pineTree, x, z, rng)
		elseif theme == "volcano" then
			at(folder, y, deadTree, x, z, rng)
		elseif theme == "space" then
			at(folder, y, crystal, x, z, rng)
		end
	end

	-- кромка трассы
	for k = 1, 12 do
		local z = z0 - k * (L / 13)
		for _, side in ipairs({ -1, 1 }) do
			local x = side * (edge - rng:NextNumber(6, 9))
			local alt = (k + (side > 0 and 1 or 0)) % 2 == 0
			if theme == "sakura" then
				if alt then
					lantern(folder, x, z)
				else
					flowerPatch(folder, x, z, rng, { Color3.fromRGB(255, 160, 200), Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 220, 120) })
				end
			elseif theme == "candy" then
				if alt then
					candyCane(folder, x, z)
				else
					gumdrop(folder, x, z, rng)
				end
			elseif theme == "beach" then
				if k % 3 == 0 then
					sandcastle(folder, x, z)
				elseif alt then
					surfboard(folder, x, z, rng)
				else
					umbrella(folder, x, z, rng)
					beachBall(folder, x + side * -4, z + 3, rng)
				end
			elseif theme == "city" then
				streetLamp(folder, x, z, alt and zone.accent or Color3.fromRGB(0, 230, 255))
			elseif theme == "ice" then
				if alt then
					snowman(folder, x, z)
				else
					crystal(folder, x, z, rng)
				end
			elseif theme == "volcano" then
				rock(folder, x, z, rng, Color3.fromRGB(70, 50, 45))
			elseif theme == "space" then
				beacon(folder, x, z, alt and zone.accent or Color3.fromRGB(120, 255, 255))
			end
		end
	end

	-- арки над дорогой и особые штуки
	if theme == "sakura" then
		torii(folder, z0 - L * 0.2)
		torii(folder, z0 - L * 0.8)
		for k = 1, 3 do
			for _, side in ipairs({ -1, 1 }) do
				waterfall(folder, side * (edge + 1), z0 - k * (L / 4) + side * 20, 26, side)
			end
		end
	elseif theme == "candy" then
		donutArch(folder, z0 - L * 0.25, rng)
		donutArch(folder, z0 - L * 0.8, rng)
		for k = 1, 2 do
			for _, side in ipairs({ -1, 1 }) do
				waterfall(folder, side * (edge + 1), z0 - k * (L / 3) + side * 15, 26, side)
			end
		end
	elseif theme == "beach" then
		deco({ Name = "Sea", Size = Vector3.new(500, 1, L), CFrame = CFrame.new(-(edge + 300), 2, z0 - L / 2), Color = Color3.fromRGB(0, 190, 230), Material = Enum.Material.Glass, Transparency = 0.15 }, folder)
		lifeguard(folder, edge - 22, z0 - L * 0.35)
		lifeguard(folder, -edge + 22, z0 - L * 0.75)
	elseif theme == "city" then
		for k = 1, 3 do
			neonArch(folder, z0 - k * (L / 4), ({ zone.accent, Color3.fromRGB(0, 230, 255), Color3.fromRGB(255, 220, 0) })[k])
		end
		neonSign(folder, -edge - 2, z0 - L * 0.3, "SKATE ♡", zone.accent)
		neonSign(folder, edge + 2, z0 - L * 0.6, "RUSH", Color3.fromRGB(0, 230, 255))
	elseif theme == "ice" then
		igloo(folder, -edge + 20, z0 - L * 0.3)
		igloo(folder, edge - 20, z0 - L * 0.7)
		for _ = 1, 6 do
			cloud(folder, Vector3.new(rng:NextNumber(-150, 150), rng:NextNumber(60, 90), z0 - rng:NextNumber(0, L)), rng)
		end
	elseif theme == "volcano" then
		local vz = z0 - L / 2
		for k = 0, 5 do
			local r = 170 - k * 26
			deco({ Name = "Volcano", Shape = Enum.PartType.Cylinder, Size = Vector3.new(22, r, r), CFrame = CFrame.new(edge + 190, 11 + k * 22, vz) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(80 - k * 6, 50, 45), Material = Enum.Material.Basalt }, folder)
		end
		deco({ Name = "Crater", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 34, 34), CFrame = CFrame.new(edge + 190, 143, vz) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 90, 0), Material = Enum.Material.Neon }, folder)
		for _ = 1, 7 do
			lavaPool(folder, rng:NextNumber(-edge + 25, edge - 25), z0 - rng:NextNumber(50, L - 40), rng)
		end
		for k = 1, 4 do
			for _, side in ipairs({ -1, 1 }) do
				lavaFall(folder, side * (edge + 0.5), z0 - k * (L / 5) + side * 12, 24)
			end
		end
		rockArch(folder, z0 - L * 0.3, Color3.fromRGB(70, 50, 45))
		rockArch(folder, z0 - L * 0.8, Color3.fromRGB(70, 50, 45))
	elseif theme == "space" then
		planet(folder, Vector3.new(-280, 130, z0 - 120), 130, Color3.fromRGB(255, 130, 90), Color3.fromRGB(255, 220, 160))
		planet(folder, Vector3.new(320, 210, z0 - 300), 210, Color3.fromRGB(90, 150, 255), nil)
		planet(folder, Vector3.new(-220, 270, z0 - 380), 70, Color3.fromRGB(200, 255, 200), Color3.fromRGB(150, 255, 255))
		ringPortal(folder, z0 - L * 0.25, zone.accent)
		ringPortal(folder, z0 - L * 0.8, Color3.fromRGB(120, 255, 255))
		for _ = 1, 6 do
			local px, pz, py = rng:NextNumber(-edge + 25, edge - 25), z0 - rng:NextNumber(60, L - 60), rng:NextNumber(14, 26)
			part({ Name = "FloatPad", Size = Vector3.new(14, 1, 14), CFrame = CFrame.new(px, py, pz), Color = zone.accent, Material = Enum.Material.Neon }, folder)
			star(folder, Vector3.new(px, py + 4, pz), Config.Star.Value * 3)
		end
	end
end

-- ---------- зона ----------

local function buildZone(i)
	local zone = Config.Zones[i]
	local folder = Instance.new("Folder")
	folder.Name = string.format("Zone%d_%s", i, zone.name)
	folder.Parent = root

	local rng = Random.new(i * 7919)
	local z0 = zoneStartZ(i)
	local edge = W / 2

	part({ Name = "Floor", Size = Vector3.new(W, 4, L), CFrame = CFrame.new(0, -2, z0 - L / 2), Color = zone.floor }, folder)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Border", Size = Vector3.new(2, 80, L), CFrame = CFrame.new(side * (edge + 1), 40, z0 - L / 2), Transparency = 1, CanQuery = false }, folder)
	end

	if i > 1 then
		local gate = part({ Name = "Gate", Size = Vector3.new(W, 50, 2), CFrame = CFrame.new(0, 25, z0), Color = zone.accent, Material = Enum.Material.ForceField, Transparency = 0.2 }, folder)
		gate:SetAttribute("ZoneIndex", i)
		CollectionService:AddTag(gate, "Gate")
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
			local sg = Instance.new("SurfaceGui")
			sg.Face = face
			sg.CanvasSize = Vector2.new(1700, 500)
			sg.LightInfluence = 0
			sg.Parent = gate
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 0.6)
			t.Position = UDim2.fromScale(0, 0.2)
			t.BackgroundTransparency = 1
			t.TextScaled = true
			t.Font = Enum.Font.GothamBlack
			t.TextColor3 = Color3.new(1, 1, 1)
			t.TextStrokeTransparency = 0
			t.Text = string.format("🔒 %s\nУровень %d  •  %s 💰  •  монеты x%s", zone.name, zone.level, Config.formatNumber(zone.cost), tostring(zone.mult))
			t.Parent = sg
		end
	end

	local sign = deco({ Name = "ZoneSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(0, 40, z0 - 8), Transparency = 1 }, folder)
	billboard(sign, zone.name, Vector2.new(60, 10), 0, zone.accent:Lerp(Color3.new(1, 1, 1), 0.4))

	local lanes = { -48, 0, 48 }
	local z = z0 - 40
	local megaDone = false
	while z > z0 - L + 40 do
		if not megaDone and (z0 - z) >= L * 0.55 then
			z = megaRamp(folder, 0, z, zone) - 30
			megaDone = true
			for k = 1, 5 do
				star(folder, Vector3.new(0, 26 + k * 2, z + 10 - k * 9), Config.Star.Value * 2)
			end
		else
			for _, x in ipairs(lanes) do
				local roll = rng:NextNumber()
				local jitter = rng:NextNumber(-6, 6)
				if roll < 0.3 then
					kicker(folder, x + jitter, z, 12, rng:NextNumber(72, 92), zone.accent)
					star(folder, Vector3.new(x + jitter, rng:NextNumber(12, 18), z - 16), Config.Star.Value)
				elseif roll < 0.52 then
					rail(folder, x + jitter, z, rng:NextInteger(26, 44), zone.accent)
				elseif roll < 0.66 then
					funbox(folder, x + jitter, z, zone.floor2:Lerp(zone.accent, 0.25), zone.accent)
				elseif roll < 0.8 then
					boostPad(folder, x + jitter, z, zone.accent)
					star(folder, Vector3.new(x + jitter, 3, z - 14), Config.Star.Value)
				elseif roll < 0.92 then
					star(folder, Vector3.new(x + jitter, 3, z), Config.Star.Value)
					star(folder, Vector3.new(x + jitter, 3, z - 8), Config.Star.Value)
				end
			end
			z -= rng:NextNumber(48, 62)
		end
	end

	decorate(folder, i, zone, rng)

	-- гирлянды флажков над трассой
	local flagColors = { zone.accent, zone.floor2, Color3.new(1, 1, 1), zone.cliff2 }
	for k = 1, 5 do
		garland(folder, z0 - k * (L / 6) + 12, flagColors)
	end

	if i == #Config.Zones then
		part({ Name = "EndWall", Size = Vector3.new(W, 60, 2), CFrame = CFrame.new(0, 30, z0 - L), Color = zone.accent, Material = Enum.Material.ForceField, Transparency = 0.3 }, folder)
	end
end

-- ============================================================
--  ЛОББИ: магазин досок, беговые дорожки, обби
-- ============================================================

local PINK = Color3.fromRGB(232, 178, 196) -- приглушённый розовый
local PINK2 = Color3.fromRGB(245, 215, 225)
local GOLD = Color3.fromRGB(228, 192, 120)
local WHITE = Color3.fromRGB(252, 248, 250)

local function surfaceText(partObj, face, text, color, canvas)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.CanvasSize = canvas or Vector2.new(800, 160)
	sg.LightInfluence = 0
	sg.Parent = partObj
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = color
	t.Parent = sg
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Color = Color3.fromRGB(60, 30, 50)
	st.Parent = t
	return t
end

local function heart(parent, cf, size, color, collide)
	local r = size * 0.55
	deco({ Name = "HeartL", Shape = Enum.PartType.Ball, Size = Vector3.new(r, r, r * 0.5), CFrame = cf * CFrame.new(-size * 0.22, size * 0.15, 0), Color = color, CanCollide = collide }, parent)
	deco({ Name = "HeartR", Shape = Enum.PartType.Ball, Size = Vector3.new(r, r, r * 0.5), CFrame = cf * CFrame.new(size * 0.22, size * 0.15, 0), Color = color, CanCollide = collide }, parent)
	deco({ Name = "HeartTip", Size = Vector3.new(size * 0.46, size * 0.46, r * 0.45), CFrame = cf * CFrame.new(0, -size * 0.08, 0) * CFrame.Angles(0, 0, math.rad(45)), Color = color, CanCollide = collide }, parent)
end

local function bow(parent, cf, size, color)
	for _, sx in ipairs({ -1, 1 }) do
		deco({ Name = "BowWing", Size = Vector3.new(size * 0.5, size * 0.42, size * 0.15), CFrame = cf * CFrame.new(sx * size * 0.28, 0, 0) * CFrame.Angles(0, 0, sx * math.rad(15)), Color = color }, parent)
	end
	deco({ Name = "BowKnot", Shape = Enum.PartType.Ball, Size = Vector3.new(size * 0.24, size * 0.24, size * 0.24), CFrame = cf, Color = GOLD }, parent)
end

local function sparkles(partObj, color)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.6
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.5), NumberSequenceKeypoint.new(1, 0) })
	e.Lifetime = NumberRange.new(1, 2)
	e.Rate = 4
	e.Speed = NumberRange.new(0.5, 1.5)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Parent = partObj
end

-- ---------- магазин досок ----------
local function buildShop(folder)
	local x0, x1 = -84, -40 -- от задней стены до витрины
	local z0, z1 = 18, 132
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	local depth, length = x1 - x0, z1 - z0
	local H = 22
	local wall = Color3.fromRGB(250, 236, 242)

	part({ Name = "ShopFloor", Size = Vector3.new(depth, 0.6, length), CFrame = CFrame.new(cx, 0.3, cz), Color = Color3.fromRGB(205, 180, 160), Material = Enum.Material.WoodPlanks }, folder)
	part({ Name = "ShopBack", Size = Vector3.new(1, H, length), CFrame = CFrame.new(x0, H / 2, cz), Color = wall }, folder)
	for _, z in ipairs({ z0, z1 }) do
		part({ Name = "ShopSide", Size = Vector3.new(depth, H, 1), CFrame = CFrame.new(cx, H / 2, z), Color = wall }, folder)
	end
	part({ Name = "ShopRoof", Size = Vector3.new(depth + 2, 1, length + 2), CFrame = CFrame.new(cx, H + 0.5, cz), Color = PINK }, folder)
	-- фасад над входом и вывеска
	local facade = part({ Name = "ShopFacade", Size = Vector3.new(1.4, 6, length + 2), CFrame = CFrame.new(x1, H - 2, cz), Color = WHITE }, folder)
	surfaceText(facade, Enum.NormalId.Right, "♡ SKATE SHOP ♡", Color3.fromRGB(235, 120, 165), Vector2.new(1600, 90))
	-- полосатый навес
	local n = 14
	for k = 0, n - 1 do
		local z = z0 + (k + 0.5) * length / n
		deco({ Name = "Awning", Size = Vector3.new(7, 0.4, length / n), CFrame = CFrame.new(x1 + 3.2, H - 6, z) * CFrame.Angles(0, 0, math.rad(-22)), Color = k % 2 == 0 and PINK or WHITE }, folder)
		deco({ Name = "AwningScallop", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, length / n, length / n), CFrame = CFrame.new(x1 + 6.4, H - 7.4, z) * CFrame.Angles(0, math.rad(90), 0), Color = k % 2 == 0 and PINK or WHITE }, folder)
	end
	-- колонны витрины
	for k = 0, 4 do
		local z = z0 + k * length / 4
		part({ Name = "ShopColumn", Shape = Enum.PartType.Cylinder, Size = Vector3.new(H - 5, 2, 2), CFrame = CFrame.new(x1, (H - 5) / 2, z) * CFrame.Angles(0, 0, math.rad(90)), Color = GOLD }, folder)
	end
	-- постеры с досками на задней стене
	for k = 0, 5 do
		local z = z0 + 10 + k * (length - 20) / 5
		deco({ Name = "PosterFrame", Size = Vector3.new(0.4, 9, 6), CFrame = CFrame.new(x0 + 0.8, 12, z), Color = GOLD }, folder)
		deco({ Name = "Poster", Size = Vector3.new(0.5, 8.2, 5.2), CFrame = CFrame.new(x0 + 0.85, 12, z), Color = ({ PINK, Color3.fromRGB(180, 210, 255), Color3.fromRGB(255, 230, 160) })[k % 3 + 1] }, folder)
		heart(folder, CFrame.new(x0 + 1.2, 12.5, z) * CFrame.Angles(0, math.rad(90), 0), 3, WHITE, false)
	end
	-- лампы
	for k = 0, 3 do
		local lamp = deco({ Name = "ShopLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), CFrame = CFrame.new(cx, H - 2, z0 + 15 + k * (length - 30) / 3), Color = Color3.fromRGB(255, 240, 220), Material = Enum.Material.Neon }, folder)
		local pl = Instance.new("PointLight")
		pl.Range = 26
		pl.Brightness = 1.2
		pl.Color = Color3.fromRGB(255, 230, 220)
		pl.Parent = lamp
	end

	-- подставки с досками
	local nB = #Config.Boards
	for idx, b in ipairs(Config.Boards) do
		local z = z0 + 8 + (idx - 1) * ((length - 16) / math.max(1, nB - 1))
		local x = -60
		local base = part({ Name = "BoardStand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 9, 9), CFrame = CFrame.new(x, 1.6, z) * CFrame.Angles(0, 0, math.rad(90)), Color = WHITE }, folder)
		deco({ Name = "StandRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 9.6, 9.6), CFrame = CFrame.new(x, 2.45, z) * CFrame.Angles(0, 0, math.rad(90)), Color = b.trail, Material = Enum.Material.Neon }, folder)
		base:SetAttribute("BoardId", b.id)
		CollectionService:AddTag(base, "BoardStand")
		local model = BoardBuilder.build(b, { anchored = true })
		model.Name = "ShowBoard_" .. b.id
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
			end
		end
		model:ScaleTo(1.4)
		model:PivotTo(CFrame.new(x, 6, z) * CFrame.Angles(0, 0, math.rad(20)))
		model.Parent = folder
		CollectionService:AddTag(model, "ShowDeck")
		local bb, label = billboard(base, b.name, Vector2.new(11, 3.6), 9, Color3.new(1, 1, 1))
		bb.Name = "Info"
		label.Name = "Text"
		local prompt = Instance.new("ProximityPrompt")
		prompt.ObjectText = b.name
		prompt.ActionText = "Купить / надеть"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = base
	end
end

-- ---------- беговые дорожки ----------
local function buildTreadmills(folder)
	local xs = { -31, -19, 20 } -- по бокам от дорожки к старту
	for idx, t in ipairs(Config.Treadmills) do
		local x = xs[idx] or (idx * 13)
		local z = 112
		local body = part({ Name = "TreadmillBody", Size = Vector3.new(8, 1.2, 14), CFrame = CFrame.new(x, 0.6, z), Color = Color3.fromRGB(60, 60, 75) }, folder)
		local belt = part({ Name = "TreadmillBelt", Size = Vector3.new(6.4, 0.2, 13), CFrame = CFrame.new(x, 1.3, z), Color = Color3.fromRGB(35, 35, 45) }, folder)
		-- полоски на ленте (их двигает клиент)
		for k = 0, 5 do
			local stripe = deco({ Name = "BeltStripe", Size = Vector3.new(6.2, 0.06, 0.4), CFrame = CFrame.new(x, 1.43, z - 6 + k * 2.2), Color = t.color, Material = Enum.Material.Neon, CastShadow = false }, folder)
			stripe:SetAttribute("BeltZ", z)
			CollectionService:AddTag(stripe, "BeltStripe")
		end
		-- поручни и пульт спереди
		for _, sx in ipairs({ -1, 1 }) do
			deco({ Name = "Handle", Size = Vector3.new(0.4, 5, 0.4), CFrame = CFrame.new(x + sx * 3.6, 3.7, z - 5.5), Color = Color3.fromRGB(200, 200, 210), CanCollide = true }, folder)
			deco({ Name = "Rail", Size = Vector3.new(0.4, 0.4, 5), CFrame = CFrame.new(x + sx * 3.6, 5, z - 3.2), Color = Color3.fromRGB(200, 200, 210) }, folder)
		end
		local console = deco({ Name = "Console", Size = Vector3.new(7.6, 2.6, 1), CFrame = CFrame.new(x, 6.4, z - 5.8) * CFrame.Angles(math.rad(-20), 0, 0), Color = Color3.fromRGB(45, 45, 60), CanCollide = true }, folder)
		deco({ Name = "Screen", Size = Vector3.new(5, 1.6, 0.2), CFrame = console.CFrame * CFrame.new(0, 0, 0.55), Color = t.color, Material = Enum.Material.Neon }, folder)
		-- невидимая зона: кто стоит на ленте — копит монеты
		local zone = part({ Name = "TreadmillZone", Size = Vector3.new(6.4, 7, 12), CFrame = CFrame.new(x, 4.9, z + 0.5), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false }, folder)
		zone:SetAttribute("Index", idx)
		CollectionService:AddTag(zone, "Treadmill")
		local bb = billboard(console, string.format("%s\n+%d 💰 / 2 сек  •  ур. %d", t.name, t.coins, t.level), Vector2.new(12, 3.2), 3, Color3.new(1, 1, 1))
		bb.Name = "TreadInfo"
		belt.Name = "TreadmillBelt"
		body.Name = "TreadmillBody"
	end
	local sign = deco({ Name = "AfkSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(-27, 13, 104), Transparency = 1 }, folder)
	billboard(sign, "🏃 БЕГОВЫЕ ДОРОЖКИ — стой и копи монеты!", Vector2.new(46, 4), 0, Color3.fromRGB(255, 230, 120))
end

-- ---------- обби в стиле гяру ----------
local function buildObby(folder)
	local obby = Instance.new("Folder")
	obby.Name = "Obby"
	obby.Parent = folder

	local start = Vector3.new(58, 0, 136)
	part({ Name = "ObbyStart", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 16, 16), CFrame = CFrame.new(start + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = PINK2 }, obby)
	deco({ Name = "ObbyStartRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 16.6, 16.6), CFrame = CFrame.new(start + Vector3.new(0, 1.05, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = GOLD }, obby)
	local startSign = deco({ Name = "ObbySign", Size = Vector3.new(16, 6, 1), CFrame = CFrame.new(start + Vector3.new(0, 10, 7)) * CFrame.Angles(0, math.rad(180), 0), Color = PINK }, obby)
	surfaceText(startSign, Enum.NormalId.Front, "♡ ОББИ ♡\nпройди — получи 💰", WHITE, Vector2.new(400, 150))
	bow(obby, CFrame.new(start + Vector3.new(0, 14, 7.6)), 5, WHITE)

	-- путь: гигантские доски и площадки-сердечки, всё выше и выше
	local pos = start
	local platforms = 13
	local finishPos
	for k = 1, platforms do
		local zig = (k % 2 == 0) and 1 or -1
		pos = Vector3.new(60 + zig * (4 + (k % 3) * 2), 2.4 * k, start.Z - 9.5 * k)
		if k % 3 == 1 then
			-- гигантский скейт
			local cfgBoard = { deck = (k % 2 == 0) and PINK or WHITE, stripe = GOLD, wheel = PINK2, trail = PINK }
			local m = BoardBuilder.build(cfgBoard, { anchored = true })
			m:ScaleTo(3)
			m:PivotTo(CFrame.new(pos) * CFrame.Angles(0, math.rad(90), 0))
			m.Name = "ObbyBoard"
			m.Parent = obby
		elseif k % 3 == 2 then
			-- сердечко-площадка
			part({ Name = "HeartPad", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 8, 8), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Color = PINK }, obby)
			heart(obby, CFrame.new(pos + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, math.rad(90), 0), 3, WHITE, false)
		else
			-- маленький кубик с бантиком (прыжок посложнее)
			part({ Name = "BowBlock", Size = Vector3.new(4.5, 1, 4.5), CFrame = CFrame.new(pos), Color = PINK2 }, obby)
			bow(obby, CFrame.new(pos + Vector3.new(0, 1.6, 0)), 2.2, PINK)
		end
		-- блёстки над каждой ступенью
		local glitter = deco({ Name = "Glitter", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(pos + Vector3.new(0, 4, 0)), Transparency = 1 }, obby)
		sparkles(glitter, k % 2 == 0 and GOLD or WHITE)
		finishPos = pos
	end
	-- финиш
	local fz = finishPos.Z - 12
	local fy = finishPos.Y + 1
	local finish = part({ Name = "ObbyFinish", Size = Vector3.new(14, 1, 14), CFrame = CFrame.new(60, fy, fz), Color = GOLD, Material = Enum.Material.Neon }, obby)
	CollectionService:AddTag(finish, "ObbyFinish")
	heart(obby, CFrame.new(60, fy + 9, fz - 6), 10, PINK, false)
	billboard(finish, "🏆 ФИНИШ! +" .. Config.Obby.Reward .. " 💰", Vector2.new(18, 4), 15, GOLD)
	-- опоры-столбики под ступенями (чтобы обби не висело в воздухе)
	for k = 0, 3 do
		deco({ Name = "ObbyPillar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(fy, 2, 2), CFrame = CFrame.new(78, fy / 2, start.Z - 15 - k * 32) * CFrame.Angles(0, 0, math.rad(90)), Color = WHITE, CanCollide = true }, obby)
		heart(obby, CFrame.new(78, fy + 2, start.Z - 15 - k * 32) * CFrame.Angles(0, math.rad(90), 0), 4, PINK, false)
	end
end

local function buildLobby()
	local folder = Instance.new("Folder")
	folder.Name = "Lobby"
	folder.Parent = root
	local rng = Random.new(42)
	local zone = Config.Zones[1]

	part({ Name = "LobbyFloor", Size = Vector3.new(W, 4, LOBBY), CFrame = CFrame.new(0, -2, LOBBY / 2), Color = Color3.fromRGB(176, 166, 214) }, folder)
	-- дорожка от спавна к старту
	deco({ Name = "LobbyPath", Size = Vector3.new(26, LAYER, LOBBY - 10), CFrame = CFrame.new(0, Y_STRIPE, LOBBY / 2 - 5), Color = Color3.fromRGB(235, 200, 220), CastShadow = false }, folder)
	for k = 1, 6 do
		for _, side in ipairs({ -1, 1 }) do
			deco({ Name = "PathArrow", Size = Vector3.new(1.4, LAYER, 6), CFrame = CFrame.new(side * 2.4, Y_TILE, 95 - k * 14) * CFrame.Angles(0, side * math.rad(35), 0), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, CastShadow = false }, folder)
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Border", Size = Vector3.new(2, 80, LOBBY), CFrame = CFrame.new(side * (W / 2 + 1), 40, LOBBY / 2), Transparency = 1, CanQuery = false }, folder)
	end
	part({ Name = "BackWall", Size = Vector3.new(W, 80, 2), CFrame = CFrame.new(0, 40, LOBBY + 1), Transparency = 1 }, folder)
	for _, x in ipairs({ -30, 30 }) do
		blockTree(folder, x, 140, rng, SAKURA_LEAVES, SAKURA_TRUNK, true)
		blockTree(folder, x, 30, rng, SAKURA_LEAVES, SAKURA_TRUNK, false)
		lantern(folder, x * 0.6, 60)
	end
	for k = 1, 6 do
		cloud(folder, Vector3.new(rng:NextNumber(-150, 150), rng:NextNumber(70, 100), rng:NextNumber(0, LOBBY)), rng)
	end

	-- арка «СТАРТ»
	for _, side in ipairs({ -1, 1 }) do
		deco({ Name = "StartPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(36, 5, 5), CFrame = CFrame.new(side * 30, 18, 4) * CFrame.Angles(0, 0, math.rad(90)), Color = zone.accent, CanCollide = true }, folder)
	end
	local top = deco({ Name = "StartTop", Size = Vector3.new(66, 8, 5), CFrame = CFrame.new(0, 38, 4), Color = WHITE }, folder)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		surfaceText(top, face, "СТАРТ ▶ SKATE RUSH", zone.accent, Vector2.new(660, 80))
	end
	heart(folder, CFrame.new(0, 45, 4), 7, PINK, false)

	buildShop(folder)
	buildTreadmills(folder)
	buildObby(folder)

	-- спавн: невидимая точка позади беговых дорожек
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SkateSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(12, 1, 6)
	spawn.CFrame = CFrame.new(0, 0.5, 132)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.CanQuery = false
	spawn.Parent = folder
	for _, d in ipairs(spawn:GetChildren()) do
		if d:IsA("Decal") then
			d:Destroy()
		end
	end
end

-- ---------- свет ----------

local function setupLighting()
	local function ensure(class, name)
		local o = Lighting:FindFirstChild(name)
		if not o then
			o = Instance.new(class)
			o.Name = name
			o.Parent = Lighting
		end
		return o
	end
	local atm = ensure("Atmosphere", "SkateAtmosphere")
	atm.Density = 0.12
	atm.Offset = 0.1
	atm.Color = Color3.fromRGB(230, 225, 245)
	atm.Decay = Color3.fromRGB(150, 140, 200)
	atm.Glare = 0
	atm.Haze = 0.4
	local bloom = ensure("BloomEffect", "SkateBloom")
	bloom.Intensity = 0.2
	bloom.Size = 20
	bloom.Threshold = 2.6
	local cc = ensure("ColorCorrectionEffect", "SkateColor")
	cc.Saturation = 0.2
	cc.Contrast = 0.12
	cc.Brightness = -0.02
	local rays = Lighting:FindFirstChild("SkateSunRays")
	if rays then
		rays:Destroy()
	end
	Lighting.GlobalShadows = true
	Lighting.ExposureCompensation = -0.35
	Lighting.Brightness = 2
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.5
end

function World.build()
	setupLighting()
	local existing = workspace:FindFirstChild("SkateWorld")
	if existing then
		return existing
	end
	root = Instance.new("Folder")
	root.Name = "SkateWorld"
	root.Parent = workspace

	buildLobby()
	for i = 1, #Config.Zones do
		buildZone(i)
	end
	return root
end

function World.lobbySpawn()
	return CFrame.new(0, 4, 132)
end

return World
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000000E"><Properties><string name="Name">StarterPlayer</string><bool name="CharacterUseJumpPower">true</bool><float name="CharacterJumpPower">60</float><float name="CameraMaxZoomDistance">60</float></Properties><Item class="StarterPlayerScripts" referent="RBX0000000D"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000009"><Properties><string name="Name">SkateClient</string><ProtectedString name="Source"><![CDATA[-- ============================================================
--  SKATE RUSH — управление скейтом (работает у каждого игрока)
--  Разгон, трюки в воздухе, комбо, падения, трамплины, перила.
-- ============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("SkateShared"):WaitForChild("Config"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local UI = require(script:WaitForChild("UI"))
local Rider = require(script:WaitForChild("Rider"))
local Sounds = require(script:WaitForChild("Sounds"))

local TWO_PI = math.pi * 2
print("[SkateRush] Клиент запущен, версия", Config.Version)

local char, hum, root
local state = {
	data = nil,
	combo = {},
	trick = nil,
	queued = nil,
	inAir = false,
	airTime = 0,
	groundTime = 0,
	grinding = false,
	grindTick = 0,
	bailing = false,
	speed = 0,
	lastKick = 0,
	zone = 0,
	gateCooldown = 0,
	boostUntil = 0,
	anim = "ride",
	ollieT = 0,
	usedDouble = false,
	lean = 0,
}

-- ---------- запросы к серверу ----------
local function request(action, ...)
	local ok, msg = remotes.Request:InvokeServer(action, ...)
	if msg then
		UI.toast(msg, ok and "good" or "warn")
	end
	return ok
end

local function buy(kind, key)
	local cfg = kind == "pass" and Config.GamePasses[key] or Config.Products[key]
	if not cfg then
		return
	end
	if cfg.id == 0 then
		request("StudioPurchase", kind, key)
	elseif kind == "pass" then
		MarketplaceService:PromptGamePassPurchase(player, cfg.id)
	else
		MarketplaceService:PromptProductPurchase(player, cfg.id)
	end
end

-- ---------- доска ----------
local function getWeld()
	return root and root:FindFirstChild("BoardWeld")
end

local function boardBase()
	local weld = getWeld()
	local off = weld and weld:GetAttribute("BaseOffset") or 3
	return CFrame.new(0, -off, 0), off
end

local function boardPart(name)
	local model = char and char:FindFirstChild("Skateboard")
	local deck = model and model:FindFirstChild("Deck")
	if not deck then
		return nil
	end
	if name == "Deck" then
		return deck
	end
	return deck:FindFirstChild(name, true)
end

local function yawOnly(cf)
	local look = cf.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 0.01 then
		return CFrame.new()
	end
	return CFrame.lookAt(Vector3.zero, look.Unit)
end

-- ---------- задания ----------
local questBusy = false
local function questEvent(kind)
	local data = state.data
	if not data or questBusy then
		return
	end
	local q = Config.Quests[data.quest or 1]
	if not q or q.kind ~= kind then
		return
	end
	questBusy = true
	task.spawn(function()
		local ok = request("QuestDone", data.quest)
		if ok then
			Sounds.play("LevelUp", 1.1)
		end
		questBusy = false
	end)
end

local function questFromData()
	local data = state.data
	if not data then
		return
	end
	local q = Config.Quests[data.quest or 1]
	if not q then
		return
	end
	local n = 0
	for _ in pairs(data.boards) do
		n += 1
	end
	local done = (q.kind == "speed" and data.speedLevel >= 1)
		or (q.kind == "level4" and data.level >= 4)
		or (q.kind == "zone2" and data.maxZone >= 2)
		or (q.kind == "zone3" and data.maxZone >= 3)
		or (q.kind == "board" and (n >= 2 or data.equipped == "gold"))
	if done then
		questEvent(q.kind)
	end
end

-- ---------- комбо ----------
local function estimate(entries)
	local base, mult = Config.comboScore(entries)
	local cm = state.data and state.data.coinMult or 1
	return math.floor(base * mult * cm), base, mult
end

local function addEntry(name)
	table.insert(state.combo, name)
	state.groundTime = 0
	local coins, base, mult = estimate(state.combo)
	UI.comboUpdate(state.combo, base, mult, coins)
end

local function bank()
	if #state.combo == 0 then
		return
	end
	local entries = state.combo
	state.combo = {}
	remotes.ComboBanked:FireServer(entries)
	UI.comboEnd(true)
end

-- слишком длинное комбо засчитываем сразу (сервер не примет больше MaxEntries)
local function addEntryChecked(name)
	addEntry(name)
	if #state.combo >= Config.Combo.MaxEntries - 2 then
		bank()
	end
end

local function resetTrickVisuals()
	local weld = getWeld()
	if weld then
		weld.C0 = boardBase()
	end
	if hum then
		hum.AutoRotate = true
	end
end

local function bail(reason)
	if state.bailing or not hum or not root then
		return
	end
	state.bailing = true
	local tr = state.trick
	state.trick = nil
	state.queued = nil
	resetTrickVisuals()

	local lost = state.combo
	state.combo = {}
	if #lost > 0 then
		remotes.ComboBailed:FireServer(lost)
	end
	local lostCoins = #lost > 0 and estimate(lost) or 0
	UI.comboEnd(false)
	UI.bail(lostCoins, reason)
	Sounds.play("Bail")

	local yaw = tr and tr.yaw or yawOnly(root.CFrame)
	hum.PlatformStand = true
	root.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-3, 3), math.random(-8, 8))
	state.speed = 0
	local myHum, myRoot = hum, root
	task.delay(1.1, function()
		if myHum.Parent and myRoot.Parent and myHum.Health > 0 then
			myHum.PlatformStand = false
			myRoot.AssemblyAngularVelocity = Vector3.zero
			myRoot.CFrame = CFrame.new(myRoot.Position + Vector3.new(0, 2.5, 0)) * yaw
			myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		state.bailing = false
	end)
end

-- ---------- трюки ----------
local function startTrick(name)
	if state.bailing or not hum or not root or hum.Health <= 0 then
		return
	end
	if state.trick then
		return
	end
	local cfg = Config.Tricks[name]
	if not cfg then
		return
	end
	if not state.inAir then
		-- на земле: прыгаем и делаем трюк сразу после отрыва
		state.queued = { name = name, time = os.clock() }
		hum.Jump = true
		return
	end
	state.trick = { name = name, t = 0, dur = cfg.duration, yaw = yawOnly(root.CFrame) }
	if name == "Spin" or name == "Backflip" then
		hum.AutoRotate = false
	end
	UI.trickPop(cfg.display)
	Sounds.play("Trick", 0.9 + math.random() * 0.3, 0.5)
end

local function completeTrick()
	local tr = state.trick
	state.trick = nil
	resetTrickVisuals()
	if tr.name == "Spin" or tr.name == "Backflip" then
		root.CFrame = CFrame.new(root.Position) * tr.yaw
	end
	addEntryChecked(tr.name)
	questEvent("trick")
end

local function updateTrick(dt)
	local tr = state.trick
	if not tr then
		return
	end
	tr.t += dt
	local p = math.min(tr.t / tr.dur, 1)
	local weld = getWeld()
	local base = boardBase()
	if tr.name == "Kickflip" and weld then
		weld.C0 = base * CFrame.Angles(0, 0, p * TWO_PI)
	elseif tr.name == "Grab" and weld then
		local lift = math.sin(p * math.pi)
		weld.C0 = base * CFrame.new(0, lift * 1.3, 0) * CFrame.Angles(lift * 0.6, 0, lift * 0.4)
	elseif tr.name == "Spin" then
		root.CFrame = CFrame.new(root.Position) * tr.yaw * CFrame.Angles(0, p * TWO_PI, 0)
	elseif tr.name == "Backflip" then
		root.CFrame = CFrame.new(root.Position) * tr.yaw * CFrame.Angles(p * TWO_PI, 0, 0)
		if weld then
			weld.C0 = base * CFrame.Angles(0, p * TWO_PI, 0)
		end
	end
	if p >= 1 then
		completeTrick()
	end
end

local function board()
	return Config.getBoard(state.data and state.data.equipped or "basic")
end

local function playShot(name)
	Rider.play(name)
	state.anim = name
	remotes.AnimState:FireServer(name)
end

local function onLand()
	local tr = state.trick
	if tr then
		if tr.t / tr.dur >= 0.8 then
			completeTrick() -- почти докрутил — засчитываем
		else
			bail("Не докрутил трюк!")
			return
		end
	end
	state.usedDouble = false
	if state.airTime > 0.3 then
		Sounds.play("Land", 1, math.clamp(state.airTime, 0.3, 0.8))
		if not state.bailing and not Rider.busy() then
			playShot("land")
		end
	end
	if state.airTime > 0.5 then
		local deck = boardPart("Deck")
		if deck then
			UI.landBurst(deck.Position)
		end
	end
end

-- ---------- трамплины ----------
local function launch(kick)
	if not root or not hum or state.bailing then
		return
	end
	if os.clock() - state.lastKick < 0.8 then
		return
	end
	state.lastKick = os.clock()
	local power = kick:GetAttribute("Power") or 80
	local v = root.AssemblyLinearVelocity
	local horiz = Vector3.new(v.X, 0, v.Z)
	if horiz.Magnitude < 25 then
		local look = kick.CFrame.LookVector * Vector3.new(1, 0, 1)
		if look.Magnitude > 0.01 then
			horiz = look.Unit * math.max(state.speed, 30)
		end
	end
	hum:ChangeState(Enum.HumanoidStateType.Freefall)
	root.AssemblyLinearVelocity = horiz + Vector3.new(0, power, 0)
	Sounds.play("Jump", 0.8)
	addEntryChecked("Air")
	questEvent("kick")
	if kick:GetAttribute("Mega") then
		questEvent("mega")
		UI.floatText("МЕГА-ПРЫЖОК!", Color3.fromRGB(255, 80, 200))
	end
end

local function hookKicker(kick)
	kick.Touched:Connect(function(hit)
		if char and hit:IsDescendantOf(char) then
			launch(kick)
		end
	end)
end
for _, k in ipairs(CollectionService:GetTagged("Kicker")) do
	hookKicker(k)
end
CollectionService:GetInstanceAddedSignal("Kicker"):Connect(hookKicker)

-- ---------- лава ----------
local function hookLava(lava)
	lava.Touched:Connect(function(hit)
		if char and hit:IsDescendantOf(char) and not state.bailing then
			bail("Горячо! Лава!")
			local zoneIndex = math.max(1, state.zone)
			task.delay(1.2, function()
				if root and root.Parent then
					root.CFrame = CFrame.new(0, 5, -(zoneIndex - 1) * Config.ZoneLength - 18)
					root.AssemblyLinearVelocity = Vector3.zero
				end
			end)
		end
	end)
end
for _, l in ipairs(CollectionService:GetTagged("Lava")) do
	hookLava(l)
end
CollectionService:GetInstanceAddedSignal("Lava"):Connect(hookLava)

-- ---------- ускорители ----------
local function hookBoost(pad)
	pad.Touched:Connect(function(hit)
		if char and hit:IsDescendantOf(char) and not state.bailing then
			if os.clock() > state.boostUntil - 1.5 then
				UI.floatText("УСКОРЕНИЕ!", Color3.fromRGB(0, 230, 255), 0.9)
				Sounds.play("Jump", 1.4, 0.4)
			end
			state.boostUntil = os.clock() + 2.5 * (board().ability == "boostMaster" and 2 or 1)
			local maxSpeed = player:GetAttribute("MaxSpeed") or Config.Speed.Base
			state.speed = math.max(state.speed, maxSpeed)
		end
	end)
end
for _, p in ipairs(CollectionService:GetTagged("Boost")) do
	hookBoost(p)
end
CollectionService:GetInstanceAddedSignal("Boost"):Connect(hookBoost)

-- ---------- витрина досок в лобби ----------
local beltStripes = {}
for i, st in ipairs(CollectionService:GetTagged("BeltStripe")) do
	st:SetAttribute("Phase", (i % 6) * 2.2)
	beltStripes[st] = st:GetAttribute("BeltZ") or st.Position.Z
end

local showDecks = {}
local function addShowDeck(d)
	showDecks[d] = d:IsA("Model") and d:GetPivot() or d.CFrame
end
for _, d in ipairs(CollectionService:GetTagged("ShowDeck")) do
	addShowDeck(d)
end
CollectionService:GetInstanceAddedSignal("ShowDeck"):Connect(addShowDeck)

local function refreshStands()
	local data = state.data
	if not data then
		return
	end
	for _, stand in ipairs(CollectionService:GetTagged("BoardStand")) do
		local id = stand:GetAttribute("BoardId")
		local b = Config.getBoard(id)
		local owned = (b.pass and data.passes[b.pass]) or data.boards[id]
		local status
		if data.equipped == id then
			status = "✅ НАДЕТА"
		elseif owned then
			status = "Нажми E — надеть"
		elseif b.pass then
			status = "👑 за робуксы"
		else
			status = Config.formatNumber(b.price) .. " 💰"
		end
		local info = stand:FindFirstChild("Info")
		local label = info and info:FindFirstChild("Text")
		if label then
			label.Text = string.format("%s\n⚡x%.2f  •  %s", b.name, b.speed, status)
		end
		local prompt = stand:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.ActionText = owned and "Надеть" or (b.pass and "Подробнее" or "Купить")
		end
	end
end

-- ---------- ворота зон ----------
local function zoneReady(idx)
	local data = state.data
	local z = Config.Zones[idx]
	return data and z and idx == data.maxZone + 1 and data.level >= z.level and data.coins >= z.cost
end

local function refreshGates()
	local maxZone = state.data and state.data.maxZone or 1
	for _, gate in ipairs(CollectionService:GetTagged("Gate")) do
		local idx = gate:GetAttribute("ZoneIndex") or 99
		local open = idx <= maxZone
		local ready = zoneReady(idx)
		gate.CanCollide = not open
		gate.Transparency = open and 1 or 0.2
		gate.Color = ready and Color3.fromRGB(80, 230, 120) or (Config.Zones[idx] and Config.Zones[idx].accent or gate.Color)
		for _, g in ipairs(gate:GetChildren()) do
			if g:IsA("SurfaceGui") then
				g.Enabled = not open
				local t = g:FindFirstChildOfClass("TextLabel")
				local z = Config.Zones[idx]
				if t and z then
					if ready then
						t.Text = string.format("✅ %s\nВсё готово! Въезжай в ворота — откроются за %s 💰", z.name, Config.formatNumber(z.cost))
					else
						t.Text = string.format("🔒 %s\nУровень %d  •  %s 💰  •  монеты x%s", z.name, z.level, Config.formatNumber(z.cost), tostring(z.mult))
					end
				end
			end
		end
	end
end

local function hookGate(gate)
	gate.Touched:Connect(function(hit)
		if not char or not hit:IsDescendantOf(char) then
			return
		end
		local idx = gate:GetAttribute("ZoneIndex")
		local maxZone = state.data and state.data.maxZone or 1
		if idx and idx > maxZone and os.clock() > state.gateCooldown then
			state.gateCooldown = os.clock() + 3
			if zoneReady(idx) then
				-- всё выполнено: открываем сразу
				task.spawn(function()
					if request("UnlockZone", idx) then
						Sounds.play("LevelUp", 1)
						UI.floatText("ВОРОТА ОТКРЫТЫ!", Color3.fromRGB(80, 230, 120), 1.3)
					end
				end)
			else
				UI.openZones()
			end
		end
	end)
end
for _, g in ipairs(CollectionService:GetTagged("Gate")) do
	hookGate(g)
end
CollectionService:GetInstanceAddedSignal("Gate"):Connect(function(g)
	hookGate(g)
	refreshGates()
end)

-- ---------- звёзды ----------
local stars = {}
local function addStar(s)
	stars[s] = { base = s.CFrame, phase = math.random() * TWO_PI, hiddenUntil = 0 }
end
for _, s in ipairs(CollectionService:GetTagged("Pickup")) do
	addStar(s)
end
CollectionService:GetInstanceAddedSignal("Pickup"):Connect(addStar)

remotes.PickupTaken.OnClientEvent:Connect(function(s, cooldown, coins)
	local info = stars[s]
	if info then
		info.hiddenUntil = os.clock() + cooldown
		s.Transparency = 1
		local light = s:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = false
		end
	end
	UI.floatText("+" .. Config.formatNumber(coins) .. " 💰", Color3.fromRGB(255, 220, 60))
	Sounds.play("Coin", 1.2, 0.4)
end)

-- ---------- зоны: свет и гравитация ----------
local function enterZone(i)
	state.zone = i
	local zone = Config.Zones[i]
	local l = zone.light
	TweenService:Create(Lighting, TweenInfo.new(1.5), {
		ClockTime = l.clock,
		Brightness = l.brightness,
		FogColor = l.fog,
		FogEnd = l.fogEnd,
		Ambient = l.ambient,
		OutdoorAmbient = l.ambient,
	}):Play()
	workspace.Gravity = zone.gravity
	local atm = Lighting:FindFirstChild("SkateAtmosphere")
	if atm then
		TweenService:Create(atm, TweenInfo.new(1.5), { Haze = l.haze or 1, Color = l.fog }):Play()
	end
	local cc = Lighting:FindFirstChild("SkateColor")
	if cc then
		TweenService:Create(cc, TweenInfo.new(1.5), { TintColor = l.tint or Color3.new(1, 1, 1) }):Play()
	end
	Sounds.setZoneMusic(i)
	UI.zoneBanner(i)
end

-- ---------- персонаж ----------
local function onCharacter(c)
	char = c
	hum = c:WaitForChild("Humanoid")
	root = c:WaitForChild("HumanoidRootPart")
	hum.UseJumpPower = true
	state.combo = {}
	state.trick = nil
	state.queued = nil
	state.bailing = false
	state.grinding = false
	state.inAir = false
	state.speed = 0
	UI.comboEnd(nil)
	-- выключаем стандартную анимацию бега: на доске её заменяет поза скейтера
	task.spawn(function()
		local animate = c:WaitForChild("Animate", 10)
		if animate and animate:IsA("LocalScript") then
			animate.Enabled = false
		end
	end)
	-- выключаем стандартный звук шагов: мы же на доске
	task.spawn(function()
		local running = root:WaitForChild("Running", 10)
		if running and running:IsA("Sound") then
			running.Volume = 0
			running:GetPropertyChangedSignal("Volume"):Connect(function()
				if running.Volume ~= 0 then
					running.Volume = 0
				end
			end)
		end
	end)
	-- встаёт на доску, как только она появилась
	c.ChildAdded:Connect(function(ch)
		if ch.Name == "Skateboard" then
			task.wait(0.05)
			playShot("mount")
		end
	end)
	if c:FindFirstChild("Skateboard") then
		playShot("mount")
	end
	-- олли при прыжке
	hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping and not state.bailing then
			state.ollieT = os.clock()
			if not state.trick then
				playShot("ollie")
			end
			Sounds.play("Jump", 1.1, 0.5)
		end
	end)
	hum.Died:Connect(function()
		if #state.combo > 0 then
			remotes.ComboBailed:FireServer(state.combo)
		end
		state.combo = {}
		UI.comboEnd(false)
	end)
end
if player.Character then
	task.spawn(onCharacter, player.Character)
end
player.CharacterAdded:Connect(onCharacter)

-- ---------- ввод ----------
-- двойной прыжок
UserInputService.JumpRequest:Connect(function()
	if not hum or not root or state.bailing or not state.inAir or state.usedDouble then
		return
	end
	if state.airTime < 0.2 or board().ability ~= "doubleJump" then
		return
	end
	state.usedDouble = true
	local vel = root.AssemblyLinearVelocity
	local jp = player:GetAttribute("JumpPower") or Config.BaseJump
	root.AssemblyLinearVelocity = Vector3.new(vel.X, jp * 0.9, vel.Z)
	state.ollieT = os.clock()
	playShot("ollie")
	UI.floatText("ДВОЙНОЙ ПРЫЖОК!", Color3.fromRGB(0, 255, 210), 0.8)
	Sounds.play("Jump", 1.4, 0.5)
end)

-- монеты с беговой дорожки
remotes:WaitForChild("AfkCoins").OnClientEvent:Connect(function(coins)
	UI.floatText("+" .. Config.formatNumber(coins) .. " 💰", Color3.fromRGB(255, 220, 60), 0.7)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	for _, b in ipairs(Config.TrickButtons) do
		if input.KeyCode == b.key then
			startTrick(b.trick)
			return
		end
	end
end)

-- ---------- главный цикл ----------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local camera = workspace.CurrentCamera
local zoneCheck = 0

RunService.Heartbeat:Connect(function(dt)
	local t = os.clock()

	-- звёзды покачиваются
	for s, info in pairs(stars) do
		if s.Parent then
			if info.hiddenUntil > 0 and t > info.hiddenUntil then
				info.hiddenUntil = 0
				s.Transparency = 0
				local light = s:FindFirstChildOfClass("PointLight")
				if light then
					light.Enabled = true
				end
			end
			s.CFrame = info.base + Vector3.new(0, math.sin(t * 2.5 + info.phase) * 0.7, 0)
		else
			stars[s] = nil
		end
	end

	for d, base in pairs(showDecks) do
		if d.Parent then
			local cf = CFrame.new(base.Position + Vector3.new(0, math.sin(t * 2) * 0.5, 0)) * CFrame.Angles(0, t * 1.2, 0) * base.Rotation
			if d:IsA("Model") then
				d:PivotTo(cf)
			else
				d.CFrame = cf
			end
		else
			showDecks[d] = nil
		end
	end
	-- лента беговых дорожек едет
	for stripe, z in pairs(beltStripes) do
		if stripe.Parent then
			local offset = ((t * 6 + stripe:GetAttribute("Phase")) % 13) - 6.5
			stripe.CFrame = CFrame.new(stripe.Position.X, stripe.Position.Y, z + offset)
		else
			beltStripes[stripe] = nil
		end
	end

	if not hum or not root or hum.Health <= 0 or not root.Parent then
		return
	end

	-- в каком мы состоянии
	local nowAir = hum.FloorMaterial == Enum.Material.Air
	if nowAir then
		if not state.inAir then
			state.inAir = true
			state.airTime = 0
			if state.queued and t - state.queued.time < 0.5 then
				local name = state.queued.name
				state.queued = nil
				startTrick(name)
			end
		end
		state.airTime += dt
	elseif state.inAir then
		state.inAir = false
		if not state.bailing then
			onLand()
		end
	end
	if state.queued and t - state.queued.time > 0.5 then
		state.queued = nil
	end

	if not state.bailing then
		updateTrick(dt)
	end

	local v = root.AssemblyLinearVelocity
	local flat = Vector3.new(v.X, 0, v.Z).Magnitude

	-- перила (стоя на месте грайнд не считается)
	local _, offset = boardBase()
	rayParams.FilterDescendantsInstances = { char }
	local hit = not state.bailing and workspace:Raycast(root.Position, Vector3.new(0, -(offset + 1.4), 0), rayParams)
	local onRail = hit and hit.Instance:GetAttribute("Rail") == true and flat > 8
	local sparks = boardPart("Sparks")
	if onRail then
		if not state.grinding then
			state.grinding = true
			state.grindTick = 0
			addEntryChecked("Rail")
			questEvent("rail")
		end
		state.grindTick += dt
		if state.grindTick >= 0.25 then
			state.grindTick -= 0.25
			addEntryChecked("Grind")
		end
		-- магнит: держим игрока по центру перил
		local railCF = hit.Instance.CFrame
		local lp = railCF:PointToObjectSpace(root.Position)
		local target = railCF:PointToWorldSpace(Vector3.new(lp.X * 0.75, lp.Y, lp.Z))
		root.CFrame = root.CFrame.Rotation + target
		state.groundTime = 0
	elseif state.grinding then
		state.grinding = false
	end
	if sparks then
		sparks.Enabled = state.grinding
	end

	-- засчитываем комбо, если долго едем по земле
	if #state.combo > 0 and not state.inAir and not state.grinding and not state.trick and not state.bailing then
		state.groundTime += dt
		UI.comboTimer(1 - state.groundTime / Config.Combo.BankDelay)
		if state.groundTime >= Config.Combo.BankDelay then
			bank()
		end
	elseif #state.combo > 0 then
		UI.comboTimer(1)
	end

	-- разгон как на скейте
	local maxSpeed = player:GetAttribute("MaxSpeed") or Config.Speed.Base
	local jump = player:GetAttribute("JumpPower") or Config.BaseJump
	if hum.JumpPower ~= jump then
		hum.JumpPower = jump
	end
	-- ограничение скорости из настроек (если слишком быстро)
	local limit = (state.data and state.data.settings and state.data.settings.speedLimit or 100) / 100
	maxSpeed *= limit
	local boosted = t < state.boostUntil
	local cap = maxSpeed * (state.grinding and 1.2 or 1) * (boosted and 1.45 or 1)
	local startSpeed = maxSpeed * Config.Speed.StartFraction
	if state.bailing then
		state.speed = startSpeed * 0.5
	elseif hum.MoveDirection.Magnitude > 0.1 then
		state.speed = math.max(state.speed, startSpeed)
		if state.speed < cap then
			state.speed = math.min(cap, state.speed + maxSpeed * Config.Speed.Accel * dt)
		else
			state.speed = math.max(cap, state.speed - maxSpeed * 0.8 * dt)
		end
	else
		state.speed = math.max(startSpeed, state.speed - maxSpeed * 1.2 * dt)
	end
	hum.WalkSpeed = state.speed

	-- наклон в поворотах (доска и тело)
	local yawRate = root.AssemblyAngularVelocity.Y
	local targetLean = state.inAir and 0 or math.clamp(yawRate * 0.06, -0.35, 0.35)
	state.lean += (targetLean - state.lean) * math.min(1, dt * 8)
	if not state.trick and not state.bailing then
		local weld = getWeld()
		if weld then
			-- олли: нос доски подпрыгивает вверх
			local pop = 0
			local since = t - state.ollieT
			if since < 0.3 then
				pop = math.sin(since / 0.3 * math.pi) * 0.45
			end
			weld.C0 = boardBase() * CFrame.Angles(pop, 0, -state.lean * 0.6)
		end
	end

	-- парение: держи прыжок в воздухе
	if state.inAir and board().ability == "glide" and hum.Jump and state.airTime > 0.25 then
		local vel = root.AssemblyLinearVelocity
		if vel.Y < -14 then
			root.AssemblyLinearVelocity = Vector3.new(vel.X, -14, vel.Z)
		end
	end

	-- поза скейтера для анимации
	local anim
	if state.bailing then
		anim = "bail"
	elseif state.trick then
		anim = state.trick.name
	elseif state.grinding then
		anim = "grind"
	elseif state.inAir then
		anim = "air"
	else
		anim = "ride"
	end
	Rider.setLocal(anim, state.lean)
	if anim ~= state.anim and not Rider.busy() then
		state.anim = anim
		remotes.AnimState:FireServer(anim)
	end
	Sounds.setRoll(flat, not state.inAir and not state.bailing)

	-- камера и след
	local targetFov = 70 + math.clamp((flat - 25) / 120, 0, 1) * 25 + (boosted and 8 or 0)
	camera.FieldOfView += (targetFov - camera.FieldOfView) * math.min(1, dt * 4)
	local trail = boardPart("BoardTrail")
	if trail then
		trail.Enabled = flat > 25 or state.inAir
	end
	UI.setSpeed(flat)

	-- зона
	zoneCheck -= dt
	if zoneCheck <= 0 then
		zoneCheck = 0.4
		local i = math.clamp(math.floor(-root.Position.Z / Config.ZoneLength) + 1, 1, #Config.Zones)
		if i ~= state.zone then
			enterZone(i)
		end
	end
end)

-- ---------- данные с сервера ----------
remotes.DataChanged.OnClientEvent:Connect(function(snap)
	local first = state.data == nil
	local prevLevel = state.data and state.data.level
	state.data = snap
	UI.setData(snap)
	refreshGates()
	refreshStands()
	task.defer(questFromData)
	if snap.settings then
		Sounds.setEnabled(snap.settings.sfx ~= false, snap.settings.music ~= false)
	end
	if prevLevel and snap.level > prevLevel then
		Sounds.play("LevelUp", 1.3)
	end
	if first and snap.level <= 1 and snap.coins == 0 then
		UI.tutorial()
	end
end)

remotes.ComboResult.OnClientEvent:Connect(function(coins, xp, record, mult)
	UI.comboResult(coins, xp, record, mult)
	if mult and mult >= 2 then
		questEvent("combo2")
	end
	if mult and mult >= 5 then
		questEvent("combo5")
	end
	Sounds.play("Coin", 1 + math.clamp((mult or 1) / 20, 0, 0.5))
end)

remotes.Notify.OnClientEvent:Connect(function(text, kind)
	UI.toast(text, kind)
end)

UI.init({
	Config = Config,
	request = request,
	buy = buy,
	onTrick = startTrick,
	sounds = Sounds,
	getData = function()
		return state.data
	end,
})
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- ============================================================
--  SKATE RUSH — интерфейс. Всё рисуется кодом, картинки не нужны.
-- ============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("SkateShared"):WaitForChild("Config"))
local fmt = Config.formatNumber

local UI = {}

local ctx -- колбэки из главного скрипта
local data -- последние данные с сервера
local gui
local refs = {}
local openWindowRefresh = nil
local displayedCoins = 0
local boostEnds = 0

-- ---------- цвета ----------
local C = {
	panel = Color3.fromRGB(18, 18, 32),
	panel2 = Color3.fromRGB(32, 32, 54),
	text = Color3.fromRGB(255, 255, 255),
	dim = Color3.fromRGB(170, 170, 200),
	gold = Color3.fromRGB(255, 205, 40),
	green = Color3.fromRGB(60, 220, 110),
	red = Color3.fromRGB(255, 70, 90),
	blue = Color3.fromRGB(40, 170, 255),
	pink = Color3.fromRGB(255, 60, 170),
	orange = Color3.fromRGB(255, 140, 0),
	purple = Color3.fromRGB(150, 90, 255),
}

-- ---------- helpers ----------
local function new(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	for _, ch in ipairs(children or {}) do
		ch.Parent = o
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end

local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 12) })
end

local function stroke(color, th)
	return new("UIStroke", { Color = color or Color3.new(0, 0, 0), Thickness = th or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function gradient(c1, c2, rot)
	return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 90 })
end

local function label(props)
	local maxText = props.MaxText or 40
	props.MaxText = nil
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or Enum.Font.GothamBlack
	props.TextColor3 = props.TextColor3 or C.text
	props.TextScaled = props.TextScaled ~= false
	local l = new("TextLabel", props)
	if props.TextScaled ~= false then
		new("UITextSizeConstraint", { MaxTextSize = maxText, Parent = l })
	end
	return l
end

-- плавно прячет текст вместе с обводкой
local function fadeAll(obj, dur)
	local info = TweenInfo.new(dur)
	local function fade(o)
		if o:IsA("TextLabel") or o:IsA("TextButton") then
			TweenService:Create(o, info, { TextTransparency = 1 }):Play()
		end
		if o:IsA("UIStroke") then
			TweenService:Create(o, info, { Transparency = 1 }):Play()
		end
		if o:IsA("Frame") then
			TweenService:Create(o, info, { BackgroundTransparency = 1 }):Play()
		end
	end
	fade(obj)
	for _, d in ipairs(obj:GetDescendants()) do
		fade(d)
	end
end

local function textStroke(l, th)
	new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = th or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Parent = l })
	return l
end

local function button(props, onClick)
	local color = props.Color or C.green
	local maxText = props.MaxText or 26
	props.Color = nil
	props.MaxText = nil
	props.BackgroundColor3 = color
	props.AutoButtonColor = true
	props.Font = props.Font or Enum.Font.GothamBlack
	props.TextColor3 = props.TextColor3 or C.text
	props.TextScaled = true
	local b = new("TextButton", props, { corner(10), gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)) })
	new("UITextSizeConstraint", { MaxTextSize = maxText, Parent = b })
	new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = b })
	textStroke(b, 1.5)
	b.MouseButton1Click:Connect(function()
		if ctx and ctx.sounds then
			ctx.sounds.play("Click", 1, 0.4)
		end
		local s = b:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = b })
		s.Scale = 0.9
		TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		onClick()
	end)
	return b
end

local function pop(obj, from)
	local s = obj:FindFirstChild("PopScale") or new("UIScale", { Name = "PopScale", Parent = obj })
	s.Scale = from or 1.35
	TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

local function timeText(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

-- ---------- уведомления ----------
function UI.toast(text, kind)
	if not refs.toasts then
		return
	end
	local color = ({ good = C.green, warn = C.red, level = C.gold, event = C.purple })[kind] or C.blue
	local f = new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.15,
		Parent = refs.toasts,
	}, { corner(10), stroke(color, 2) })
	local l = textStroke(label({ Text = text, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), TextColor3 = kind == "level" and C.gold or C.text, MaxText = 22, Parent = f }), 1)
	pop(f, 0.6)
	task.delay(3.2, function()
		fadeAll(f, 0.4)
		task.wait(0.45)
		f:Destroy()
	end)
	if kind == "level" then
		UI.floatText(text, C.gold, 1.6)
	end
end

function UI.floatText(text, color, size)
	if not gui then
		return
	end
	local l = textStroke(label({
		Text = text,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5 + (math.random() - 0.5) * 0.12, 0.55),
		Size = UDim2.fromScale(0.5 * (size or 1), 0.07 * (size or 1)),
		TextColor3 = color or C.gold,
		MaxText = 60,
		ZIndex = 20,
		Parent = gui,
	}), 1.6)
	pop(l, 0.3)
	TweenService:Create(l, TweenInfo.new(1.3, Enum.EasingStyle.Quad), { Position = l.Position - UDim2.fromScale(0, 0.12) }):Play()
	task.delay(0.5, function()
		fadeAll(l, 0.8)
	end)
	task.delay(1.35, function()
		l:Destroy()
	end)
end

-- ---------- комбо ----------
local function compress(entries)
	-- «Грайнд, Грайнд, Грайнд» → «Грайнд x3»; показываем последние 4 трюка
	local out = {}
	for _, name in ipairs(entries) do
		local display = Config.Tricks[name] and Config.Tricks[name].display or name
		local last = out[#out]
		if last and last.name == display then
			last.n += 1
		else
			table.insert(out, { name = display, n = 1 })
		end
	end
	local parts = {}
	for i = math.max(1, #out - 3), #out do
		local e = out[i]
		table.insert(parts, e.n > 1 and (e.name .. " x" .. e.n) or e.name)
	end
	return table.concat(parts, " + ")
end

function UI.comboUpdate(entries, base, mult, coins)
	local f = refs.combo
	if not f then
		return
	end
	f.Visible = true
	refs.comboTricks.Text = compress(entries)
	local multText = "x" .. (mult % 1 == 0 and tostring(mult) or string.format("%.1f", mult))
	if refs.comboMult.Text ~= multText then
		refs.comboMult.Text = multText
		pop(refs.comboMult, 1.6)
	end
	local hue = math.clamp((mult - 1) / 10, 0, 1)
	refs.comboMult.TextColor3 = C.gold:Lerp(C.pink, hue)
	refs.comboCoins.Text = "+" .. fmt(coins) .. " 💰"
	refs.comboBar.Size = UDim2.fromScale(1, 1)
end

function UI.comboTimer(p)
	if refs.comboBar then
		refs.comboBar.Size = UDim2.fromScale(math.clamp(p, 0, 1), 1)
	end
end

function UI.comboEnd(banked)
	if refs.combo then
		refs.combo.Visible = false
	end
end

local function comboWord(mult)
	if not gui or not mult then
		return
	end
	local word
	for _, w in ipairs(Config.ComboWords) do
		if mult >= w.mult then
			word = w.text
			break
		end
	end
	if not word then
		return
	end
	local burst = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.72, 0.42),
		Size = UDim2.fromOffset(250, 110),
		BackgroundColor3 = C.gold,
		Rotation = -8,
		ZIndex = 25,
		Parent = gui,
	}, { corner(26), stroke(Color3.new(0, 0, 0), 2.5), gradient(Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 150, 0)) })
	local multText = "x" .. (mult % 1 == 0 and tostring(mult) or string.format("%.1f", mult))
	textStroke(label({ Text = word, Size = UDim2.new(1, -16, 0.55, 0), Position = UDim2.new(0, 8, 0.06, 0), MaxText = 34, ZIndex = 26, Parent = burst }), 1.6)
	textStroke(label({ Text = multText, Size = UDim2.new(1, -16, 0.4, 0), Position = UDim2.new(0, 8, 0.56, 0), MaxText = 34, TextColor3 = C.pink, ZIndex = 26, Parent = burst }), 1.6)
	pop(burst, 0.2)
	task.delay(1.4, function()
		TweenService:Create(burst, TweenInfo.new(0.3), { Position = burst.Position - UDim2.fromScale(0, 0.06), BackgroundTransparency = 1 }):Play()
		for _, d in ipairs(burst:GetDescendants()) do
			if d:IsA("TextLabel") then
				TweenService:Create(d, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			elseif d:IsA("UIStroke") then
				TweenService:Create(d, TweenInfo.new(0.3), { Transparency = 1 }):Play()
			end
		end
		task.wait(0.35)
		burst:Destroy()
	end)
end

function UI.comboResult(coins, xp, record, mult)
	comboWord(mult)
	UI.floatText("+" .. fmt(coins) .. " 💰", C.gold, coins > 1000 and 1.4 or 1.1)
	if record then
		task.delay(0.4, function()
			UI.floatText("НОВЫЙ РЕКОРД КОМБО!", C.pink, 1.3)
		end)
	end
end

function UI.trickPop(text)
	UI.floatText(text, C.text, 0.8)
end

function UI.bail(lostCoins, reason)
	UI.floatText(reason or "ПАДЕНИЕ!", C.red, 1.2)
	local f = refs.bail
	if not f or lostCoins < Config.Combo.SaveOfferMin then
		return
	end
	refs.bailText.Text = "Комбо потеряно: " .. fmt(lostCoins) .. " 💰"
	f.Visible = true
	pop(f, 0.5)
	local token = {}
	refs.bailToken = token
	task.delay(6, function()
		if refs.bailToken == token then
			f.Visible = false
		end
	end)
end

function UI.landBurst(position)
	local p = new("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position),
		Parent = workspace,
	})
	local e = new("ParticleEmitter", {
		Color = ColorSequence.new(Color3.fromRGB(230, 230, 230)),
		Size = NumberSequence.new(1.2, 0),
		Transparency = NumberSequence.new(0.3, 1),
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(8, 14),
		SpreadAngle = Vector2.new(80, 10),
		Enabled = false,
		Parent = p,
	})
	e:Emit(18)
	task.delay(1, function()
		p:Destroy()
	end)
end

-- ---------- зоны ----------
function UI.zoneBanner(i)
	local zone = Config.Zones[i]
	if not gui or not zone then
		return
	end
	local l = textStroke(label({
		Text = zone.name:upper() .. "\nмонеты x" .. tostring(zone.mult),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromScale(0.6, 0.14),
		TextColor3 = zone.accent:Lerp(Color3.new(1, 1, 1), 0.35),
		MaxText = 70,
		ZIndex = 15,
		Parent = gui,
	}), 2)
	pop(l, 0.4)
	task.delay(2, function()
		fadeAll(l, 0.8)
		task.wait(0.85)
		l:Destroy()
	end)
end

-- ---------- окна ----------
local function closeWindow()
	if refs.window then
		refs.window.Visible = false
	end
	openWindowRefresh = nil
end

local function openWindow(title, color, build, manual)
	local w = refs.window
	refs.windowTitle.Text = title
	refs.windowHeader.BackgroundColor3 = color
	refs.windowManual = manual
	local function refresh()
		local list = refs.windowList
		local scroll = list.CanvasPosition
		task.defer(function()
			list.CanvasPosition = scroll
		end)
		for _, ch in ipairs(list:GetChildren()) do
			if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then
				ch:Destroy()
			end
		end
		if data then
			build(list)
		end
	end
	openWindowRefresh = refresh
	refs.windowList.CanvasPosition = Vector2.zero
	refresh()
	w.Visible = true
	pop(w, 0.7)
end

local rowOrder = 0
local function row(parent, opts)
	rowOrder += 1
	local f = new("Frame", {
		Size = UDim2.new(1, 0, 0, opts.height or 74),
		BackgroundColor3 = opts.highlight and C.panel2:Lerp(opts.highlight, 0.25) or C.panel2,
		LayoutOrder = rowOrder,
		Parent = parent,
	}, { corner(12) })
	if opts.highlight then
		stroke(opts.highlight, 2).Parent = f
	end
	label({ Text = opts.icon or "", Size = UDim2.new(0, 56, 1, -12), Position = UDim2.fromOffset(6, 6), MaxText = 38, Parent = f })
	textStroke(label({ Text = opts.title, Size = UDim2.new(1, -210, 0.45, 0), Position = UDim2.new(0, 66, 0.08, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22, Parent = f }), 1)
	label({ Text = opts.subtitle or "", Size = UDim2.new(1, -210, 0.38, 0), Position = UDim2.new(0, 66, 0.55, 0), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, TextColor3 = C.dim, MaxText = 16, Parent = f })
	if opts.buttonText then
		local b = button({
			Text = opts.buttonText,
			Size = UDim2.new(0, 132, 0, 46),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Color = opts.disabled and Color3.fromRGB(90, 90, 110) or (opts.buttonColor or C.green),
			MaxText = 20,
			Parent = f,
		}, function()
			if opts.onClick then
				opts.onClick()
			end
		end)
		b.AutoButtonColor = not opts.disabled
	end
	return f
end

local function header(parent, text)
	rowOrder += 1
	textStroke(label({ Text = text, Size = UDim2.new(1, 0, 0, 30), TextColor3 = C.gold, MaxText = 22, LayoutOrder = rowOrder, Parent = parent }), 1)
end

-- Доски
local function buildBoards(list)
	header(list, "Доски дают скорость и прыжок")
	for _, b in ipairs(Config.Boards) do
		local owned = (b.pass and data.passes[b.pass]) or data.boards[b.id]
		local equipped = data.equipped == b.id
		local btn, color, click
		if equipped then
			btn, color = "НАДЕТА", C.blue
		elseif owned then
			btn, color = "НАДЕТЬ", C.blue
			click = function()
				ctx.request("BuyBoard", b.id)
			end
		elseif b.pass then
			btn, color = Config.GamePasses[b.pass].price .. " R$", C.pink
			click = function()
				ctx.buy("pass", b.pass)
			end
		else
			btn, color = fmt(b.price) .. " 💰", data.coins >= b.price and C.green or Color3.fromRGB(90, 90, 110)
			click = function()
				ctx.request("BuyBoard", b.id)
			end
		end
		local sub = string.format("%s  •  ⚡x%.2f  ⤒+%d", b.desc or "", b.speed, b.jump)
		if b.coinBonus then
			sub ..= "  •  Монеты +" .. math.floor(b.coinBonus * 100) .. "%"
		end
		row(list, { icon = b.pass and "👑" or "🛹", title = b.name, subtitle = sub, buttonText = btn, buttonColor = color, onClick = click, highlight = equipped and b.trail or nil })
	end
end

-- Скорость
local function buildSpeed(list)
	local lvl = data.speedLevel
	local maxLvl = Config.Speed.MaxLevel
	local now = math.floor(Config.maxSpeed(lvl, data.equipped))
	header(list, "Скорость " .. now .. "  •  Ступень " .. lvl .. " из " .. maxLvl)
	if lvl >= maxLvl then
		row(list, { icon = "⚡", title = "Максимум!", subtitle = "Сделай перерождение, чтобы монет стало больше" })
		return
	end
	local cost = Config.speedCost(lvl)
	local nextSpeed = math.floor(Config.maxSpeed(lvl + 1, data.equipped))
	row(list, {
		icon = "⚡",
		title = "+1 к скорости",
		subtitle = now .. " → " .. nextSpeed,
		buttonText = fmt(cost) .. " 💰",
		buttonColor = data.coins >= cost and C.green or Color3.fromRGB(90, 90, 110),
		onClick = function()
			ctx.request("BuySpeed")
		end,
	})
	row(list, {
		icon = "⏩",
		title = "Купить на все монеты",
		subtitle = "Максимум, что можешь себе позволить",
		buttonText = "МАКС",
		buttonColor = C.orange,
		onClick = function()
			ctx.request("BuySpeedMax")
		end,
	})
end

-- Зоны
local function buildZones(list)
	header(list, "Открывай зоны: чем дальше, тем больше монет")
	row(list, { icon = "🏠", title = "Лобби", subtitle = "Магазин досок и старт", buttonText = "ПОЕХАЛИ", buttonColor = C.blue, onClick = function()
		if ctx.request("Teleport", 0) then
			closeWindow()
		end
	end })
	for i, z in ipairs(Config.Zones) do
		local opts = { icon = i <= data.maxZone and "🗺️" or "🔒", title = i .. ". " .. z.name, highlight = i == data.maxZone and z.accent or nil }
		if i <= data.maxZone then
			opts.subtitle = "Монеты x" .. tostring(z.mult) .. "  •  открыта"
			opts.buttonText = "ПОЕХАЛИ"
			opts.buttonColor = C.blue
			opts.onClick = function()
				if ctx.request("Teleport", i) then
					closeWindow()
				end
			end
		elseif i == data.maxZone + 1 then
			local canLevel = data.level >= z.level
			local canCoins = data.coins >= z.cost
			opts.subtitle = string.format("Нужен ур. %d %s  •  %s 💰 %s", z.level, canLevel and "✅" or "❌", fmt(z.cost), canCoins and "✅" or "❌")
			opts.buttonText = "ОТКРЫТЬ"
			opts.buttonColor = (canLevel and canCoins) and C.green or Color3.fromRGB(90, 90, 110)
			opts.onClick = function()
				ctx.request("UnlockZone", i)
			end
		else
			opts.subtitle = "Уровень " .. z.level .. "  •  монеты x" .. tostring(z.mult)
		end
		row(list, opts)
	end
	if data.maxZone < #Config.Zones then
		local p = Config.Products.SkipZone
		row(list, { icon = p.icon, title = p.name, subtitle = p.desc, buttonText = p.price .. " R$", buttonColor = C.pink, onClick = function()
			ctx.buy("product", "SkipZone")
		end, highlight = C.pink })
	end
end

-- Магазин
local function buildShop(list)
	header(list, "Навсегда")
	for _, key in ipairs(Config.GamePassOrder) do
		local p = Config.GamePasses[key]
		local owned = data.passes[key]
		row(list, {
			icon = p.icon,
			title = p.name,
			subtitle = p.desc,
			buttonText = owned and "ЕСТЬ ✅" or (p.price .. " R$"),
			buttonColor = owned and C.blue or C.pink,
			disabled = owned,
			highlight = (not owned) and C.gold or nil,
			onClick = function()
				if not owned then
					ctx.buy("pass", key)
				end
			end,
		})
	end
	header(list, "Бусты и монеты")
	for _, key in ipairs(Config.ProductOrder) do
		local p = Config.Products[key]
		local sub = p.desc
		if Config.CoinPackBase[key] then
			sub = "+" .. fmt(Config.CoinPackBase[key] * Config.Zones[data.maxZone].mult) .. " 💰 прямо сейчас"
		end
		row(list, { icon = p.icon, title = p.name, subtitle = sub, buttonText = p.price .. " R$", buttonColor = C.pink, onClick = function()
			ctx.buy("product", key)
		end })
	end
end

-- Ежедневная награда
local function buildDaily(list)
	header(list, "Заходи каждый день — награда растёт!")
	local mult = Config.Zones[data.maxZone].mult
	local nextDay = data.dailyReady and data.dailyNext or data.dailyStreak
	local streakShown = data.dailyReady and (nextDay - 1) or data.dailyStreak
	for day, amount in ipairs(Config.Daily) do
		local isNext = data.dailyReady and day == nextDay
		local done = day <= streakShown
		row(list, {
			height = 54,
			icon = day == #Config.Daily and "💎" or "🎁",
			title = "День " .. day,
			subtitle = "+" .. fmt(amount * mult) .. " 💰",
			buttonText = isNext and "ЗАБРАТЬ" or (done and "✅" or nil),
			buttonColor = isNext and C.green or C.blue,
			highlight = isNext and C.green or nil,
			onClick = function()
				if isNext then
					ctx.request("ClaimDaily")
				end
			end,
		})
	end
	if not data.dailyReady then
		header(list, "Следующая награда — завтра")
	end
end

-- Коды
local function buildCodes(list)
	header(list, "Коды ищи в соцсетях игры")
	rowOrder += 1
	local f = new("Frame", { Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = C.panel2, LayoutOrder = rowOrder, Parent = list }, { corner(12) })
	local box = new("TextBox", {
		Size = UDim2.new(1, -160, 0, 44),
		Position = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Color3.fromRGB(12, 12, 22),
		PlaceholderText = "Введи код...",
		Text = "",
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.text,
		PlaceholderColor3 = C.dim,
		TextScaled = true,
		Parent = f,
	}, { corner(8), new("UITextSizeConstraint", { MaxTextSize = 22 }) })
	button({ Text = "ВВЕСТИ", Size = UDim2.new(0, 130, 0, 44), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Color = C.green, Parent = f }, function()
		ctx.request("RedeemCode", box.Text)
	end)
end

-- Перерождение
local function buildRebirth(list)
	local cost = Config.rebirthCost(data.rebirths)
	local bonusNow = math.floor(Config.Rebirth.Bonus * data.rebirths * 100)
	local bonusNext = math.floor(Config.Rebirth.Bonus * (data.rebirths + 1) * 100)
	header(list, "Перерождений: " .. data.rebirths .. "  •  бонус к монетам +" .. bonusNow .. "%")
	row(list, { height = 90, icon = "♻️", title = "Сбросить монеты и скорость", subtitle = "Зоны, доски и уровень останутся.\nБонус станет +" .. bonusNext .. "% навсегда" })
	row(list, {
		icon = "🔥",
		title = "ПЕРЕРОДИТЬСЯ",
		subtitle = "Нужно " .. fmt(cost) .. " 💰",
		buttonText = fmt(cost) .. " 💰",
		buttonColor = data.coins >= cost and C.purple or Color3.fromRGB(90, 90, 110),
		onClick = function()
			ctx.request("Rebirth")
		end,
	})
end

-- Следы
local function buildTrails(list)
	header(list, "След тянется за доской. Только для красоты!")
	for _, t in ipairs(Config.Trails) do
		local owned = data.trails[t.id]
		local equipped = data.trail == t.id
		local btn, color, click
		if equipped then
			btn, color = "НАДЕТ", C.blue
		elseif owned then
			btn, color = "НАДЕТЬ", C.blue
			click = function()
				ctx.request("BuyTrail", t.id)
			end
		elseif t.starter then
			btn, color = "В НАБОРЕ", C.pink
			click = function()
				if data.starterLeft and data.starterLeft > 0 then
					ctx.buy("product", "StarterPack")
				else
					UI.toast("Этот след был в стартовом наборе", "warn")
				end
			end
		else
			btn, color = fmt(t.price) .. " 💰", data.coins >= t.price and C.green or Color3.fromRGB(90, 90, 110)
			click = function()
				ctx.request("BuyTrail", t.id)
			end
		end
		local f = row(list, { icon = "✨", title = t.name, subtitle = t.colors and "" or "Цвет как у доски", buttonText = btn, buttonColor = color, onClick = click, highlight = equipped and C.blue or nil })
		if t.colors then
			local keys = {}
			for k, c in ipairs(t.colors) do
				table.insert(keys, ColorSequenceKeypoint.new((k - 1) / math.max(1, #t.colors - 1), c))
			end
			local strip = new("Frame", { Size = UDim2.new(1, -230, 0, 12), Position = UDim2.new(0, 66, 0.62, 0), BackgroundColor3 = Color3.new(1, 1, 1), Parent = f }, { corner(6) })
			new("UIGradient", { Color = ColorSequence.new(keys), Parent = strip })
		end
	end
end

-- Подарки за время
local function giftReadyCount()
	if not data then
		return 0
	end
	local played = data.played + (os.clock() - (refs.dataTime or os.clock()))
	local n = 0
	for i, g in ipairs(Config.Gifts) do
		if not data.gifts[i] and played >= g.minutes * 60 then
			n += 1
		end
	end
	return n
end

local function buildGifts(list)
	header(list, "Играй дольше — получай подарки!")
	local mult = Config.Zones[data.maxZone].mult
	local played = data.played + (os.clock() - (refs.dataTime or os.clock()))
	for i, g in ipairs(Config.Gifts) do
		local claimed = data.gifts[i]
		local left = g.minutes * 60 - played
		local opts = { height = 56, icon = claimed and "✅" or "🎁", title = "+" .. fmt(g.coins * mult) .. " 💰", subtitle = "через " .. g.minutes .. " мин. игры" }
		if claimed then
			opts.buttonText, opts.buttonColor = "ЗАБРАН", Color3.fromRGB(90, 90, 110)
		elseif left <= 0 then
			opts.buttonText, opts.buttonColor, opts.highlight = "ЗАБРАТЬ", C.green, C.green
			opts.onClick = function()
				ctx.request("ClaimGift", i)
			end
		else
			opts.buttonText, opts.buttonColor = timeText(left), Color3.fromRGB(90, 90, 110)
		end
		row(list, opts)
	end
end

-- Настройки
local function buildSettings(list)
	local st = data.settings or { music = true, sfx = true, speedLimit = 100 }
	local function save(changes)
		local copy = { music = st.music, sfx = st.sfx, speedLimit = st.speedLimit }
		for k, v in pairs(changes) do
			copy[k] = v
		end
		ctx.request("SaveSettings", copy)
	end
	header(list, "Настройки")
	row(list, { icon = "🎵", title = "Музыка", subtitle = st.music and "Включена" or "Выключена", buttonText = st.music and "ВКЛ" or "ВЫКЛ", buttonColor = st.music and C.green or C.red, onClick = function()
		save({ music = not st.music })
	end })
	row(list, { icon = "🔊", title = "Звуки", subtitle = st.sfx and "Включены" or "Выключены", buttonText = st.sfx and "ВКЛ" or "ВЫКЛ", buttonColor = st.sfx and C.green or C.red, onClick = function()
		save({ sfx = not st.sfx })
	end })
	header(list, "Ограничение скорости: " .. st.speedLimit .. "%")
	row(list, { icon = "🐢", title = "Медленнее", subtitle = "Если слишком быстро и трудно управлять", buttonText = "−10%", buttonColor = C.blue, onClick = function()
		save({ speedLimit = math.max(30, st.speedLimit - 10) })
	end })
	row(list, { icon = "🐇", title = "Быстрее", subtitle = "Максимум — 100%", buttonText = "+10%", buttonColor = C.blue, onClick = function()
		save({ speedLimit = math.min(100, st.speedLimit + 10) })
	end })
end

local windows = {
	Boards = { "🛹 ДОСКИ", C.orange, buildBoards },
	Speed = { "⚡ СКОРОСТЬ", C.blue, buildSpeed },
	Zones = { "🗺️ ЗОНЫ", C.green, buildZones },
	Shop = { "💎 МАГАЗИН", C.pink, buildShop },
	Daily = { "🎁 НАГРАДА", C.gold, buildDaily },
	Codes = { "🎟️ КОДЫ", C.purple, buildCodes, true },
	Rebirth = { "♻️ ПЕРЕРОЖДЕНИЕ", C.purple, buildRebirth },
	Trails = { "✨ СЛЕДЫ", C.blue, buildTrails },
	Gifts = { "🎁 ПОДАРКИ", C.green, buildGifts },
	Settings = { "⚙️ НАСТРОЙКИ", Color3.fromRGB(120, 120, 150), buildSettings },
}

local function open(name)
	local w = windows[name]
	if refs.window.Visible and refs.windowTitle.Text == w[1] then
		closeWindow()
		return
	end
	openWindow(w[1], w[2], w[3], w[4])
end

function UI.openZones()
	if data then
		open("Zones")
	end
end

-- ---------- данные ----------
function UI.setData(snap)
	data = snap
	refs.dataTime = os.clock()
	boostEnds = os.clock() + (snap.boostLeft or 0)
	if refs.level then
		local need = Config.xpForLevel(snap.level)
		refs.level.Text = "УР. " .. snap.level
		TweenService:Create(refs.xpFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(snap.xp / need, 0, 1), 1) }):Play()
		refs.xpText.Text = fmt(snap.xp) .. " / " .. fmt(need)
		refs.mult.Text = string.format("монеты x%s", (snap.coinMult % 1 == 0) and tostring(snap.coinMult) or string.format("%.1f", snap.coinMult))
		refs.dailyDot.Visible = snap.dailyReady
	end
	updateQuest()
	if refs.saveWarn then
		refs.saveWarn.Visible = snap.saving == false
	end
	if openWindowRefresh and not refs.windowManual then
		openWindowRefresh()
	end
end

local function updateQuest()
	if not refs.quest or not data then
		return
	end
	local q = Config.Quests[data.quest or 1]
	refs.quest.Visible = q ~= nil
	if q then
		local text = "🎯 " .. q.text .. "   •   +" .. fmt(q.reward) .. " 💰"
		if refs.questText.Text ~= text then
			refs.questText.Text = text
			pop(refs.quest, 1.15)
		end
	end
end

function UI.setSpeed(v)
	if refs.speed then
		refs.speed.Text = tostring(math.floor(v))
	end
end

-- ---------- обучение ----------
function UI.tutorial()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local tips = {
		"Разгоняйся и заезжай на трамплины со стрелками!",
		touch and "В воздухе жми кнопки ФЛИП, СПИН, ГРЭБ, БЭК" or "В воздухе жми E, Q, R, F — это трюки",
		"Не успел докрутить трюк до приземления — упадёшь!",
		"Трюки подряд = множитель комбо. Разные трюки дают больше",
		"Заезжай на перила — это грайнд, он не даёт комбо закончиться",
		"Прокачивай скорость, покупай доски и открывай новые зоны!",
	}
	task.spawn(function()
		task.wait(2)
		for _, t in ipairs(tips) do
			UI.toast("💡 " .. t, "info")
			task.wait(4)
		end
	end)
end

-- ---------- построение интерфейса ----------
local function buildHud()
	local screen = new("ScreenGui", { Name = "SkateRushUI", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
	-- весь интерфейс рисуем в «виртуальных» пикселях и масштабируем под экран телефона/компьютера
	gui = new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = screen })
	local scale = new("UIScale", { Parent = gui })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		local s = math.clamp(math.min(vp.X / 1280, vp.Y / 680), 0.5, 1.15)
		scale.Scale = s
		gui.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	-- монеты и уровень
	local stats = new("Frame", { Size = UDim2.fromOffset(300, 118), Position = UDim2.fromOffset(16, 12), BackgroundColor3 = C.panel, BackgroundTransparency = 0.2, Parent = gui }, { corner(16), stroke(C.gold, 2) })
	refs.coins = textStroke(label({ Text = "💰 0", Size = UDim2.new(1, -20, 0, 44), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.gold, MaxText = 38, Parent = stats }), 2)
	refs.level = textStroke(label({ Text = "УР. 1", Size = UDim2.new(0, 90, 0, 24), Position = UDim2.fromOffset(12, 54), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = stats }), 1)
	local xpBg = new("Frame", { Size = UDim2.new(1, -116, 0, 20), Position = UDim2.fromOffset(104, 56), BackgroundColor3 = Color3.fromRGB(10, 10, 20), Parent = stats }, { corner(10) })
	refs.xpFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.blue, Parent = xpBg }, { corner(10), gradient(C.blue, C.purple, 0) })
	refs.xpText = label({ Text = "", Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBold, MaxText = 14, ZIndex = 2, Parent = xpBg })
	refs.mult = textStroke(label({ Text = "монеты x1", Size = UDim2.new(0.55, 0, 0, 24), Position = UDim2.fromOffset(12, 86), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.green, MaxText = 18, Parent = stats }), 1)
	refs.boost = textStroke(label({ Text = "", Size = UDim2.new(0.45, -12, 0, 24), Position = UDim2.new(0.55, 0, 0, 86), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = C.orange, MaxText = 18, Parent = stats }), 1)

	-- кнопки меню слева
	local menu = new("Frame", { Size = UDim2.fromOffset(160, 400), Position = UDim2.new(0, 16, 0, 144), BackgroundTransparency = 1, Parent = gui }, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(74, 68), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local items = {
		{ "Boards", "🛹", "Доски", C.orange },
		{ "Speed", "⚡", "Скорость", C.blue },
		{ "Zones", "🗺️", "Зоны", C.green },
		{ "Shop", "💎", "Магазин", C.pink },
		{ "Daily", "📅", "Награда", C.gold },
		{ "Gifts", "🎁", "Подарки", C.green },
		{ "Trails", "✨", "Следы", C.blue },
		{ "Codes", "🎟️", "Коды", C.purple },
		{ "Rebirth", "♻️", "Перерожд.", C.purple },
		{ "Settings", "⚙️", "Настройки", Color3.fromRGB(120, 120, 150) },
	}
	for i, it in ipairs(items) do
